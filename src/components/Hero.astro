---
import { SITE_META } from '../data/siteMeta';
---

<section class="py-8 sm:py-12 border-b border-[var(--border)]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- Left Column: Narrative & Headline -->
    <div class="lg:col-span-8 xl:col-span-8 space-y-5 sm:space-y-6">
      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-serif leading-[1.18] tracking-tight text-[var(--text)]">
        Veritabanı sistemleri, depolama ve veri altyapıları üzerine çalışıyorum.
      </h1>

      <!-- 2-Paragraph Narrative / Mission Statement -->
      <div class="space-y-3.5 max-w-[65ch] text-[var(--text-muted)] font-sans text-base sm:text-[17px] leading-relaxed">
        <p>
          İlişkisel ve zaman serisi veritabanları, depolama motorları ve sorgu optimizasyonu üzerine çalışıyorum.
        </p>
        <p class="text-sm sm:text-base text-[var(--text)] bg-[var(--bg-subtle)]/70 p-3.5 border border-[var(--border)] rounded-[2px] leading-relaxed">
          Bu site; sahada karşılaştığım problemleri, edindiğim tecrübeleri ve veritabanı altyapıları üzerine öğrendiklerimi adım adım paylaştığım kişisel bir teknik rehber (tutorial) niteliğindedir.
        </p>
      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="#articles"
          class="px-4 py-2 bg-[var(--text)] text-[var(--bg)] hover:bg-[var(--accent)] hover:text-white transition-colors text-xs font-mono font-medium inline-flex items-center gap-2 tactile-btn rounded-[2px]"
        >
          <span>Yazıları Oku</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#systems"
          class="px-4 py-2 border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text)] hover:border-[var(--text)] transition-colors text-xs font-mono font-medium inline-flex items-center gap-1.5 rounded-[2px] tactile-btn"
        >
          <span>Sistem Mimarileri</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↓</span>
        </a>

        <a
          href={`mailto:${SITE_META.email}`}
          class="px-4 py-2 border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors text-xs font-mono font-medium inline-flex items-center gap-1.5 rounded-[2px] tactile-btn"
        >
          <span>İletişime Geç</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right 4 Columns: Architectural Portrait Card to clearly present the engineer -->
    <div class="lg:col-span-4 xl:col-span-4 flex flex-col items-center lg:items-end pt-4 lg:pt-0">
      <div class="w-52 sm:w-60 space-y-3">
        <div class="aspect-[4/5] overflow-hidden bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] relative group shadow-sm">
          <picture>
            <source srcset="/profile.webp" type="image/webp" />
            <img
              src="/profile.png"
              alt="Ahmet İhtiyar — Portre"
              width="240"
              height="300"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover object-center transition-all duration-300 filter contrast-[1.02] group-hover:contrast-105"
            />
          </picture>
        </div>

        <div class="flex items-center justify-between text-xs font-mono text-[var(--text-dim)] px-0.5 border-t border-[var(--border)] pt-2">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)]" aria-hidden="true"></span>
            <span>İstanbul, TR</span>
          </span>
          <span class="text-[var(--text-muted)] font-medium">Veritabanı & Depolama</span>
        </div>
      </div>
    </div>
  </div>
</section>
