      if (uiCardRoleNode2) {
        uiCardRoleNode2.textContent = data.uiNode2.role;
        uiCardRoleNode2.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium ' + data.uiNode2.roleClass;
      }
      if (uiCardHealthNode2) uiCardHealthNode2.textContent = data.uiNode2.health;
      if (uiCardTlNode2) uiCardTlNode2.textContent = data.node2.tl;
      if (uiCardLagNode2) uiCardLagNode2.textContent = data.uiNode2.lag;

      if (uiCardRoleNode3) {
        uiCardRoleNode3.textContent = data.uiNode3.role;
        uiCardRoleNode3.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium ' + data.uiNode3.roleClass;
      }
      if (uiCardHealthNode3) uiCardHealthNode3.textContent = data.uiNode3.health;
      if (uiCardTlNode3) uiCardTlNode3.textContent = data.node3.tl;
      if (uiCardLagNode3) uiCardLagNode3.textContent = data.uiNode3.lag;

      // Update Code Panes
      if (codeCli) codeCli.textContent = data.cli;
      if (codeDcs) codeDcs.textContent = data.dcs;
      if (codeHaproxy) codeHaproxy.textContent = data.haproxy;
    }

    function switchInspectorTab(target) {
      activeInspectorTab = target;
      tabBtns.forEach(btn => {
        if (btn.getAttribute('data-target') === target) {
          btn.classList.remove('text-[var(--text-muted)]', 'bg-[var(--accent-subtle)]');
          btn.classList.add('bg-[var(--text)]', 'text-[var(--bg)]');
        } else {
          btn.classList.remove('bg-[var(--text)]', 'text-[var(--bg)]');
          if (btn.getAttribute('data-target') === 'ui') {
            btn.classList.add('text-[var(--accent)]', 'bg-[var(--accent-subtle)]');
          } else {
            btn.classList.add('text-[var(--text-muted)]');
          }
        }
      });

      if (panelCli) panelCli.classList.toggle('hidden', target !== 'cli');
      if (panelDcs) panelDcs.classList.toggle('hidden', target !== 'dcs');
      if (panelHaproxy) panelHaproxy.classList.toggle('hidden', target !== 'haproxy');
      if (panelUi) panelUi.classList.toggle('hidden', target !== 'ui');
    }

    scenarioBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const scenario = btn.getAttribute('data-scenario');
        if (scenario) updateScenario(scenario);
      });
    });

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        if (target) switchInspectorTab(target);
      });
    });

    if (actionSwitchoverBtn) {
      actionSwitchoverBtn.addEventListener('click', () => {
        updateScenario('switchover');
      });
    }

    if (actionPauseBtn) {
      let isPaused = false;
      actionPauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        actionPauseBtn.textContent = isPaused ? '▶ Bakımdan Çık (Resume)' : '⏸ Bakım Modu';
        if (uiQuorumBadge) {
          uiQuorumBadge.textContent = isPaused ? 'PAUSED (Bakım Modu)' : patroniScenarios[activeScenarioKey].quorum;
          uiQuorumBadge.className = isPaused
            ? 'text-[10px] font-mono px-1.5 py-0.5 bg-yellow-500/20 text-yellow-600 dark:text-yellow-400 rounded-[2px] font-medium'
            : 'text-[10px] font-mono px-1.5 py-0.5 bg-[var(--status-green)]/15 text-[var(--status-green)] rounded-[2px] font-medium';
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const currentData = patroniScenarios[activeScenarioKey];
        let textToCopy = '';
        if (activeInspectorTab === 'cli' || activeInspectorTab === 'ui') textToCopy = currentData.cli;
        else if (activeInspectorTab === 'dcs') textToCopy = currentData.dcs;
        else if (activeInspectorTab === 'haproxy') textToCopy = currentData.haproxy;

        navigator.clipboard.writeText(textToCopy).then(() => {
          if (copyText) copyText.textContent = 'Kopyalandı!';
          setTimeout(() => {
            if (copyText) copyText.textContent = 'Kopyala';
          }, 2000);
        });
      });
    }
  })();
</script>
