---
import { SITE_META } from '../data/siteMeta';
---

<section id="contact" class="py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-2 mb-10 max-w-2xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      İletişim
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Veritabanı sistemleri, depolama altyapıları veya teknik konular için doğrudan ulaşabilirsiniz.
    </p>
  </div>

  <!-- Direct Channels Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-2">
    <!-- Email Channel -->
    <div class="space-y-3 pb-6 md:pb-0 border-b md:border-b-0 md:border-r border-[var(--border)] md:pr-8">
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-dim)]">
        <span class="uppercase tracking-wider font-semibold text-[var(--text-accent)]">E-posta</span>
        <button
          type="button"
          id="copy-contact-email-btn"
          class="px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer text-[11px] tactile-btn inline-flex items-center gap-1"
          aria-label="E-postayı kopyala"
        >
          <svg class="w-3 h-3 text-[var(--text-dim)] shrink-0 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-email-label">Kopyala</span>
        </button>
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)] truncate" title={SITE_META.email}>
        {SITE_META.email}
      </div>

      <div>
        <a
          href={`mailto:${SITE_META.email}`}
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>E-posta Gönder</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- GitHub Channel -->
    <div class="space-y-3 pb-6 md:pb-0 border-b md:border-b-0 md:border-r border-[var(--border)] md:pr-8">
      <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        GitHub
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)]">
        github.com/ihtiyar07
      </div>

      <div>
        <a
          href={SITE_META.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>Açık Kaynak Kodlar</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- LinkedIn Channel -->
    <div class="space-y-3">
      <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        LinkedIn
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)]">
        in/ahmet-ihtiyar
      </div>

      <div>
        <a
          href={SITE_META.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>Bağlantı Kur</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Availability Note -->
  <div class="mt-10 pt-6 border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-mono text-[var(--text-dim)]">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)] shrink-0"></span>
      <span class="text-[var(--text)] font-medium">
        Çalışma Alanları:
      </span>
      <span>
        İlişkisel veritabanları, depolama motorları ve sorgu optimizasyonu
      </span>
    </div>
  </div>
</section>

<!-- Email Copy Script -->
<script is:inline>
  (function() {
    const copyBtn = document.getElementById('copy-contact-email-btn');
    if (!copyBtn) return;
    copyBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const email = 'ahmetihtiyar1453@gmail.com';
      const label = copyBtn.querySelector('.copy-email-label');
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = '✓ Kopyalandı';
        if (typeof window.showToast === 'function') {
          window.showToast('✓ E-posta panoya kopyalandı');
        }
        setTimeout(() => {
          if (label) label.textContent = 'Kopyala';
        }, 2000);
      } catch (_) {
        prompt('E-posta:', email);
      }
    });
  })();
</script>
