---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const headline = SITE_META.headline[lang];
const nowLine = SITE_META.nowLine[lang];
---

<section class="py-10 sm:py-16 border-b border-[var(--border)]">
  <div class="flex flex-col-reverse md:flex-row items-start justify-between gap-8 md:gap-12">
    <!-- Text Column -->
    <div class="flex-1 max-w-2xl">
      <!-- Monospace Section Tag -->
      <div class="flex items-center gap-2 mb-4">
        <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
          00 — {isTr ? 'Giriş & Konumlandırma' : 'Positioning'}
        </span>
        <span class="h-px w-8 bg-[var(--border)]"></span>
      </div>

      <!-- H1 Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-serif leading-[1.18] tracking-tight text-[var(--text)] mb-5">
        {headline}
      </h1>

      <!-- "Now" Line -->
      <div class="font-mono text-xs sm:text-[13px] text-[var(--text-muted)] bg-[var(--bg-subtle)] border-l-2 border-[#E8590C] px-3.5 py-2.5 mb-6 leading-relaxed rounded-r-[2px]">
        <div class="flex items-start gap-2">
          <span class="text-[#E8590C] select-none font-bold" aria-hidden="true">▸</span>
          <span>{nowLine}</span>
        </div>
      </div>

      <!-- Bio / Context -->
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed mb-8 prose-editorial font-sans">
        {isTr ? (
          <>
            Ahmet İhtiyar. Bilgisayar Mühendisiyim. Diverjans Bilgi Teknolojileri'nde tam zamanlı olarak donanım seviyesinden (ESP32, Modbus) dağıtık mikroservislere, zaman serisi depolamadan (TimescaleDB) sıfır kopyalama veri aktarımına (Apache Arrow) ve resmi e-imzalı raporlamaya kadar uzanan uçtan uca veri hatlarını kuruyorum.
          </>
        ) : (
          <>
            Ahmet İhtiyar. Systems and Backend Engineer based in Istanbul. Working full-time at Diverjans Information Technologies, building end-to-end telemetry pipelines from edge microcontrollers (ESP32, Modbus) and message brokers up to time-series storage (TimescaleDB), Apache Arrow zero-copy pipelines, and legally binding audit reports.
          </>
        )}
      </p>

      <!-- 3 Actions: Primary, Mail, Quick Copy -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 font-mono text-xs">
        <a
          href="#cases"
          class="px-4 py-2.5 bg-[#E8590C] text-white hover:bg-[#CF4E08] transition-all rounded-[2px] font-medium inline-flex items-center gap-2 group tactile-btn"
        >
          <span>{isTr ? 'Vaka Çalışmalarını Oku' : 'Read Case Studies'}</span>
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↓</span>
        </a>

        <div class="flex items-center gap-1.5">
          <a
            href={`mailto:${SITE_META.email}`}
            class="px-4 py-2.5 border border-[var(--border-strong)] text-[var(--text)] hover:border-[#E8590C] hover:text-[#E8590C] transition-all rounded-[2px] inline-flex items-center gap-2 tactile-btn"
          >
            <span>{isTr ? 'E-posta Gönder' : 'Send Email'}</span>
            <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
          </a>

          <button
            type="button"
            id="hero-copy-email-btn"
            class="px-2.5 py-2.5 border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[#E8590C] hover:border-[#E8590C] transition-all rounded-[2px] inline-flex items-center gap-1.5 cursor-pointer tactile-btn shadow-xs"
            title={isTr ? "E-posta adresini panoya kopyala" : "Copy email address to clipboard"}
            aria-label={isTr ? "E-posta adresini panoya kopyala" : "Copy email address to clipboard"}
            data-email={SITE_META.email}
          >
            <svg class="w-3.5 h-3.5 text-[var(--text-dim)] shrink-0 hero-copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="text-[11px] font-mono hidden sm:inline hero-copy-label">{isTr ? 'Kopyala' : 'Copy'}</span>
          </button>
        </div>
      </div>

      <!-- Telemetry Hardware Strip -->
      <div class="mt-8 pt-4 border-t border-[var(--border)] flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-[11px] text-[var(--text-dim)]">
        <span class="inline-flex items-center gap-1.5 text-[var(--text-muted)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]" aria-hidden="true"></span>
          <span>{isTr ? 'AKTİF HAT:' : 'ACTIVE PATH:'}</span>
        </span>
        <span class="text-[var(--text)] font-medium">ESP32</span>
        <span class="text-[var(--border-strong)]">▸</span>
        <span class="text-[var(--text)] font-medium">Modbus RTU</span>
        <span class="text-[var(--border-strong)]">▸</span>
        <span class="text-[var(--text)] font-medium">RabbitMQ</span>
        <span class="text-[var(--border-strong)]">▸</span>
        <span class="text-[var(--text)] font-medium">TimescaleDB</span>
        <span class="text-[var(--border-strong)]">▸</span>
        <span class="text-[var(--text)] font-medium">Arrow IPC</span>
      </div>
    </div>

    <!-- Real Portrait Photo with Engineering Card Accents -->
    <div class="flex-shrink-0 self-start md:self-auto">
      <div class="relative group tech-corner-marks">
        <div class="w-32 sm:w-40 h-40 sm:h-48 overflow-hidden rounded-[3px] border border-[var(--border-strong)] bg-[var(--bg-subtle)] p-1 shadow-sm">
          <picture>
            <source srcset="/profile.webp" type="image/webp" />
            <img
              src="/profile.png"
              alt="Ahmet İhtiyar — Portre"
              width="160"
              height="192"
              loading="eager"
              class="w-full h-full object-cover object-center rounded-[2px] transition-all duration-300 filter contrast-[1.02] saturate-[0.92] group-hover:saturate-100"
            />
          </picture>
        </div>
        <div class="flex items-center justify-between font-mono text-[9px] text-[var(--text-dim)] mt-2 px-0.5">
          <span class="uppercase tracking-wider">41.0082° N, 28.9784° E</span>
          <span class="text-[#E8590C] font-semibold">● ONLINE</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const copyBtn = document.getElementById('hero-copy-email-btn');
    if (!copyBtn) return;
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'ahmetihtiyar1453@gmail.com';
      const label = copyBtn.querySelector('.hero-copy-label');
      const isTr = document.documentElement.lang === 'tr';
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = isTr ? '✓ Kopyalandı!' : '✓ Copied!';
        copyBtn.classList.add('border-[#10B981]');
        if (typeof window.showToast === 'function') {
          window.showToast(isTr ? `✓ E-posta kopyalandı: ${email}` : `✓ Email copied: ${email}`);
        }
        setTimeout(() => {
          if (label) label.textContent = isTr ? 'Kopyala' : 'Copy';
          copyBtn.classList.remove('border-[#10B981]');
        }, 2000);
      } catch (_) {
        prompt('E-posta:', email);
      }
    });
  })();
</script>
