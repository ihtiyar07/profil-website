---
import { getCollection } from 'astro:content';
import { SITE_META } from '../data/siteMeta';
import { getPostSlug } from '../data/slugUtils';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const navItems = [
  { id: 'articles', href: '/#articles', label: 'Yazılar & Notlar', icon: 'M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
  { id: 'systems', href: '/#systems', label: 'Sistemler & Çalışmalar', icon: 'M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7zm0 5h16M9 4v16' },
  { id: 'invariants', href: '/#invariants', label: 'Mimari İlkeler', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { id: 'secondary-projects', href: '/#secondary-projects', label: 'Diğer Sistemler', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { id: 'contact', href: '/#contact', label: 'İletişim & Kanallar', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' }
];

const topics = [
  { name: 'PostgreSQL', tag: 'PostgreSQL' },
  { name: 'TimescaleDB', tag: 'TimescaleDB' },
  { name: 'Oracle', tag: 'Oracle' },
  { name: 'Apache Arrow', tag: 'Apache Arrow' },
  { name: 'ZFS', tag: 'ZFS' },
  { name: 'Redis', tag: 'Redis' }
];
---

<!-- Desktop Persistent Sidebar (Sticky, h-screen) -->
<aside class="hidden lg:flex flex-col w-72 xl:w-80 shrink-0 h-screen sticky top-0 border-r border-[var(--border)] bg-[var(--bg)] overflow-y-auto z-30 transition-colors select-none">
  <div class="p-6 flex flex-col justify-between min-h-full space-y-6">
    <!-- Top Block: Brand, Identity & Mission -->
    <div class="space-y-5">
      <!-- Profile Card -->
      <a href="/" class="group flex items-start gap-3.5 focus:outline-none" aria-label="Ahmet İhtiyar Ana Sayfa">
        <div class="w-12 h-12 rounded-[3px] overflow-hidden border border-[var(--border)] bg-[var(--bg-subtle)] shrink-0 group-hover:border-[var(--accent)] transition-colors">
          <picture>
            <source srcset="/profile.webp" type="image/webp" />
            <img
              src="/profile.png"
              alt="Ahmet İhtiyar"
              width="48"
              height="48"
              class="w-full h-full object-cover filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300"
            />
          </picture>
        </div>

        <div class="space-y-0.5 min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)] shrink-0" aria-hidden="true"></span>
            <span class="font-sans font-semibold text-sm text-[var(--text)] group-hover:text-[var(--accent)] transition-colors truncate">
              {SITE_META.author}
            </span>
          </div>
          <div class="text-xs font-mono text-[var(--text-muted)] truncate">
            Veritabanı & Depolama
          </div>
          <div class="text-[11px] font-mono text-[var(--text-dim)] truncate">
            İstanbul, Türkiye
          </div>
        </div>
      </a>

      <!-- Purpose / Mission Statement Note -->
      <div class="p-3 bg-[var(--bg-subtle)]/60 border border-[var(--border)] rounded-[2px] text-xs font-sans text-[var(--text-muted)] leading-relaxed">
        <p>
          Veritabanı sistemleri, depolama ve sorgu optimizasyonu üzerine kişisel notlar ve teknik rehber.
        </p>
      </div>

      <!-- Main Navigation Menu -->
      <nav aria-label="Sol Kenar Gezinti Menüsü" class="space-y-1">
        <div class="text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider px-2 py-1">
          Gezinti
        </div>
        {navItems.map((item) => (
          <a
            href={item.href}
            data-nav-section={item.id}
            class="sidebar-nav-link flex items-center gap-2.5 px-2.5 py-1.5 text-xs font-sans rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-all group"
          >
            <svg class="nav-icon w-4 h-4 text-[var(--text-dim)] group-hover:text-[var(--accent)] shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span class="truncate">{item.label}</span>
          </a>
        ))}
      </nav>

      <!-- Topic Explorer (Tags / Categories) -->
      <div class="space-y-2 pt-2 border-t border-[var(--border)]">
        <div class="text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider px-2">
          Konu Başlıkları
        </div>
        <div class="flex flex-wrap gap-1.5 px-2">
          {topics.map((t) => (
            <a
              href={`/#articles?tag=${encodeURIComponent(t.tag)}`}
              data-tag={t.tag}
              class="sidebar-topic-tag font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer"
            >
              #{t.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Latest Articles Quick Links -->
      <div class="space-y-2 pt-2 border-t border-[var(--border)]">
        <div class="text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider px-2">
          Son Yayınlanan Notlar
        </div>
        <div class="space-y-1.5 px-2">
          {recentPosts.map((post) => {
            const slug = getPostSlug(post);
            return (
              <a
                href={`/posts/${slug}`}
                class="block text-xs font-serif text-[var(--text-muted)] hover:text-[var(--accent)] hover:underline leading-snug truncate"
                title={post.data.title}
              >
                · {post.data.title}
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Bottom Block: Utility, Social Channels & Theme Toggle -->
    <div class="pt-4 border-t border-[var(--border)] space-y-3">
      <!-- Direct Social Channels -->
      <div class="flex items-center justify-between text-xs font-mono px-2 text-[var(--text-dim)]">
        <a
          href={SITE_META.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text)] transition-colors"
          title="GitHub"
        >
          GitHub
        </a>
        <span>·</span>
        <a
          href={SITE_META.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text)] transition-colors"
          title="LinkedIn"
        >
          LinkedIn
        </a>
        <span>·</span>
        <a
          href="/rss.xml"
          class="hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1"
          title="RSS Akışı"
        >
          <span>RSS</span>
        </a>
      </div>

      <!-- Theme Switcher Button -->
      <div class="px-2">
        <button
          type="button"
          class="theme-toggle-btn w-full px-3 py-1.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] hover:border-[var(--text)] text-[var(--text)] transition-colors font-mono text-xs flex items-center justify-between cursor-pointer tactile-btn"
          aria-label="Temayı Değiştir"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 theme-icon-sun hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="w-3.5 h-3.5 theme-icon-moon hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span class="theme-label">Görünüm</span>
          </span>
          <span class="text-[11px] text-[var(--text-dim)] font-mono theme-mode-text">Açık/Koyu</span>
        </button>
      </div>

      <!-- Minimal Copyright Notice -->
      <div class="px-2 text-[11px] font-mono text-[var(--text-dim)]">
        © {new Date().getFullYear()} Ahmet İhtiyar
      </div>
    </div>
  </div>
</aside>

<!-- Mobile Sticky Top Header (< lg) -->
<div class="lg:hidden sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md transition-colors">
  <div class="px-4 h-14 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 focus:outline-none">
      <div class="w-7 h-7 rounded-[2px] overflow-hidden border border-[var(--border)] shrink-0">
        <img
          src="/profile.png"
          alt="Ahmet İhtiyar"
          width="28"
          height="28"
          class="w-full h-full object-cover filter grayscale"
        />
      </div>
      <div>
        <div class="font-sans font-semibold text-xs text-[var(--text)]">Ahmet İhtiyar</div>
        <div class="font-mono text-[10px] text-[var(--text-dim)]">Veritabanı & Depolama</div>
      </div>
    </a>

    <!-- Controls -->
    <div class="flex items-center gap-2">
      <!-- Mobile Theme Toggle -->
      <button
        type="button"
        class="theme-toggle-btn p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] cursor-pointer tactile-btn w-8 h-8 flex items-center justify-center"
        aria-label="Temayı Değiştir"
      >
        <svg class="w-3.5 h-3.5 theme-icon-sun hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
        </svg>
        <svg class="w-3.5 h-3.5 theme-icon-moon hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle-btn"
        type="button"
        class="p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] cursor-pointer tactile-btn w-8 h-8 flex items-center justify-center"
        aria-label="Menüyü Aç/Kapat"
        aria-expanded="false"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-4 h-4 text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon -->
        <svg id="close-icon" class="w-4 h-4 text-[var(--text)] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Hidden by default) -->
  <div id="mobile-drawer" class="hidden border-t border-[var(--border)] bg-[var(--bg)] px-4 py-4 space-y-4 shadow-lg">
    <nav aria-label="Mobil Gezinti Menüsü" class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-section={item.id}
          class="mobile-nav-link flex items-center gap-2.5 px-3 py-2 text-sm font-sans rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-all"
        >
          <svg class="nav-icon w-4 h-4 text-[var(--text-dim)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
          </svg>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Mobile Topics -->
    <div class="pt-2 border-t border-[var(--border)] space-y-2">
      <div class="text-[11px] font-mono text-[var(--text-dim)] uppercase">Konular</div>
      <div class="flex flex-wrap gap-1.5">
        {topics.map((t) => (
          <a
            href={`/#articles?tag=${encodeURIComponent(t.tag)}`}
            data-tag={t.tag}
            class="mobile-nav-link sidebar-topic-tag font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)] cursor-pointer"
          >
            #{t.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Social Links -->
    <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono text-[var(--text-dim)]">
      <a href={SITE_META.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE_META.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="/rss.xml">RSS Akışı</a>
      <a href={`mailto:${SITE_META.email}`}>E-posta</a>
    </div>
  </div>
</div>

<!-- Unified Theme, Mobile Menu, Scrollspy & Tag Filter Connection Script -->
<script is:inline>
  (function() {
    // 1. Theme Controller across all toggle buttons
    const themeButtons = document.querySelectorAll('.theme-toggle-btn');
    const sunIcons = document.querySelectorAll('.theme-icon-sun');
    const moonIcons = document.querySelectorAll('.theme-icon-moon');
    const modeTexts = document.querySelectorAll('.theme-mode-text');

    function syncThemeUI(theme) {
      if (theme === 'dark') {
        sunIcons.forEach(icon => icon.classList.remove('hidden'));
        moonIcons.forEach(icon => icon.classList.add('hidden'));
        modeTexts.forEach(txt => txt.textContent = 'Koyu');
      } else {
        moonIcons.forEach(icon => icon.classList.remove('hidden'));
        sunIcons.forEach(icon => icon.classList.add('hidden'));
        modeTexts.forEach(txt => txt.textContent = 'Açık');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    syncThemeUI(currentTheme);

    themeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const active = document.documentElement.getAttribute('data-theme') || 'light';
        const next = active === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (_) {}
        syncThemeUI(next);
      });
    });

    // 2. Mobile Menu Drawer Controller
    const menuBtn = document.getElementById('mobile-menu-toggle-btn');
    const drawer = document.getElementById('mobile-drawer');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    function closeMobileMenu() {
      if (menuBtn && drawer) {
        menuBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        hamburger?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    if (menuBtn && drawer) {
      menuBtn.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        if (isExpanded) {
          drawer.classList.add('hidden');
          hamburger?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          drawer.classList.remove('hidden');
          hamburger?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });
    }

    // 3. Topic Tag Click Controller (Connect sidebar tags to article filtering & smooth scroll)
    const topicLinks = document.querySelectorAll('.sidebar-topic-tag');
    topicLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const tag = link.getAttribute('data-tag');
        if (!tag) return;

        if (window.location.pathname === '/' || window.location.pathname === '') {
          e.preventDefault();
          closeMobileMenu();

          if (typeof window.filterArticlesByTag === 'function') {
            window.filterArticlesByTag(tag);
          }
          const articlesSection = document.getElementById('articles');
          if (articlesSection) {
            articlesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          try {
            const url = new URL(window.location.href);
            url.searchParams.set('tag', tag);
            url.hash = 'articles';
            window.history.pushState(null, '', url.pathname + url.search + url.hash);
          } catch (_) {}
        }
      });
    });

    // 4. Smooth Anchor Navigation on Homepage
    const allNavLinks = document.querySelectorAll('.sidebar-nav-link, .mobile-nav-link');
    allNavLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('/#')) return;

        if (window.location.pathname === '/' || window.location.pathname === '') {
          const sectionId = href.replace('/#', '');
          const targetSection = document.getElementById(sectionId);
          if (targetSection) {
            e.preventDefault();
            closeMobileMenu();
            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            try {
              window.history.pushState(null, '', href);
            } catch (_) {}
          }
        }
      });
    });

    // 5. Scrollspy via IntersectionObserver
    (function setupScrollspy() {
      const sectionIds = ['articles', 'systems', 'invariants', 'secondary-projects', 'contact'];
      const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);
      if (sections.length === 0) return;

      const desktopLinks = document.querySelectorAll('.sidebar-nav-link[data-nav-section]');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link[data-nav-section]');

      function setActiveSection(activeId) {
        desktopLinks.forEach(link => {
          const isMatch = link.getAttribute('data-nav-section') === activeId;
          link.classList.toggle('is-active', isMatch);
          link.setAttribute('aria-current', isMatch ? 'true' : 'false');
        });
        mobileNavLinks.forEach(link => {
          const isMatch = link.getAttribute('data-nav-section') === activeId;
          link.classList.toggle('is-active', isMatch);
          link.setAttribute('aria-current', isMatch ? 'true' : 'false');
        });
      }

      function evaluateActiveSection() {
        const scrollBottom = window.innerHeight + window.scrollY;
        const documentHeight = document.documentElement.scrollHeight;

        // Near bottom of page -> contact is active
        if (documentHeight - scrollBottom < 80) {
          setActiveSection('contact');
          return;
        }

        // Before first section (Hero area) -> none active
        const firstSectionTop = sections[0].getBoundingClientRect().top;
        if (firstSectionTop > window.innerHeight * 0.4) {
          setActiveSection('');
          return;
        }

        // Find current section in reading view
        let currentId = '';
        for (const section of sections) {
          const rect = section.getBoundingClientRect();
          if (rect.top <= window.innerHeight * 0.45 && rect.bottom > window.innerHeight * 0.15) {
            currentId = section.id;
            break;
          }
        }

        setActiveSection(currentId);
      }

      // IntersectionObserver for trigger updates
      const observer = new IntersectionObserver(() => {
        evaluateActiveSection();
      }, {
        rootMargin: '-10% 0px -50% 0px',
        threshold: [0, 0.2, 0.5]
      });

      sections.forEach(sec => observer.observe(sec));

      // Scroll listener with passive flag for immediate position checks
      let scrollTimer = null;
      window.addEventListener('scroll', () => {
        if (!scrollTimer) {
          scrollTimer = window.requestAnimationFrame(() => {
            evaluateActiveSection();
            scrollTimer = null;
          });
        }
      }, { passive: true });

      // Initial evaluation
      evaluateActiveSection();
    })();
  })();
</script>
