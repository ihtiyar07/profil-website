---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseSlug } from '../../data/slugUtils';
import { SITE_META } from '../../data/siteMeta';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => {
    const slug = getCaseSlug(entry);
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allCases = await getCollection('cases');
const sortedCases = allCases.sort((a, b) => a.data.fileNumber.localeCompare(b.data.fileNumber));
const currentSlug = getCaseSlug(entry);
const currentIndex = sortedCases.findIndex((c) => getCaseSlug(c) === currentSlug);

const prevCase = currentIndex > 0 ? sortedCases[currentIndex - 1] : null;
const nextCase = currentIndex < sortedCases.length - 1 ? sortedCases[currentIndex + 1] : null;

const otherCases = sortedCases.filter((c) => getCaseSlug(c) !== currentSlug);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout 
  title={`${entry.data.title} — Ahmet İhtiyar`} 
  description={entry.data.summary}
  fullWidth={true}
>
  <div class="flex-1 w-full flex flex-col xl:flex-row items-stretch relative min-h-screen">
    <!-- Main Case Study Column (Expands to fill available space) -->
    <div id="case-main-col" class="flex-1 min-w-0 px-5 sm:px-8 lg:px-10 py-6 sm:py-10 transition-all duration-300">
      <article class="w-full space-y-8">
        <!-- Header -->
        <div class="space-y-4 pb-6 border-b border-[var(--border)]">
          <div class="flex items-center justify-between">
            <a
              href="/"
              class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
              aria-label="Ana sayfaya dön"
            >
              <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
              <span>Ana Sayfaya Dön ({entry.data.fileNumber})</span>
            </a>

            <div class="flex items-center gap-3">
              <button
                type="button"
                id="toggle-right-panel-btn"
                class="hidden xl:inline-flex items-center gap-1.5 font-mono text-xs text-[var(--text-dim)] hover:text-[var(--text)] border border-[var(--border)] px-2.5 py-1 rounded-[2px] bg-[var(--bg-subtle)] hover:bg-[var(--bg)] transition-colors cursor-pointer"
                title="Sağ Paneli Göster veya Gizle"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path d="M15 3v18"/>
                </svg>
                <span id="right-panel-btn-label">Paneli Gizle</span>
              </button>

              <span class="font-mono text-xs text-[var(--text-dim)]">
                {entry.data.date}
              </span>
            </div>
          </div>

        <h1 class="text-3xl sm:text-4xl lg:text-[2.5rem] font-serif text-[var(--text)] tracking-tight leading-[1.2]">
          {entry.data.title}
        </h1>

        <p class="text-base sm:text-lg text-[var(--text-muted)] font-sans leading-relaxed">
          {entry.data.tagline}
        </p>

        <div class="font-mono text-xs text-[var(--text-accent)] pl-3 border-l-2 border-[var(--accent)] py-1.5 bg-[var(--accent-subtle)]/30 rounded-r-[2px]">
          {entry.data.testedScale}
        </div>

        <div class="flex flex-wrap items-center gap-1.5 pt-1">
          <span class="font-mono text-xs text-[var(--text-dim)] mr-1">Yığın:</span>
          {entry.data.stack.map((tech) => (
            <span class="font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)]">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Mobile/Tablet Inline TOC -->
      {tocHeadings.length > 0 && (
        <div class="xl:hidden p-4 bg-[var(--bg-subtle)]/60 border border-[var(--border)] rounded-[2px] space-y-2">
          <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
            İçindekiler
          </div>
          <nav class="space-y-1 text-xs">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block py-0.5 text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors',
                  h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}

      <!-- Case Study Content with Optimal Reading Typography -->
      <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-8 [&>h2]:pb-2 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h2]:text-[var(--text)] [&>h3]:text-xl [&>h3]:font-serif [&>h3]:pt-4 [&>h3]:pb-1 [&>h3]:text-[var(--text)] [&>p]:text-[15.5px] sm:[&>p]:text-[16px] [&>p]:leading-[1.75] [&>p]:max-w-[75ch] [&>p]:text-[var(--text)] [&_strong]:font-semibold [&_strong]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ul>li]:my-1.5 [&>ol>li]:my-1.5 [&>ul>li]:leading-relaxed [&>ol>li]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-[var(--accent)] [&>blockquote]:pl-4 [&>blockquote]:py-1 [&>blockquote]:italic [&>blockquote]:text-[var(--text-muted)] [&>pre]:bg-[var(--bg-code)] [&>pre]:border [&>pre]:border-[var(--border)] [&>pre]:p-4 [&>pre]:rounded-[2px] [&>code]:font-mono [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[13px] [&_:not(pre)>code]:bg-[var(--bg-subtle)] [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-[2px] [&_:not(pre)>code]:border [&_:not(pre)>code]:border-[var(--border)]">
        <Content />
      </div>

      <!-- Case Study Bottom Navigation & Discussion -->
      <div class="pt-8 border-t border-[var(--border)] space-y-5">
        <!-- Top bar: Back link + Subtle feedback link -->
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 font-mono text-xs text-[var(--text-dim)]">
          <a
            href="/"
            class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
            aria-label="Ana sayfaya dön"
          >
            <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
            <span>Ana Sayfaya Dön</span>
          </a>

          <a
            href={`mailto:${SITE_META.email}?subject=${encodeURIComponent(`Vaka İncelemesi: ${entry.data.title}`)}`}
            class="hover:text-[var(--text)] hover:underline inline-flex items-center gap-1 transition-colors"
          >
            <span>Mimariyi tartışmak için e-posta gönder</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <!-- Next / Prev Case Navigation Cards -->
        <nav aria-label="Vaka gezintisi" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
          {prevCase ? (
            <a
              href={`/cases/${getCaseSlug(prevCase)}`}
              class="group p-4 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/40 hover:bg-[var(--bg-subtle)] hover:border-[var(--accent)] transition-all flex flex-col justify-between space-y-2"
            >
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] flex items-center gap-1.5 transition-colors">
                <span aria-hidden="true">←</span> Önceki Vaka ({prevCase.data.fileNumber})
              </span>
              <span class="font-serif text-sm sm:text-[15px] text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-2 leading-snug transition-colors">
                {prevCase.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextCase && (
            <a
              href={`/cases/${getCaseSlug(nextCase)}`}
              class="group p-4 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/40 hover:bg-[var(--bg-subtle)] hover:border-[var(--accent)] transition-all flex flex-col justify-between space-y-2 text-right sm:col-start-2"
            >
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] flex items-center justify-end gap-1.5 transition-colors">
                Sonraki Vaka ({nextCase.data.fileNumber}) <span aria-hidden="true">→</span>
              </span>
              <span class="font-serif text-sm sm:text-[15px] text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-2 leading-snug transition-colors">
                {nextCase.data.title}
              </span>
            </a>
          )}
        </nav>
      </div>
    </article>
    </div>

    <!-- Sticky Right Sidebar: Docked flush right with border-l, zero gap on the right, collapsible -->
    <aside 
      id="article-right-panel"
      class="hidden xl:block w-72 2xl:w-80 shrink-0 border-l border-[var(--border)] bg-[var(--bg)] px-5 py-8 space-y-5 self-start sticky top-0 max-h-screen overflow-y-auto transition-all duration-300 select-none"
    >
      <!-- Panel Header with Close Button -->
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-2 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        <span>Gezinti & Notlar</span>
        <button
          type="button"
          id="close-right-panel-btn"
          class="text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] p-1 rounded-[2px] cursor-pointer transition-colors"
          title="Sağ Paneli Gizle"
          aria-label="Sağ Paneli Gizle"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- TOC Card -->
      {tocHeadings.length > 0 && (
        <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/50 p-4 rounded-[2px] space-y-3">
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-2.5 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
              Bu Vakada (Bölümler)
            </span>
            <span>{tocHeadings.length} Bölüm</span>
          </div>

          <nav aria-label="İçindekiler" class="space-y-1 text-xs font-sans max-h-[calc(100vh-20rem)] overflow-y-auto pr-1">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-heading-slug={h.slug}
                class:list={[
                  'toc-anchor-link block py-1 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors leading-snug rounded-[2px] px-1.5',
                  h.depth === 3 ? 'pl-4 text-[11.5px] text-[var(--text-dim)]' : 'font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}


      <!-- Other Cases Card -->
      {otherCases.length > 0 && (
        <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/30 p-4 rounded-[2px] space-y-2.5">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] font-semibold border-b border-[var(--border)] pb-2">
            Diğer Vaka Çalışmaları
          </div>
          <div class="space-y-1.5">
            {otherCases.map((other) => (
              <a
                href={`/cases/${getCaseSlug(other)}`}
                class="block group text-xs hover:bg-[var(--bg)] p-1.5 -mx-1.5 rounded-[2px] transition-colors"
              >
                <div class="flex items-center gap-1.5 font-mono text-[10px] text-[var(--text-dim)]">
                  <span class="text-[var(--accent)] font-semibold">{other.data.fileNumber}</span>
                  <span>·</span>
                  <span>{other.data.date}</span>
                </div>
                <span class="font-serif text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 block leading-snug">
                  {other.data.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Jump to Top Link -->
      <div class="pt-1">
        <a
          href="#main-content"
          class="font-mono text-[11px] text-[var(--text-dim)] hover:text-[var(--text)] inline-flex items-center gap-1 transition-colors"
        >
          <span>↑ Başa Dön</span>
        </a>
      </div>
    </aside>
  </div>

  <!-- Collapsible Right Panel & Scrollspy Script -->
  <script is:inline>
    (function() {
      // 1. Collapsible Right Panel Logic
      const rightPanel = document.getElementById('article-right-panel');
      const togglePanelBtn = document.getElementById('toggle-right-panel-btn');
      const closePanelBtn = document.getElementById('close-right-panel-btn');
      const panelBtnLabel = document.getElementById('right-panel-btn-label');

      function setPanelCollapsed(collapsed) {
        if (!rightPanel) return;
        if (collapsed) {
          rightPanel.classList.add('!hidden');
          if (panelBtnLabel) panelBtnLabel.textContent = 'Paneli Göster';
          togglePanelBtn?.classList.add('border-[var(--accent)]', 'text-[var(--accent)]');
          try { localStorage.setItem('article_panel_collapsed', 'true'); } catch (_) {}
        } else {
          rightPanel.classList.remove('!hidden');
          if (panelBtnLabel) panelBtnLabel.textContent = 'Paneli Gizle';
          togglePanelBtn?.classList.remove('border-[var(--accent)]', 'text-[var(--accent)]');
          try { localStorage.setItem('article_panel_collapsed', 'false'); } catch (_) {}
        }
      }

      if (togglePanelBtn) {
        togglePanelBtn.addEventListener('click', () => {
          const isCollapsed = rightPanel?.classList.contains('!hidden');
          setPanelCollapsed(!isCollapsed);
        });
      }

      if (closePanelBtn) {
        closePanelBtn.addEventListener('click', () => {
          setPanelCollapsed(true);
        });
      }

      // Restore user preference
      try {
        if (localStorage.getItem('article_panel_collapsed') === 'true') {
          setPanelCollapsed(true);
        }
      } catch (_) {}

      // 2. Scrollspy for Table of Contents
      const tocLinks = document.querySelectorAll('.toc-anchor-link');
      if (!tocLinks.length) return;

      const headings = Array.from(document.querySelectorAll('h2[id], h3[id]'));
      if (!headings.length) return;

      function onScroll() {
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        const offset = 120;

        let currentActive = null;
        for (let i = 0; i < headings.length; i++) {
          const top = headings[i].getBoundingClientRect().top + scrollY - offset;
          if (scrollY >= top) {
            currentActive = headings[i].id;
          }
        }

        tocLinks.forEach(link => {
          const slug = link.getAttribute('data-heading-slug');
          if (slug === currentActive) {
            link.classList.add('bg-[var(--bg)]', 'text-[var(--accent)]', 'font-semibold', 'border-l-2', 'border-[var(--accent)]', 'pl-2');
          } else {
            link.classList.remove('bg-[var(--bg)]', 'text-[var(--accent)]', 'font-semibold', 'border-l-2', 'border-[var(--accent)]', 'pl-2');
          }
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</BaseLayout>
