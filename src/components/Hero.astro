---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const headline = SITE_META.headline[lang];
const nowLine = SITE_META.nowLine[lang];
---

<section class="relative py-12 sm:py-18 border-b border-[var(--border)]">

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- Left 8 Columns: Editorial Headline, Bio, and Industrial CTA -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Monospace Section Tag -->
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-[var(--text-accent)] uppercase tracking-wider font-semibold">
          00 · {isTr ? 'GİRİŞ & KONUMLANDIRMA' : 'POSITIONING & DOSSIER'}
        </span>
        <span class="h-px w-8 bg-[var(--border-strong)]"></span>
      </div>

      <!-- H1 Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-serif leading-[1.16] tracking-tight text-[var(--text)]">
        {isTr ? (
          <>
            Sensörden imzalı rapora, <span class="italic font-normal">verinin yolunu</span> baştan sona kuran mühendis.
          </>
        ) : (
          <>
            From raw sensor to signed audit report: <span class="italic font-normal">engineering the entire path of data.</span>
          </>
        )}
      </h1>

      <!-- "Now" Line -->
      <div class="font-mono text-xs sm:text-[13px] text-[var(--text-muted)] border-l-2 border-[var(--accent)] pl-3.5 py-1 leading-relaxed bg-[var(--bg-subtle)]/40">
        <div class="flex items-start gap-2">
          <span class="w-1.5 h-1.5 bg-[var(--accent)] mt-1.5 inline-block shrink-0" aria-hidden="true"></span>
          <span>{nowLine}</span>
        </div>
      </div>

      <!-- Bio / Context -->
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed max-w-[65ch] font-sans">
        {isTr ? (
          <>
            Diverjans Bilgi Teknolojileri bünyesinde; donanım seviyesinden (ESP32, Modbus) dağıtık mikroservislere, zaman serisi depolamadan (TimescaleDB) Apache Arrow sıfır kopyalama veri aktarımına ve resmi e-imzalı denetim raporlarına kadar uzanan uçtan uca veri hatlarını kuruyorum.
          </>
        ) : (
          <>
            Based in Istanbul, engineering distributed data infrastructure at Diverjans IT. Building end-to-end telemetry pipelines from physical microcontrollers (ESP32, Modbus) and message brokers up to high-throughput time-series storage (TimescaleDB), Apache Arrow zero-copy streams, and legally binding audit reports.
          </>
        )}
      </p>

      <!-- Industrial CTA Actions -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 font-mono text-xs pt-2">
        <!-- Main Industrial Inverting CTA -->
        <a
          href={isTr ? '#cases' : '/en#cases'}
          class="px-5 py-3 bg-[var(--text)] text-[var(--bg)] border border-[var(--text)] hover:bg-[var(--bg)] hover:text-[var(--text)] transition-colors rounded-none font-mono text-xs font-semibold tracking-wider uppercase inline-flex items-center gap-3 tactile-btn group"
        >
          <span>{isTr ? 'Vaka Çalışmalarını İncele' : 'Inspect Case Studies'}</span>
          <span class="font-mono transition-transform group-hover:translate-x-1" aria-hidden="true">-></span>
        </a>

        <!-- Secondary Industrial Mail CTA -->
        <a
          href={`mailto:${SITE_META.email}`}
          class="px-5 py-3 bg-transparent text-[var(--text)] border border-[var(--border-strong)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors rounded-none font-mono text-xs font-semibold tracking-wider uppercase inline-flex items-center gap-2 tactile-btn"
        >
          <span>{isTr ? 'E-posta Gönder' : 'Send Email'}</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right 4 Columns: High-contrast Monochrome Portrait with Technical Blueprint Coordinates -->
    <div class="lg:col-span-4 flex flex-col items-start lg:items-end">
      <div class="relative border border-[var(--border-strong)] p-1 bg-[var(--bg-subtle)] rounded-[2px] shadow-xs w-fit">
        <!-- High-Contrast Monochrome Portrait Container -->
        <div class="w-40 sm:w-48 h-48 sm:h-56 overflow-hidden bg-[var(--bg)] border border-[var(--border)] relative group/photo">
          <picture>
            <source srcset="/profile.webp" type="image/webp" />
            <img
              src="/profile.png"
              alt="Ahmet İhtiyar — Portre"
              width="192"
              height="224"
              loading="eager"
              class="w-full h-full object-cover object-center transition-all duration-500 filter contrast-[1.05] sm:grayscale sm:contrast-[1.18] sm:brightness-[0.98] sm:group-hover/photo:contrast-[1.05] sm:group-hover/photo:grayscale-0"
            />
          </picture>
        </div>

        <!-- Clean Location & Status Footer -->
        <div class="px-2 py-1.5 font-mono text-[11px] text-[var(--text-muted)] flex items-center justify-between gap-2 mt-1">
          <div class="flex items-center gap-1.5 font-medium tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <span>{isTr ? 'İstanbul' : 'Istanbul'}</span>
          </div>
          <span class="text-[var(--text-dim)]">Diverjans IT</span>
        </div>
      </div>
    </div>
  </div>
</section>
