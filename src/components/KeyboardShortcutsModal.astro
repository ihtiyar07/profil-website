---
export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const shortcuts = [
  { key: '1 – 6', desc: isTr ? 'Veri Hattı Durakları (01 Edge - 06 Trust)' : 'Data Pipeline Stops (01 Edge - 06 Trust)' },
  { key: 'P', desc: isTr ? 'Telemetri Ping Simülasyonu Ateşle' : 'Fire Telemetry Ping Simulator' },
  { key: 'T', desc: isTr ? 'Koyu / Açık Tema Değiştir' : 'Toggle Dark / Light Theme' },
  { key: 'C', desc: isTr ? 'Vaka Çalışmalarına Git (#cases)' : 'Jump to Case Studies (#cases)' },
  { key: 'I', desc: isTr ? 'Mimari Değişmezlere Git (#invariants)' : 'Jump to Invariants (#invariants)' },
  { key: 'W', desc: isTr ? 'Mühendislik Yazılarına Git (#writing)' : 'Jump to Engineering Notes (#writing)' },
  { key: '?', desc: isTr ? 'Bu Kısayol Menüsünü Aç / Kapat' : 'Toggle this Shortcuts Guide' },
  { key: 'Esc', desc: isTr ? 'Pencereyi Kapat' : 'Close Modal' },
];
---

<!-- Floating Trigger Pill -->
<button
  id="shortcuts-toggle-btn"
  type="button"
  class="fixed bottom-4 left-4 z-40 font-mono text-[11px] px-2.5 py-1.5 rounded-[2px] bg-[var(--bg-card)] border border-[var(--border)] hover:border-[#E8590C] text-[var(--text-muted)] hover:text-[#E8590C] shadow-sm transition-all tactile-btn flex items-center gap-1.5 cursor-pointer"
  aria-label={isTr ? "Klavye kısayolları rehberini aç" : "Open keyboard shortcuts guide"}
  aria-haspopup="dialog"
>
  <span class="kbd-key text-[9px] px-1 py-0.2">?</span>
  <span class="hidden sm:inline">{isTr ? 'Kısayollar' : 'Shortcuts'}</span>
</button>

<!-- Accessible Modal Backdrop & Dialog -->
<div
  id="shortcuts-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/55 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="shortcuts-title"
>
  <div class="relative w-full max-w-md bg-[var(--bg-card)] border border-[var(--border-strong)] rounded-[3px] p-6 shadow-2xl tech-corner-marks transform scale-95 transition-transform duration-200" id="shortcuts-modal-card">
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-[var(--border)]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-[1px] bg-[#E8590C]" aria-hidden="true"></span>
        <h3 id="shortcuts-title" class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text)]">
          {isTr ? 'Klavye Komut Paleti & Kısayollar' : 'Command Palette & Keyboard Shortcuts'}
        </h3>
      </div>
      <button
        id="shortcuts-close-btn"
        type="button"
        class="font-mono text-xs text-[var(--text-dim)] hover:text-[#E8590C] px-1.5 py-0.5 rounded-[2px] border border-transparent hover:border-[var(--border)] cursor-pointer"
        aria-label={isTr ? "Kapat" : "Close"}
      >
        ✕
      </button>
    </div>

    <!-- Shortcut Items Table -->
    <div class="space-y-2.5 font-mono text-xs">
      {shortcuts.map((item) => (
        <div class="flex items-center justify-between py-1 border-b border-[var(--border)]/60 last:border-0">
          <span class="text-[var(--text-muted)] text-[12px] font-sans">
            {item.desc}
          </span>
          <kbd class="kbd-key ml-3 shrink-0">
            {item.key}
          </kbd>
        </div>
      ))}
    </div>

    <!-- Footer Note -->
    <div class="mt-5 pt-3 border-t border-[var(--border)] flex items-center justify-between text-[10px] font-mono text-[var(--text-dim)]">
      <span>{isTr ? 'Donanım & Mühendislik Odaklı Arayüz' : 'Hardware & Systems Dossier'}</span>
      <span class="kbd-key text-[9px] px-1">[Esc] {isTr ? 'Kapat' : 'Close'}</span>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const toggleBtn = document.getElementById('shortcuts-toggle-btn');
    const modal = document.getElementById('shortcuts-modal');
    const modalCard = document.getElementById('shortcuts-modal-card');
    const closeBtn = document.getElementById('shortcuts-close-btn');

    let lastFocusedElement = null;

    function openModal() {
      if (!modal) return;
      lastFocusedElement = document.activeElement;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalCard?.classList.remove('scale-95');
      modalCard?.classList.add('scale-100');
      closeBtn?.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard?.classList.remove('scale-100');
      modalCard?.classList.add('scale-95');
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      } else {
        toggleBtn?.focus();
      }
    }

    toggleBtn?.addEventListener('click', () => {
      const isOpen = !modal?.classList.contains('pointer-events-none');
      if (isOpen) closeModal();
      else openModal();
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Global Key Listener
    window.addEventListener('keydown', (e) => {
      // CRITICAL: Never intercept modifier keys (Ctrl, Meta, Alt) to preserve browser shortcuts (Ctrl+C, Ctrl+W, Ctrl+T, etc.)
      if (e.ctrlKey || e.metaKey || e.altKey) {
        return;
      }

      // Don't intercept when user is typing in forms or input fields
      const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'textarea' || (document.activeElement && document.activeElement.isContentEditable)) {
        return;
      }

      const isOpen = !modal?.classList.contains('pointer-events-none');

      // Modal focus trap on Tab
      if (isOpen && e.key === 'Tab') {
        const focusable = modalCard?.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (focusable && focusable.length > 0) {
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
            return;
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
            return;
          }
        }
      }

      // Close modal on Escape
      if (e.key === 'Escape') {
        if (isOpen) {
          e.preventDefault();
          closeModal();
          return;
        }
      }

      // Toggle modal on '?'
      if (e.key === '?' || (e.shiftKey && e.key === '/')) {
        e.preventDefault();
        if (isOpen) closeModal();
        else openModal();
        return;
      }

      // If modal is currently open, DO NOT trigger underlying page jumps
      if (isOpen) {
        return;
      }

      // Quick jumps (only single keys when not in modal)
      if (e.key === 't' || e.key === 'T') {
        e.preventDefault();
        const themeBtn = document.getElementById('theme-toggle-btn');
        themeBtn?.click();
      } else if (e.key === 'c' || e.key === 'C') {
        e.preventDefault();
        const cases = document.getElementById('cases');
        cases?.scrollIntoView({ behavior: 'smooth' });
      } else if (e.key === 'i' || e.key === 'I') {
        e.preventDefault();
        const inv = document.getElementById('invariants');
        inv?.scrollIntoView({ behavior: 'smooth' });
      } else if (e.key === 'w' || e.key === 'W') {
        e.preventDefault();
        const writing = document.getElementById('writing');
        writing?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  })();
</script>
