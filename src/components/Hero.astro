---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section class="py-12 sm:py-20 border-b border-[var(--border)]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
    <!-- Left 8 Columns: Narrative & Headline -->
    <div class="lg:col-span-8 space-y-7">
      <!-- Live Status Telemetry Bar -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[var(--text-dim)]">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--status-green)] font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)]" aria-hidden="true"></span>
          <span>{isTr ? 'Üretimde Aktif' : 'Production Active'}</span>
        </span>
        <span class="text-[var(--border-strong)]">·</span>
        <span>{isTr ? 'Diverjans IT · Telemetri ve Veri Altyapısı' : 'Diverjans IT · Telemetry & Data Infrastructure'}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-serif leading-[1.14] tracking-tight text-[var(--text)]">
        {isTr ? (
          <>
            Gömülü uç sistemlerden dağıtık mimarilere <span class="italic font-normal">telemetri ve veri altyapıları</span> geliştiriyorum.
          </>
        ) : (
          <>
            Engineering telemetry and data infrastructure <span class="italic font-normal">from embedded edge to distributed backends.</span>
          </>
        )}
      </h1>

      <!-- Bio / Context Narrative -->
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed max-w-[65ch] font-sans">
        {isTr ? (
          <>
            Diverjans IT bünyesinde; saha donanımlarından (ESP32, Modbus RTU/TCP) dağıtık mikroservislere, zaman serisi veritabanlarından (TimescaleDB) Apache Arrow tabanlı veri aktarımına ve e-imzalı denetim raporlarına uzanan sistem altyapıları tasarlıyor ve yönetiyorum.
          </>
        ) : (
          <>
            Engineering distributed telemetry and data systems at Diverjans IT in Istanbul. Designing end-to-end pipelines from physical edge devices (ESP32, Modbus RTU/TCP) to time-series storage (TimescaleDB), Apache Arrow zero-copy streaming, and certified X.509 audit reports.
          </>
        )}
      </p>

      <!-- Integrated Architectural Telemetry Matrix -->
      <div class="pt-2 border-t border-[var(--border)]">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 py-3 font-mono">
          <div>
            <div class="text-xl sm:text-2xl font-semibold text-[var(--text)] tracking-tight">100K+</div>
            <div class="text-[11px] text-[var(--text-dim)] mt-0.5">{isTr ? 'Saha Cihaz Kapasitesi' : 'Field Device Fleet'}</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-semibold text-[var(--text-accent)] tracking-tight">&lt;15ms</div>
            <div class="text-[11px] text-[var(--text-dim)] mt-0.5">{isTr ? 'Arrow İkili Akış Gecikmesi' : 'Arrow IPC Latency'}</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-semibold text-[var(--text)] tracking-tight">&lt;1ms</div>
            <div class="text-[11px] text-[var(--text-dim)] mt-0.5">{isTr ? 'O(1) Yetki İptal Süresi' : 'O(1) Revocation'}</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-semibold text-[var(--status-green)] tracking-tight">0</div>
            <div class="text-[11px] text-[var(--text-dim)] mt-0.5">{isTr ? 'Saha Kesintisi Paket Kaybı' : 'Outage Packet Loss'}</div>
          </div>
        </div>
      </div>

      <!-- Clean Action Links -->
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <a
          href={isTr ? '#pipeline' : '/en#pipeline'}
          class="px-5 py-2.5 bg-[var(--text)] text-[var(--bg)] hover:bg-[var(--accent)] hover:text-white transition-colors text-xs font-mono font-medium inline-flex items-center gap-2 tactile-btn rounded-[2px]"
        >
          <span>{isTr ? 'Veri Hattını İncele' : 'Explore Data Pipeline'}</span>
          <span aria-hidden="true">↓</span>
        </a>

        <a
          href={isTr ? '#cases' : '/en#cases'}
          class="px-5 py-2.5 bg-transparent text-[var(--text)] border border-[var(--border-strong)] hover:border-[var(--text)] transition-colors text-xs font-mono font-medium inline-flex items-center gap-2 tactile-btn rounded-[2px]"
        >
          <span>{isTr ? 'Vaka Çalışmaları' : 'Case Studies'}</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={`mailto:${SITE_META.email}`}
          class="px-3 py-2.5 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors text-xs font-mono inline-flex items-center gap-1.5"
        >
          <span>{isTr ? 'Doğrudan İletişim' : 'Direct Contact'}</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right 4 Columns: Direct, Architectural Portrait -->
    <div class="lg:col-span-4 flex flex-col items-start lg:items-end">
      <div class="w-48 sm:w-56 space-y-3">
        <div class="aspect-[4/5] overflow-hidden bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] relative group">
          <picture>
            <source srcset="/profile.webp" type="image/webp" />
            <img
              src="/profile.png"
              alt="Ahmet İhtiyar"
              width="224"
              height="280"
              loading="eager"
              class="w-full h-full object-cover object-center filter grayscale contrast-[1.05] group-hover:grayscale-0 group-hover:contrast-100 transition-all duration-500"
            />
          </picture>
        </div>

        <div class="flex items-center justify-between text-[11px] font-mono text-[var(--text-dim)] px-0.5">
          <span>İstanbul · Diverjans IT</span>
          <span class="text-[var(--status-green)] font-medium">● {isTr ? 'Aktif' : 'Active'}</span>
        </div>
      </div>
    </div>
  </div>
</section>
