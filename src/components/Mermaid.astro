  function findExplanation(nodeId: string, nodeText: string) {
    const cleanId = nodeId.toLowerCase();
    const cleanText = nodeText.toLowerCase();

    for (const [key, value] of Object.entries(EXPLANATIONS)) {
      if (cleanId.includes(key) || cleanText.includes(key)) {
        return value;
      }
    }
    return null;
  }

  function setupInteractiveTooltips(figure: HTMLElement) {
    const dialog = figure.querySelector('.mermaid-node-dialog') as HTMLElement | null;
    if (!dialog) return;

    const titleEl = dialog.querySelector('.node-dialog-title') as HTMLElement;
    const roleEl = dialog.querySelector('.node-dialog-role') as HTMLElement;
    const descEl = dialog.querySelector('.node-dialog-desc') as HTMLElement;
    const detailEl = dialog.querySelector('.node-dialog-detail') as HTMLElement;
    const closeBtn = dialog.querySelector('.node-dialog-close') as HTMLElement;

    let isPinned = false;
    let activeNode: Element | null = null;

    function showDialog(exp: typeof EXPLANATIONS[string], targetRect: DOMRect, pin = false) {
      titleEl.textContent = exp.title;
      roleEl.textContent = exp.role;
      descEl.textContent = exp.desc;
      if (exp.detail) {
        detailEl.textContent = exp.detail;
        detailEl.classList.remove('hidden');
      } else {
        detailEl.classList.add('hidden');
      }

      const isMobile = window.innerWidth < 640;

      if (isMobile) {
        dialog.style.left = '16px';
        dialog.style.right = '16px';
        dialog.style.top = 'auto';
        dialog.style.bottom = '20px';
        dialog.style.width = 'auto';
      } else {
        const dialogWidth = 320;
        let left = targetRect.left + targetRect.width / 2 - dialogWidth / 2;
        if (left < 16) left = 16;
        if (left + dialogWidth > window.innerWidth - 16) {
          left = window.innerWidth - dialogWidth - 16;
        }

        const spaceBelow = window.innerHeight - targetRect.bottom;
        const spaceAbove = targetRect.top;

        let top = targetRect.bottom + 8;
        if (spaceBelow < 250 && spaceAbove > spaceBelow) {
          top = Math.max(16, targetRect.top - 240);
        }

        dialog.style.left = `${left}px`;
        dialog.style.top = `${top}px`;
        dialog.style.right = 'auto';
        dialog.style.bottom = 'auto';
        dialog.style.width = `${dialogWidth}px`;
      }

      dialog.classList.remove('opacity-0', 'pointer-events-none');
      dialog.classList.add('opacity-100', 'pointer-events-auto');
      isPinned = pin;
    }

    function hideDialog() {
      if (isPinned) return;
      dialog.classList.remove('opacity-100', 'pointer-events-auto');
      dialog.classList.add('opacity-0', 'pointer-events-none');
      if (activeNode) {
        activeNode.classList.remove('active-tooltip');
        activeNode = null;
      }
    }

    function forceCloseDialog() {
      isPinned = false;
      dialog.classList.remove('opacity-100', 'pointer-events-auto');
      dialog.classList.add('opacity-0', 'pointer-events-none');
      if (activeNode) {
        activeNode.classList.remove('active-tooltip');
        activeNode = null;
      }
    }

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      forceCloseDialog();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') forceCloseDialog();
    });

    document.addEventListener('click', (e) => {
      if (isPinned && !dialog.contains(e.target as Node) && !activeNode?.contains(e.target as Node)) {
        forceCloseDialog();
      }
    });

    const nodes = figure.querySelectorAll('.mermaid-diagram svg .node, .mermaid-fullscreen-stage svg .node');
    nodes.forEach((node) => {
      const text = node.textContent || '';
      const exp = findExplanation(node.id, text);
      if (!exp) return;

      node.classList.add('has-tooltip');

      node.addEventListener('mouseenter', () => {
        if (isPinned) return;
        if (activeNode) activeNode.classList.remove('active-tooltip');
        activeNode = node;
        node.classList.add('active-tooltip');
        showDialog(exp, node.getBoundingClientRect(), false);
      });

      node.addEventListener('mouseleave', () => {
        if (!isPinned) hideDialog();
      });

      node.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isPinned && activeNode === node) {
          forceCloseDialog();
          return;
        }
        if (activeNode) activeNode.classList.remove('active-tooltip');
        activeNode = node;
        node.classList.add('active-tooltip');
        showDialog(exp, node.getBoundingClientRect(), true);
      });
    });
  }

  function setupFullscreenModal(figure: HTMLElement) {
    const trigger = figure.querySelector('.mermaid-fullscreen-trigger');
    const modal = figure.querySelector('.mermaid-fullscreen-modal') as HTMLElement;
    if (!trigger || !modal) return;

    const closeBtn = modal.querySelector('.mermaid-fullscreen-close');
    const zoomInBtn = modal.querySelector('.mermaid-zoom-in');
    const zoomOutBtn = modal.querySelector('.mermaid-zoom-out');
    const zoomResetBtn = modal.querySelector('.mermaid-zoom-reset');
    const zoomLevelText = modal.querySelector('.zoom-level-text');
    const stage = modal.querySelector('.mermaid-fullscreen-stage') as HTMLElement;
    const diagramContainer = figure.querySelector('.mermaid-diagram');

    let currentZoom = 1.35;

    function applyZoom(z: number) {
      currentZoom = Math.min(3.0, Math.max(0.6, z));
      if (stage) {
        stage.style.transform = `scale(${currentZoom})`;
      }
      if (zoomLevelText) {
        zoomLevelText.textContent = `%${Math.round(currentZoom * 100)}`;
      }
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      if (stage) stage.innerHTML = '';
    }

    function openModal() {
      const svg = figure.querySelector('.mermaid-diagram svg');
      if (!svg || !stage) return;

      const clonedSvg = svg.cloneNode(true) as SVGSVGElement;
      clonedSvg.style.maxWidth = 'none';
      clonedSvg.style.width = 'auto';
      clonedSvg.style.minWidth = '860px';
      clonedSvg.style.height = 'auto';
      stage.innerHTML = '';
      stage.appendChild(clonedSvg);

      applyZoom(1.35);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      // Setup node interactive tooltips on the cloned SVG inside modal!
      setupInteractiveTooltips(modal);
    }

    trigger.addEventListener('click', openModal);
    diagramContainer?.addEventListener('dblclick', openModal);

    closeBtn?.addEventListener('click', closeModal);

    zoomInBtn?.addEventListener('click', () => applyZoom(currentZoom + 0.25));
    zoomOutBtn?.addEventListener('click', () => applyZoom(currentZoom - 0.25));
    zoomResetBtn?.addEventListener('click', () => applyZoom(1.35));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  function renderAllMermaid() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'neutral',
      fontFamily: "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif",
      securityLevel: 'loose',
      themeVariables: isDark ? {
        primaryColor: '#1A202C',
        primaryTextColor: '#E2E8F0',
        primaryBorderColor: '#3A4250',
        lineColor: '#94A3B8',
        secondaryColor: '#141820',
        tertiaryColor: '#1A202C',
        mainBkg: '#1A202C',
        nodeBorder: '#3A4250',
        clusterBkg: '#141820',
        clusterBorder: '#3A4250',
        edgeLabelBackground: '#141820',
        fontSize: '12px'
      } : {
        primaryColor: '#F1F5F9',
        primaryTextColor: '#0F172A',
        primaryBorderColor: '#CBD5E1',
        lineColor: '#64748B',
        secondaryColor: '#FFFFFF',
        tertiaryColor: '#F8FAFC',
        mainBkg: '#FFFFFF',
        nodeBorder: '#CBD5E1',
        clusterBkg: '#F8FAFC',
        clusterBorder: '#CBD5E1',
        edgeLabelBackground: '#FFFFFF',
        fontSize: '12px'
      }
    });

    const diagrams = document.querySelectorAll('.mermaid-diagram:not([data-processed="true"])');
    diagrams.forEach(async (el) => {
      const code = el.getAttribute('data-code');
      if (!code) return;
      el.setAttribute('data-processed', 'true');
      try {
        const id = 'svg-' + el.id + '-' + Math.random().toString(36).substring(2, 6);
        const { svg } = await mermaid.render(id, code.trim());
        el.innerHTML = svg;
        el.classList.remove('opacity-0');

        const figure = el.closest('.mermaid-container') as HTMLElement;
        if (figure) {
          setupInteractiveTooltips(figure);
          setupFullscreenModal(figure);
        }
      } catch (err) {
        console.error('Mermaid render error:', err);
        el.classList.remove('opacity-0');
      }
    });
  }

  // Run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderAllMermaid);
  } else {
    renderAllMermaid();
  }

  // Re-render when theme changes
  const themeObserver = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.attributeName === 'data-theme') {
        document.querySelectorAll('.mermaid-diagram').forEach(el => el.removeAttribute('data-processed'));
        renderAllMermaid();
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
