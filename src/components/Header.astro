---
export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const navItems = isTr ? [
  { href: '#pipeline', label: 'Veri Hattı' },
  { href: '#cases', label: 'Vaka Çalışmaları' },
  { href: '#secondary-projects', label: 'Sistem Kaydı' },
  { href: '#invariants', label: 'Değişmezler' },
  { href: '#contact', label: 'İletişim' }
] : [
  { href: '/en#pipeline', label: 'Data Path' },
  { href: '/en#cases', label: 'Case Studies' },
  { href: '/en#secondary-projects', label: 'Systems' },
  { href: '/en#invariants', label: 'Invariants' },
  { href: '/en#contact', label: 'Contact' }
];

const homeUrl = isTr ? '/' : '/en';
const targetLangUrl = isTr ? '/en' : '/';
---

<header class="w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-[4px] sticky top-0 z-40 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand / Identity -->
    <a href={homeUrl} class="flex items-center gap-2 group focus:outline-none" aria-label="Ahmet İhtiyar Ana Sayfa">
      <span class="w-2.5 h-2.5 rounded-[1px] bg-[var(--accent)] inline-block transition-transform group-hover:scale-110"></span>
      <span class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-[var(--text)] uppercase">
        Ahmet İhtiyar
      </span>
      <span class="hidden md:inline font-mono text-xs text-[var(--text-dim)] border-l border-[var(--border)] pl-2">
        {isTr ? 'Mühendislik Dosyası' : 'Engineering Dossier'}
      </span>
    </a>

    <!-- Nav & Actions -->
    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="hidden lg:flex items-center gap-4 text-xs font-mono" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-[var(--text-muted)] hover:text-[var(--accent)] hover:underline transition-colors py-1 px-0.5"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2 pl-2 border-l border-[var(--border)]">
        <!-- Language Switcher -->
        <a
          href={targetLangUrl}
          class="font-mono text-xs px-2.5 py-1 border border-[var(--border)] rounded-[2px] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors tactile-btn"
          title={isTr ? "Switch to English" : "Türkçe'ye Geç"}
          aria-label={isTr ? "Switch to English" : "Türkçe'ye Geç"}
        >
          {isTr ? 'EN' : 'TR'}
        </a>

        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="font-mono text-xs px-2.5 py-1 border border-[var(--border)] rounded-[2px] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 cursor-pointer tactile-btn"
          aria-label={isTr ? "Temayı Değiştir (Açık/Koyu)" : "Toggle theme (Light/Dark)"}
          title={isTr ? "Temayı Değiştir" : "Toggle Theme"}
        >
          <!-- Sun Icon (in dark mode) -->
          <svg id="theme-icon-sun" class="w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon Icon (in light mode) -->
          <svg id="theme-icon-moon" class="w-3.5 h-3.5 hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span id="theme-label" class="text-[11px] uppercase tracking-wider">{isTr ? 'Koyu' : 'Dark'}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Quick Section Scroller (visible on small screens) -->
  <div class="lg:hidden border-t border-[var(--border)] bg-[var(--bg-subtle)] px-4 py-1.5 overflow-x-auto no-scrollbar flex items-center gap-3 text-[11px] font-mono whitespace-nowrap">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors py-0.5"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('theme-toggle-btn');
    const label = document.getElementById('theme-label');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const isTurkish = document.documentElement.lang === 'tr';

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        if (label) label.textContent = isTurkish ? 'Açık' : 'Light';
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        if (label) label.textContent = isTurkish ? 'Koyu' : 'Dark';
        moonIcon?.classList.remove('hidden');
        sunIcon?.classList.add('hidden');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    btn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (_) {}
      updateThemeUI(next);
    });
  })();
</script>
