---
import { SITE_META } from '../data/siteMeta';
---

<section class="py-8 sm:py-12 border-b border-[var(--border)]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- Left Column: Narrative & Headline -->
    <div class="lg:col-span-7 xl:col-span-7 space-y-5 sm:space-y-6">
      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-serif leading-[1.18] tracking-tight text-[var(--text)]">
        Veritabanı sistemleri, depolama ve veri altyapıları üzerine çalışıyorum.
      </h1>

      <!-- 2-Paragraph Narrative / Mission Statement -->
      <div class="space-y-3.5 max-w-[65ch] text-[var(--text-muted)] font-sans text-base sm:text-[17px] leading-relaxed">
        <p>
          İlişkisel ve zaman serisi veritabanları, depolama motorları ve sorgu optimizasyonu üzerine çalışıyorum.
        </p>
        <p class="text-sm sm:text-base text-[var(--text)] bg-[var(--bg-subtle)]/70 p-3.5 border border-[var(--border)] rounded-[2px] leading-relaxed">
          Bu site; sahada karşılaştığım problemleri, edindiğim tecrübeleri ve veritabanı altyapıları üzerine öğrendiklerimi adım adım paylaştığım kişisel bir teknik rehber (tutorial) niteliğindedir.
        </p>
      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="#articles"
          class="px-4 py-2 bg-[var(--text)] text-[var(--bg)] hover:bg-[var(--accent)] hover:text-white transition-colors text-xs font-mono font-medium inline-flex items-center gap-2 tactile-btn rounded-[2px]"
        >
          <span>Yazıları Oku</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#systems"
          class="px-4 py-2 border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text)] hover:border-[var(--text)] transition-colors text-xs font-mono font-medium inline-flex items-center gap-1.5 rounded-[2px] tactile-btn"
        >
          <span>Sistem Mimarileri</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↓</span>
        </a>

        <a
          href={`mailto:${SITE_META.email}`}
          class="px-4 py-2 border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors text-xs font-mono font-medium inline-flex items-center gap-1.5 rounded-[2px] tactile-btn"
        >
          <span>İletişime Geç</span>
          <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Focus Areas & Quick Technical Directory (Balances layout gracefully) -->
    <div class="lg:col-span-5 xl:col-span-5 pt-2 lg:pt-0">
      <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/50 rounded-[2px] p-5 space-y-4 shadow-sm">
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] font-semibold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)]" aria-hidden="true"></span>
            Rehber & Odak Alanları
          </span>
          <span class="text-[10px] font-mono text-[var(--text-dim)]">6 Yazı · 3 Vaka</span>
        </div>

        <div class="space-y-1 font-sans text-xs">
          <a href="/posts/timescaledb-continuous-aggregates-ve-retention-pratikte" class="group flex items-start justify-between gap-3 p-2 -mx-2 rounded-[2px] hover:bg-[var(--bg)] transition-colors">
            <div>
              <span class="font-mono text-[11px] text-[var(--accent)] font-semibold block group-hover:underline underline-offset-2">01 · PostgreSQL & TimescaleDB</span>
              <span class="text-[var(--text-muted)] leading-tight text-[12px]">Continuous aggregates, hypertables ve zero-lock metadata</span>
            </div>
            <span class="font-mono text-[11px] text-[var(--text-dim)] group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-all shrink-0 pt-0.5" aria-hidden="true">→</span>
          </a>

          <a href="/posts/awr-ve-ash-ile-bir-oracle-darbogazini-bulmak" class="group flex items-start justify-between gap-3 p-2 -mx-2 rounded-[2px] hover:bg-[var(--bg)] transition-colors border-t border-[var(--border)]/60">
            <div>
              <span class="font-mono text-[11px] text-[var(--accent)] font-semibold block group-hover:underline underline-offset-2">02 · Oracle Database</span>
              <span class="text-[var(--text-muted)] leading-tight text-[12px]">AWR & ASH darboğaz analizi, plan sabitleme ve SQL tuning</span>
            </div>
            <span class="font-mono text-[11px] text-[var(--text-dim)] group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-all shrink-0 pt-0.5" aria-hidden="true">→</span>
          </a>

          <a href="/posts/arrow-ile-dbden-tarayiciya-zero-copy" class="group flex items-start justify-between gap-3 p-2 -mx-2 rounded-[2px] hover:bg-[var(--bg)] transition-colors border-t border-[var(--border)]/60">
            <div>
              <span class="font-mono text-[11px] text-[var(--accent)] font-semibold block group-hover:underline underline-offset-2">03 · Depolama & Sıfır Kopyalama</span>
              <span class="text-[var(--text-muted)] leading-tight text-[12px]">Apache Arrow IPC, ZFS havuzları ve Proxmox VE</span>
            </div>
            <span class="font-mono text-[11px] text-[var(--text-dim)] group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-all shrink-0 pt-0.5" aria-hidden="true">→</span>
          </a>

          <a href="/posts/jwtde-yetki-tasimak-neden-her-zaman-iyi-fikir-degil" class="group flex items-start justify-between gap-3 p-2 -mx-2 rounded-[2px] hover:bg-[var(--bg)] transition-colors border-t border-[var(--border)]/60">
            <div>
              <span class="font-mono text-[11px] text-[var(--accent)] font-semibold block group-hover:underline underline-offset-2">04 · Dağıtık Oturum & Güvenlik</span>
              <span class="text-[var(--text-muted)] leading-tight text-[12px]">Redis destekli anında yetki iptali ve Keycloak SSO</span>
            </div>
            <span class="font-mono text-[11px] text-[var(--text-dim)] group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-all shrink-0 pt-0.5" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
