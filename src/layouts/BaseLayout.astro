---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE_META } from '../data/siteMeta';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  articleMeta?: {
    publishDate: string;
    tags: string[];
  };
}

const {
  title = SITE_META.title,
  description = SITE_META.bioShort,
  canonicalPath = '',
  articleMeta
} = Astro.props;

const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, SITE_META.siteUrl).toString();

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImagePath = cleanPath === '' 
  ? '/og/index.png' 
  : `/og/${cleanPath}.png`;
const ogImageUrl = new URL(ogImagePath, SITE_META.siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmet İhtiyar",
  "url": SITE_META.siteUrl,
  "jobTitle": "Veritabanı & Depolama",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "İstanbul",
    "addressCountry": "TR"
  },
  "sameAs": [
    SITE_META.github,
    SITE_META.linkedin
  ],
  "knowsAbout": [
    "Database Architecture",
    "PostgreSQL Internals",
    "Oracle Database Optimization",
    "TimescaleDB & Hypertables",
    "Storage Engines & ZFS",
    "Zero-Impact Metadata Extraction",
    "Memgraph Schema Lineage",
    "Apache Arrow IPC",
    "Distributed Systems",
    "Query Performance Tuning"
  ]
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ahmet İhtiyar" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ahmet İhtiyar — Veritabanı Mimarisi Yazıları" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant FOUC prevention for light/dark theme -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] transition-colors">
    <a href="#main-content" class="skip-link">
      Ana içeriğe atla
    </a>

    <!-- Full-Width Shell: Topic Sidebar on the left + Expanded Main Column on the right -->
    <div class="min-h-screen flex flex-col lg:flex-row">
      <!-- Topic Tree Sidebar (Desktop sticky sidebar + Mobile responsive header) -->
      <Sidebar />

      <!-- Main Column: Fills the remaining screen with comfortable reading container -->
      <div class="flex-1 min-w-0 flex flex-col min-h-screen">
        <main id="main-content" class="flex-1 w-full max-w-4xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- Global Accessible Toast Notification -->
    <div id="global-toast" role="status" aria-live="polite">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span id="toast-message"></span>
    </div>

    <script is:inline>
      window.showToast = function(msg, duration = 2500) {
        const toast = document.getElementById('global-toast');
        const text = document.getElementById('toast-message');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.add('toast-show');
        if (window.__toastTimeout) clearTimeout(window.__toastTimeout);
        window.__toastTimeout = setTimeout(() => {
          toast.classList.remove('toast-show');
        }, duration);
      };

      // Automatic tactile copy button for article pre blocks
      (function() {
        function setupArticlePreCopy() {
          document.querySelectorAll('.prose pre').forEach((pre) => {
            if (pre.closest('.pre-copy-wrapper')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'relative group pre-copy-wrapper';
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'absolute top-2.5 right-2.5 px-2 py-0.5 rounded-[2px] bg-[var(--bg-card)]/90 border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] text-[11px] font-mono opacity-80 sm:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shadow-sm tactile-btn';
            const copyIconSvg = `<svg class="w-3 h-3 text-[var(--text-dim)] shrink-0 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
            btn.setAttribute('aria-label', 'Kodu kopyala');
            btn.innerHTML = `<span class="inline-flex items-center">${copyIconSvg}Kopyala</span>`;

            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btn.innerHTML = `<span class="text-[var(--status-green)] inline-flex items-center font-semibold">✓ Kopyalandı</span>`;
                if (typeof window.showToast === 'function') {
                  window.showToast('✓ Kod parçacığı panoya kopyalandı');
                }
                setTimeout(() => {
                  btn.innerHTML = `<span class="inline-flex items-center">${copyIconSvg}Kopyala</span>`;
                }, 2000);
              } catch (_) {
                prompt('Kod:', code);
              }
            });

            wrapper.appendChild(btn);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupArticlePreCopy);
        } else {
          setupArticlePreCopy();
        }
      })();
    </script>
  </body>
</html>
