---
import { ARCHIVE_ITEMS } from '../data/archive';
import BlueprintCrosshairs from './BlueprintCrosshairs.astro';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="archive" class="relative py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-20 sm:scroll-mt-24">
  <BlueprintCrosshairs bottom={true} />

  <!-- 12-Column Swiss Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
    <!-- Left 4 Columns: Sticky Section Header -->
    <div class="lg:col-span-4 space-y-4">
      <div class="lg:sticky lg:top-24 space-y-4">
        <!-- Section Number -->
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
            06 // {isTr ? 'ARŞİV' : 'HISTORICAL ARCHIVE'}
          </span>
          <span class="h-px w-6 bg-[var(--border-strong)]"></span>
        </div>

        <!-- Editorial Title -->
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
          {isTr ? 'Zaman Çizelgesi & Yarışmalar' : 'Historical Timeline & Challenges'}
        </h2>

        <!-- Index / Tag -->
        <div class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider leading-relaxed border-l border-[#E8590C] pl-2.5">
          {isTr ? 'YARIŞMALAR, ARAŞTIRMALAR & DÖNÜM NOKTALARI' : 'CHALLENGES, RESEARCH & MILESTONES'}
        </div>

        <!-- Short Description -->
        <p class="text-sm text-[var(--text-muted)] font-sans leading-relaxed">
          {isTr 
            ? "Datathonlar, robotik yarışmaları, açık kaynak katkıları ve geçmiş mühendislik deneyimlerinin kronolojik dökümü." 
            : "Chronological logbook of datathons, robotics challenges, open source explorations, and earlier engineering systems."}
        </p>
      </div>
    </div>

    <!-- Right 8 Columns: Spacious Technical Logbook Timeline -->
    <div class="lg:col-span-8">
      <div class="relative pl-6 sm:pl-8 border-l-2 border-[var(--border-strong)] space-y-6 sm:space-y-8 my-2 ml-2">
        {ARCHIVE_ITEMS.map((item) => (
          <div class="relative group p-3 -ml-3 rounded-none hover:bg-[var(--bg-subtle)] transition-colors">
            <!-- Bullet dot aligned with border line -->
            <span class="absolute -left-[19px] sm:-left-[27px] top-4 w-3 h-3 rounded-full bg-[var(--bg)] border-2 border-[var(--border-strong)] group-hover:border-[#E8590C] group-hover:bg-[#E8590C] transition-all shadow-xs" aria-hidden="true"></span>

            <div class="space-y-1.5">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-mono text-xs font-semibold text-[#E8590C]">
                  {item.year}
                </span>
                <span class="font-serif text-base sm:text-lg font-medium text-[var(--text)]">
                  {item.title[lang]}
                </span>
                <span class="font-mono text-[11px] text-[var(--text-dim)] px-1.5 py-0.5 bg-[var(--bg)] border border-[var(--border)] rounded-none">
                  {item.category[lang]}
                </span>
              </div>
              <p class="text-xs sm:text-[13px] text-[var(--text-muted)] font-sans leading-relaxed max-w-3xl">
                {item.description[lang]}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
