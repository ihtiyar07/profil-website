---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_META } from '../data/siteMeta';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'tr' | 'en';
  canonicalPath?: string;
  articleMeta?: {
    publishDate: string;
    tags: string[];
  };
}

const {
  lang = 'tr',
  title = SITE_META.title[lang],
  description = SITE_META.bioShort[lang],
  canonicalPath = '',
  articleMeta
} = Astro.props;

const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, SITE_META.siteUrl).toString();
const trUrl = new URL(Astro.url.pathname.replace(/^\/en/, '') || '/', SITE_META.siteUrl).toString();
const enUrl = new URL(Astro.url.pathname.startsWith('/en') ? Astro.url.pathname : `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`, SITE_META.siteUrl).toString();

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImagePath = cleanPath === '' 
  ? '/og/index.png' 
  : cleanPath === 'en' 
    ? '/og/en/index.png' 
    : `/og/${cleanPath}.png`;
const ogImageUrl = new URL(ogImagePath, SITE_META.siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmet İhtiyar",
  "url": SITE_META.siteUrl,
  "jobTitle": lang === 'tr' ? "Sistem ve Arka Uç Mühendisi" : "Systems & Backend Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Diverjans Bilgi Teknolojileri"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "İstanbul",
    "addressCountry": "TR"
  },
  "sameAs": [
    SITE_META.github,
    SITE_META.linkedin
  ],
  "knowsAbout": [
    "Industrial IoT",
    "Distributed Microservices",
    "ESP32 Firmware",
    "Modbus RTU/TCP",
    "RabbitMQ",
    "PostgreSQL",
    "TimescaleDB",
    "Apache Arrow",
    "Proxmox VE",
    "Keycloak IAM"
  ]
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- i18n hreflang -->
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={trUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ahmet İhtiyar" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ahmet İhtiyar — Yazılar" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant FOUC prevention for light/dark theme -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[#E8590C] selection:text-white">
    <a href="#main-content" class="skip-link">
      {lang === 'tr' ? 'Ana içeriğe atla (Skip to content)' : 'Skip to content'}
    </a>

    <Header lang={lang} />

    <main id="main-content" class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 md:px-8 py-6 sm:py-10">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
