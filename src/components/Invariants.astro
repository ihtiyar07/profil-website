---
import { INVARIANTS } from '../data/invariants';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="invariants" class="py-16 sm:py-24 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-4 mb-12 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
      {isTr ? 'Mimari İlkeler ve Değişmezler' : 'Architectural Invariants'}
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      {isTr 
        ? "Saha kısıtları ve donanım gerçeklikleriyle sınanmış mühendislik kuralları. Bir kuralın nasıl bozulacağı öngörülmeden ve üretimde test edilmeden hiçbir mimari karar alınmaz." 
        : "Rigid engineering rules forged under production stress and hardware limits. No architecture is established without defining its failure mode and production defense."}
    </p>
  </div>

  <!-- Invariants List -->
  <div class="space-y-12">
    {INVARIANTS.map((item) => (
      <article class="pt-8 border-t border-[var(--border)] space-y-5">
        <!-- Invariant Header -->
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-1">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-[var(--text-accent)] font-semibold">
              {item.badge}
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-medium text-[var(--text)]">
              {item.title[lang]}
            </h3>
          </div>
          <span class="font-mono text-[11px] text-[var(--status-green)] font-medium">
            ✓ {isTr ? 'Üretimde Doğrulandı' : 'Production Verified'}
          </span>
        </div>

        <!-- The Invariant Law -->
        <blockquote class="text-[15px] sm:text-base font-sans font-medium text-[var(--text)] leading-relaxed max-w-[75ch] italic pl-4 border-l border-[var(--text-accent)]">
          "{item.rule[lang]}"
        </blockquote>

        <!-- Two Columns: How It Breaks vs Engineering Defense (Open Editorial Flow) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm font-sans pt-2">
          <!-- Failure Mode -->
          <div class="space-y-2">
            <h4 class="font-mono text-xs font-semibold text-[var(--status-red)] uppercase tracking-wider flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-red)]" aria-hidden="true"></span>
              <span>{isTr ? 'Hata Modu (Nasıl Bozulur?)' : 'Failure Mode (How It Breaks)'}</span>
            </h4>
            <p class="text-[var(--text-muted)] leading-relaxed text-[13.5px]">
              {item.failureMode[lang]}
            </p>
          </div>

          <!-- Solution -->
          <div class="space-y-2">
            <h4 class="font-mono text-xs font-semibold text-[var(--text-accent)] uppercase tracking-wider flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--text-accent)]" aria-hidden="true"></span>
              <span>{isTr ? 'Mühendislik Savunması' : 'Engineering Defense'}</span>
            </h4>
            <p class="text-[var(--text)] leading-relaxed text-[13.5px]">
              {item.solution[lang]}
            </p>
          </div>
        </div>

        <!-- Verification Footnote -->
        <div class="text-xs font-mono text-[var(--text-dim)] pt-2 border-t border-[var(--border)] flex items-center gap-2">
          <span class="text-[var(--text-muted)] font-medium">{isTr ? 'Doğrulama Alanı:' : 'Verification Context:'}</span>
          <span>{item.verification[lang]}</span>
        </div>
      </article>
    ))}
  </div>
</section>
