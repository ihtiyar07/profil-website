---
// DataPageAnatomy.astro
// Systems Architecture Diagram: PostgreSQL 8KB Data Page & HeapTuple Physical Layout
// Calm Architectural Palette: Muted tones, crisp 1px borders, semantic alignment, high readability.
---

<figure class="data-page-container not-prose my-8 border border-[var(--border)] rounded-[2px] bg-[var(--bg-card)] overflow-hidden shadow-xs select-none" aria-label="PostgreSQL 8KB Data Page ve HeapTuple Fiziksel Bellek Düzeni">
  <!-- Top Bar -->
  <div class="px-4 py-2.5 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex items-center justify-between gap-3 text-xs font-mono text-[var(--text-dim)]">
    <span class="flex items-center gap-2 font-medium text-[var(--text)]">
      <span class="w-2 h-2 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span class="tracking-wide">POSTGRESQL 8KB DATA PAGE &amp; HEAPTUPLE ANATOMİSİ</span>
    </span>
    <span class="text-[12px] text-[var(--text-dim)] font-mono hidden sm:inline-block">8192 Bayt Sabit Disk Bloğu</span>
  </div>

  <div class="p-4 sm:p-6 space-y-7 text-[var(--text)]">
    
    <!-- ==================================================================== -->
    <!-- 1. 8KB DATA PAGE ORANTILI BELLEK ŞERİDİ                                -->
    <!-- ==================================================================== -->
    <div>
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)] mb-2">
        <span class="font-semibold uppercase tracking-wider text-[var(--text)] flex items-center gap-1.5">
          <span class="text-[var(--accent)] font-bold">1.</span>
          <span>8KB Data Page Fiziksel Bellek Şeridi</span>
        </span>
        <span class="text-[12px] text-[var(--text-dim)] font-mono">0B ──────────────► 8192B</span>
      </div>

      <!-- Scrollable Container for Mobile -->
      <div class="border border-[var(--border)] rounded-[2px] bg-[var(--bg)] p-3 overflow-x-auto">
        <div class="min-w-[620px]">
          
          <!-- Byte Boundary Labels & Pointers Above Tape -->
          <div class="flex items-end justify-between text-[12px] font-mono text-[var(--text-dim)] mb-1.5 px-0.5">
            <div class="w-[9%] text-left">
              <span class="font-semibold text-[var(--text)]">0B</span>
            </div>
            <div class="w-[18%] flex items-center justify-between pl-1">
              <span>24B</span>
              <span class="text-teal-700 dark:text-teal-300 font-semibold flex items-center gap-0.5" title="pd_lower: Line pointer dizisinin sonu">
                <span>pd_lower</span>
                <span class="text-xs">↓</span>
              </span>
            </div>
            <div class="w-[37%] text-center text-[var(--text-dim)] text-[12px] italic">
              Serbest Bellek Alanı
            </div>
            <div class="w-[36%] flex items-center justify-between pr-0.5">
              <span class="text-blue-700 dark:text-blue-300 font-semibold flex items-center gap-0.5" title="pd_upper: En son yazılan tuple başlangıcı">
                <span class="text-xs">↓</span>
                <span>pd_upper</span>
              </span>
              <span class="font-semibold text-[var(--text)]">8192B</span>
            </div>
          </div>

          <!-- The Physical Tape (Proportional Slices with Calm Semantic Colors) -->
          <div class="flex h-14 rounded-[2px] overflow-hidden border border-[var(--border-strong)] text-[12px] bg-[var(--bg-card)]">
            
            <!-- A. PageHeaderData (24B) ~9% -->
            <div 
              class="w-[9%] shrink-0 bg-slate-100 dark:bg-slate-800/50 border-r border-[var(--border)] flex flex-col items-center justify-center text-center p-1 text-[var(--text)]"
              title="PageHeaderData (24 Bayt): LSN, Checksum, Bayraklar, pd_lower, pd_upper, pd_special"
            >
              <span class="font-mono font-bold text-[12px] leading-tight truncate">Header</span>
              <span class="text-[11px] text-[var(--text-dim)] font-sans">24B</span>
            </div>

            <!-- B. Line Pointer Array (ItemIdData) ~18% -->
            <div 
              class="w-[18%] shrink-0 bg-[#F0FDF4] dark:bg-[#064E3B]/20 border-r-2 border-teal-500/70 dark:border-teal-400/70 p-1 flex items-center justify-between gap-1 text-[var(--text)]"
              title="Line Pointer Array (ItemIdData): 4 Bayt / satır. Sayfa başından aşağıya doğru büyür."
            >
              <div class="flex-1 bg-white dark:bg-slate-900 border border-teal-300 dark:border-teal-700/60 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs">
                <span class="font-mono font-bold text-[12px] text-teal-800 dark:text-teal-300">LP1</span>
                <span class="text-[10px] text-[var(--text-dim)] font-sans">4B</span>
              </div>
              <div class="flex-1 bg-white dark:bg-slate-900 border border-teal-300 dark:border-teal-700/60 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs">
                <span class="font-mono font-bold text-[12px] text-teal-800 dark:text-teal-300">LP2</span>
                <span class="text-[10px] text-[var(--text-dim)] font-sans">4B</span>
              </div>
              <div class="flex-1 bg-white dark:bg-slate-900 border border-teal-300 dark:border-teal-700/60 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs">
                <span class="font-mono font-bold text-[12px] text-teal-800 dark:text-teal-300">LP3</span>
                <span class="text-[10px] text-[var(--text-dim)] font-sans">4B</span>
              </div>
            </div>

            <!-- C. Free Space (Dynamic Gap) ~37% -->
            <div 
              class="w-[37%] bg-[var(--bg)] border-r-2 border-blue-500/70 dark:border-blue-400/70 flex flex-col items-center justify-center text-center px-2 relative"
              style="background-image: repeating-linear-gradient(45deg, transparent, transparent 7px, var(--border) 7px, var(--border) 8px);"
              title="Free Space: pd_lower ve pd_upper arasındaki dinamik serbest bellek alanı."
            >
              <div class="bg-[var(--bg-card)] px-2.5 py-0.5 rounded-[2px] border border-[var(--border)] shadow-2xs flex items-center gap-1.5 font-mono text-[12px] text-[var(--text-muted)]">
                <span class="text-teal-600 dark:text-teal-400 font-bold">→</span>
                <span class="font-semibold font-sans">Free Space</span>
                <span class="text-blue-600 dark:text-blue-400 font-bold">←</span>
              </div>
              <span class="text-[11.5px] text-[var(--text-dim)] font-sans mt-0.5">İki sınır birleştiğinde sayfa dolar</span>
            </div>

            <!-- D. Heap Tuples (Satırlar - Sağdan Sola Büyür) ~36% -->
            <div 
              class="w-[36%] shrink-0 bg-[#F0F7FF] dark:bg-[#1E3A8A]/15 p-1 flex items-center justify-between gap-1 text-[var(--text)]"
              title="Heap Tuples: Sayfa sonundan (8192) geriye doğru yazılır. T1 en sağdadır."
            >
              <div class="flex-1 bg-white dark:bg-slate-900 border border-blue-200 dark:border-blue-800/60 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs" title="Son Eklenen Satır (En Solda)">
                <span class="font-mono font-bold text-[12px] text-blue-900 dark:text-blue-300">Tuple 3</span>
                <span class="text-[10px] text-[var(--text-dim)] font-sans">En Son</span>
              </div>
              <div class="flex-1 bg-white dark:bg-slate-900 border border-blue-200 dark:border-blue-800/60 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs">
                <span class="font-mono font-bold text-[12px] text-blue-900 dark:text-blue-300">Tuple 2</span>
                <span class="text-[10px] text-[var(--text-dim)] font-sans">Satır</span>
              </div>
              <div id="diagram-tuple-1" class="flex-1 bg-blue-50 dark:bg-blue-950/60 border-2 border-blue-500 dark:border-blue-400 rounded-[2px] h-full flex flex-col items-center justify-center shadow-2xs ring-1 ring-blue-400/30" title="İlk Eklenen Satır (Sayfa Tabanında, En Sağda)">
                <span class="font-mono font-bold text-[12px] text-blue-950 dark:text-blue-200">Tuple 1</span>
                <span class="text-[10px] text-blue-700 dark:text-blue-300 font-sans font-medium">İlk Satır</span>
              </div>
            </div>

          </div>

          <!-- Bottom Growth Vectors & Indirect Pointer Arc -->
          <div class="flex items-center justify-between text-[12px] font-sans pt-2 px-1">
            <div class="text-teal-700 dark:text-teal-300 font-medium flex items-center gap-1">
              <span class="font-mono font-bold">▲ pd_lower:</span>
              <span>Soldan Sağa Büyür (Aşağı)</span>
            </div>

            <!-- In-tape Indirection Hint (LP1 -> Tuple 1) -->
            <div class="text-[12px] font-mono text-[var(--accent)] font-medium flex items-center gap-1.5 bg-[var(--bg-subtle)] px-2.5 py-1 rounded-[2px] border border-[var(--border)] whitespace-nowrap shadow-2xs">
              <span class="font-bold">LP1</span>
              <span>──── lp_off ────►</span>
              <span class="font-bold">Tuple 1</span>
            </div>

            <div class="text-blue-700 dark:text-blue-300 font-medium flex items-center gap-1">
              <span>Sağdan Sola Büyür (Yukarı)</span>
              <span class="font-mono font-bold">:pd_upper ▲</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ==================================================================== -->
    <!-- 2. İKİ AŞAMALI DOLAYLI ADRESLEME (TID AKIŞI)                          -->
    <!-- ==================================================================== -->
    <div class="border-t border-[var(--border)] pt-5">
      <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text)] mb-2 flex items-center gap-1.5">
        <span class="text-[var(--accent)] font-bold">2.</span>
        <span>İki Aşamalı Dolaylı Adresleme (TID Indirection Akışı)</span>
      </div>

      <!-- Single-Row Compact Pipeline (TID -> LinePointer -> HeapTuple) -->
      <div class="border border-[var(--border)] rounded-[2px] bg-[var(--bg)] p-3 overflow-x-auto">
        <div class="min-w-[540px]">
          
          <div class="flex items-center justify-between py-1">
            <!-- Pill 1: TID -->
            <div class="bg-[var(--bg-card)] border border-[var(--border-strong)] rounded-[2px] px-3 py-1.5 shadow-2xs flex items-center gap-2">
              <span class="w-5 h-5 rounded-[2px] bg-[var(--accent-subtle)] border border-[var(--accent-border)] text-[var(--accent)] font-bold font-mono text-[11px] flex items-center justify-center shrink-0">1</span>
              <span class="font-mono font-bold text-[13px] text-[var(--text)]">TID: (0, 1)</span>
            </div>

            <!-- Arrow 1 with label -->
            <div class="flex items-center gap-1.5 px-1.5 text-[var(--text-dim)]">
              <span class="text-[11.5px] font-sans font-medium text-[var(--text-muted)]">İndeks Araması</span>
              <span class="text-base leading-none text-[var(--accent)] font-bold">──►</span>
            </div>

            <!-- Pill 2: LinePointer[1] -->
            <div class="bg-[var(--bg-card)] border border-teal-400 dark:border-teal-600/70 rounded-[2px] px-3 py-1.5 shadow-2xs flex items-center gap-2">
              <span class="w-5 h-5 rounded-[2px] bg-[#F0FDF4] dark:bg-[#064E3B]/40 border border-teal-300 dark:border-teal-700 text-teal-800 dark:text-teal-200 font-bold font-mono text-[11px] flex items-center justify-center shrink-0">2</span>
              <span class="font-mono font-bold text-[13px] text-teal-800 dark:text-teal-300">LinePointer[1]</span>
              <span class="text-[11px] font-sans text-[var(--text-dim)]">(4B)</span>
            </div>

            <!-- Arrow 2 with label -->
            <div class="flex items-center gap-1.5 px-1.5 text-[var(--text-dim)]">
              <span class="text-[11.5px] font-mono font-medium text-teal-700 dark:text-teal-300">lp_off</span>
              <span class="text-base leading-none text-teal-600 dark:text-teal-400 font-bold">──►</span>
            </div>

            <!-- Pill 3: HeapTuple 1 -->
            <div class="bg-[var(--bg-card)] border border-blue-400 dark:border-blue-600/70 rounded-[2px] px-3 py-1.5 shadow-2xs flex items-center gap-2">
              <span class="w-5 h-5 rounded-[2px] bg-[#F0F7FF] dark:bg-[#1E3A8A]/40 border border-blue-300 dark:border-blue-700 text-blue-800 dark:text-blue-200 font-bold font-mono text-[11px] flex items-center justify-center shrink-0">3</span>
              <span class="font-mono font-bold text-[13px] text-blue-900 dark:text-blue-300">HeapTuple (T1)</span>
            </div>
          </div>

          <!-- Explanatory step sentence directly under the strip -->
          <div class="flex items-center justify-between text-[12px] text-[var(--text-dim)] font-sans pt-2 px-1 border-t border-[var(--border)] mt-2">
            <span>İndeksin işaret ettiği blok &amp; ofset</span>
            <span class="text-teal-700 dark:text-teal-300 font-medium">Sayfa içi bayt ofseti (lp_off)</span>
            <span>Diskteki fiziksel satır verisi</span>
          </div>

        </div>
      </div>

      <!-- Compact Technical Rationale Note Box -->
      <div class="mt-2.5 border-l-3 border-[var(--accent)] bg-[var(--accent-subtle)] p-3 rounded-r-[2px] text-[12.5px] leading-relaxed">
        <span class="font-semibold text-[var(--text)]">Neden Dolaylı Adresleme (Indirection)?</span>
        <span class="text-[var(--text-muted)]">
          B-Tree indeksler satırın bayt ofsetini değil, 4 baytlık Line Pointer indeksini saklar. <code>VACUUM</code> defragmentasyonu veya HOT (Heap-Only Tuple) güncellemesi satırı sayfa içinde kaydırdığında yalnızca line pointer'ın <code>lp_off</code> değeri güncellenir; devasa B-Tree indeks bloklarına tek bir bayt dahi kilit atılmaz.
        </span>
      </div>
    </div>

    <!-- ==================================================================== -->
    <!-- 3. HEAPTUPLE İÇ ANATOMİSİ (ZOOM HİSSİ & ORANTILI ALANLAR)             -->
    <!-- ==================================================================== -->
    <div class="border-t border-[var(--border)] pt-5">
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)] mb-2">
        <span class="font-semibold uppercase tracking-wider text-[var(--text)] flex items-center gap-1.5">
          <span class="text-[var(--accent)] font-bold">3.</span>
          <span>HeapTuple (Satır) İç Anatomisi (Tuple 1 İç Görünümü)</span>
        </span>
        <span class="text-[12px] text-[var(--text-dim)]">Zoom: Fiziksel Satır Yapısı</span>
      </div>

      <!-- Zoom Projection Indicator Lines -->
      <div class="w-full flex items-center justify-center text-[12px] font-mono text-[var(--text-dim)] mb-1">
        <span class="flex items-center gap-2">
          <span class="text-base font-bold text-[var(--border-strong)]">╲</span>
          <span class="px-2.5 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text)] font-sans font-medium text-[12px] shadow-2xs">
            Yukarıdaki Tuple 1 Satırının Büyütülmüş İç Anatomisi
          </span>
          <span class="text-base font-bold text-[var(--border-strong)]">╱</span>
        </span>
      </div>

      <!-- The Complete Tuple Tape Container -->
      <div class="border border-[var(--border)] rounded-[2px] bg-[var(--bg)] p-3 overflow-x-auto">
        <div class="min-w-[620px] space-y-3">
          
          <!-- Unified Tuple Tape: Header (23B) + Null Bitmap + User Data -->
          <div>
            <div class="text-[12px] font-sans font-medium text-[var(--text-dim)] mb-1 flex items-center justify-between px-0.5">
              <span>Toplam Satır Şeridi (HeapTuple Yapısı)</span>
              <span>Değişken Toplam Boyut</span>
            </div>

            <div class="flex h-12 rounded-[2px] overflow-hidden border border-[var(--border-strong)] text-[12px] bg-[var(--bg-card)]">
              
              <!-- 1. Header (23B) ~60% -->
              <div class="w-[62%] shrink-0 bg-slate-100/90 dark:bg-slate-800/50 border-r border-[var(--border)] flex items-center justify-between px-3 text-[var(--text)]">
                <span class="font-mono font-bold text-[13px]">HeapTupleHeaderData</span>
                <span class="text-[11.5px] font-sans bg-[var(--bg-card)] px-2 py-0.5 rounded-[2px] border border-[var(--border)] text-[var(--text-dim)] shadow-2xs">23 Bayt Sabit Başlık</span>
              </div>

              <!-- 2. Null Bitmap ~15% -->
              <div class="w-[15%] shrink-0 bg-[var(--bg-card)] border-r border-[var(--border)] flex flex-col items-center justify-center text-center p-1 text-[var(--text)]">
                <span class="font-mono font-bold text-[12px]">Null Bitmap</span>
                <span class="text-[11px] text-[var(--text-dim)] font-sans">1 bit / kolon</span>
              </div>

              <!-- 3. User Data ~23% -->
              <div class="w-[23%] shrink-0 bg-blue-50/70 dark:bg-blue-950/20 flex flex-col items-center justify-center text-center p-1 text-[var(--text)]">
                <span class="font-mono font-bold text-[12px] text-blue-900 dark:text-blue-300">User Data</span>
                <span class="text-[11px] text-[var(--text-dim)] font-sans">Kolon Değerleri (Payload)</span>
              </div>

            </div>
          </div>

          <!-- Header Breakdown: Proportional Fields by Byte Size -->
          <div class="bg-[var(--bg-card)] border border-[var(--border)] rounded-[2px] p-2.5">
            <div class="text-[12px] font-mono text-[var(--text-muted)] font-medium mb-1.5 flex items-center justify-between">
              <span>┌── HeapTupleHeaderData (23 Bayt) Alt Alanları (Bayt Genişliğine Göre Orantılı)</span>
              <span class="text-[var(--text-dim)]">23B Toplam</span>
            </div>

            <!-- Proportional 23B Header Strip: 4B (18%), 4B (18%), 4B (18%), 6B (27%), 4B (19%) -->
            <div class="flex h-16 rounded-[2px] overflow-hidden border border-[var(--border)] text-[12px] text-center bg-[var(--bg)]">
              
              <!-- t_xmin (4B) -->
              <div class="w-[18%] bg-[var(--bg-card)] border-r border-[var(--border)] p-1 flex flex-col justify-center" title="t_xmin (4 Bayt): Bu satırı ekleyen Transaction ID">
                <span class="font-mono font-bold text-[13px] text-[var(--text)]">t_xmin</span>
                <span class="text-[11px] font-sans text-[var(--text-dim)]">4 Bayt</span>
                <span class="text-[11.5px] font-sans text-[var(--text-muted)]">Ekleyen XID</span>
              </div>

              <!-- t_xmax (4B) -->
              <div class="w-[18%] bg-[var(--bg-card)] border-r border-[var(--border)] p-1 flex flex-col justify-center" title="t_xmax (4 Bayt): Bu satırı silen veya güncelleyen XID (Aktifse 0)">
                <span class="font-mono font-bold text-[13px] text-[var(--text)]">t_xmax</span>
                <span class="text-[11px] font-sans text-[var(--text-dim)]">4 Bayt</span>
                <span class="text-[11.5px] font-sans text-[var(--text-muted)]">Silen XID</span>
              </div>

              <!-- t_cid (4B) -->
              <div class="w-[18%] bg-[var(--bg-card)] border-r border-[var(--border)] p-1 flex flex-col justify-center" title="t_cid (4 Bayt): Transaction içi SQL komut sırası (Command ID)">
                <span class="font-mono font-bold text-[13px] text-[var(--text)]">t_cid</span>
                <span class="text-[11px] font-sans text-[var(--text-dim)]">4 Bayt</span>
                <span class="text-[11.5px] font-sans text-[var(--text-muted)]">Komut Sırası</span>
              </div>

              <!-- t_ctid (6B) - Visibly wider! (27%) -->
              <div class="w-[27%] bg-[var(--accent-subtle)] border-r border-[var(--accent-border)] p-1 flex flex-col justify-center ring-1 ring-inset ring-[var(--accent-border)]" title="t_ctid (6 Bayt): Satırın fiziksel TID'si (blok, ofset). Güncelleme yapıldıysa yeni versiyonun adresini işaret eder.">
                <span class="font-mono font-bold text-[13px] text-[var(--text-accent)]">t_ctid</span>
                <span class="text-[11px] font-sans text-[var(--text-accent)] font-medium">6 Bayt (Geniş)</span>
                <span class="text-[11.5px] font-sans text-[var(--text-muted)] font-medium truncate">Fiziksel / Zincir</span>
              </div>

              <!-- t_infomask (4B) ~19% -->
              <div class="w-[19%] bg-[var(--bg-card)] p-1 flex flex-col justify-center" title="t_infomask / t_infomask2: MVCC durum bayrakları (COMMITTED, UPDATED) ve kolon sayısı">
                <span class="font-mono font-bold text-[13px] text-[var(--text)] truncate">t_infomask</span>
                <span class="text-[11px] font-sans text-[var(--text-dim)]">4 Bayt</span>
                <span class="text-[11.5px] font-sans text-[var(--text-muted)]">Bayraklar</span>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</figure>
