---
import { INVARIANTS } from '../data/invariants';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="invariants" class="py-12 sm:py-16 border-b border-[var(--border)] scroll-mt-20 sm:scroll-mt-24">
  <!-- Section Title -->
  <div class="mb-10">
    <div class="flex items-center gap-2 mb-2">
      <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
        04 — {isTr ? 'Değişmezler' : 'Architectural Invariants'}
      </span>
      <span class="h-px w-8 bg-[var(--border)]"></span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-2">
      <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
        {isTr ? 'Mimari İlkeler ve Değişmez Kurallar' : 'Invariants & Failure Modes'}
      </h2>
      <p class="font-mono text-xs text-[var(--text-dim)]">
        {isTr ? 'Kural → Nasıl bozulur → Çözüm → Nerede doğruladım' : 'Rule → Failure mode → Mitigation → Verification'}
      </p>
    </div>
  </div>

  <!-- Invariants 4-Field Matrix with Tactile Cards -->
  <div class="space-y-6">
    {INVARIANTS.map((item, idx) => (
      <article class="border border-[var(--border)] bg-[var(--bg)] rounded-[3px] p-5 sm:p-6 space-y-4 hover:border-[var(--border-strong)] transition-all">
        <!-- Invariant Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[var(--border)]">
          <div class="flex items-center gap-2.5">
            <span class="font-mono text-[11px] font-semibold text-[#E8590C]">
              {item.badge}
            </span>
            <span class="text-[var(--text-dim)]" aria-hidden="true">·</span>
            <h3 class="font-serif text-lg sm:text-xl font-medium text-[var(--text)]">
              {item.title[lang]}
            </h3>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto">
            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-[#10B981]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              <span>{isTr ? 'KURAL: KORUNUYOR' : 'ENFORCED'}</span>
            </span>
          </div>
        </div>

        <!-- 4 Structured Fields (Clean Editorial Lines without Gray Boxes) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs font-sans pt-2">
          <!-- 1. Kural -->
          <div class="border-l-2 border-[#E8590C] pl-3.5 space-y-1.5">
            <div class="font-mono text-[11px] font-semibold text-[#E8590C] uppercase tracking-wider flex items-center gap-1.5">
              <span>■</span>
              <span>{isTr ? 'Kural' : 'Invariant Rule'}</span>
            </div>
            <p class="text-[var(--text)] leading-relaxed text-[13px] max-w-[65ch]">
              {item.rule[lang]}
            </p>
          </div>

          <!-- 2. Nasıl Bozulur -->
          <div class="border-l-2 border-[var(--border-strong)] pl-3.5 space-y-1.5">
            <div class="font-mono text-[11px] font-semibold text-[var(--text-dim)] uppercase tracking-wider flex items-center gap-1.5">
              <span>✕</span>
              <span>{isTr ? 'Nasıl Bozulur (Failure Mode)' : 'How It Breaks (Failure Mode)'}</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed text-[13px] max-w-[65ch]">
              {item.failureMode[lang]}
            </p>
          </div>

          <!-- 3. Çözüm -->
          <div class="border-l-2 border-[#E8590C] pl-3.5 space-y-1.5">
            <div class="font-mono text-[11px] font-semibold text-[var(--text)] uppercase tracking-wider flex items-center gap-1.5">
              <span>▸</span>
              <span>{isTr ? 'Mühendislik Çözümü' : 'Engineering Solution'}</span>
            </div>
            <p class="text-[var(--text)] leading-relaxed text-[13px] max-w-[65ch]">
              {item.solution[lang]}
            </p>
          </div>

          <!-- 4. Nerede Doğruladım -->
          <div class="border-l-2 border-[var(--border-strong)] pl-3.5 space-y-1.5">
            <div class="font-mono text-[11px] font-semibold text-[var(--text-dim)] uppercase tracking-wider flex items-center gap-1.5">
              <span>▲</span>
              <span>{isTr ? 'Nerede Doğruladım' : 'Production Verification'}</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed text-[13px] max-w-[65ch]">
              {item.verification[lang]}
            </p>
          </div>
        </div>

        <!-- Invariant Footer Action -->
        <div class="pt-2 flex justify-between items-center text-xs font-mono border-t border-[var(--border)]">
          <span class="text-[10px] text-[var(--text-dim)]">
            {isTr ? 'Hata Modu Güvencesi' : 'Failure Mode Assurance'}
          </span>
          <button
            type="button"
            class="copy-invariant-btn text-[var(--text-muted)] hover:text-[#E8590C] inline-flex items-center gap-1.5 text-[11px] cursor-pointer tactile-btn px-2 py-1 rounded-[2px] bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C]"
            data-rule={`${item.badge}: ${item.rule[lang]}`}
          >
            <svg class="w-3 h-3 text-[var(--text-dim)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-inv-label">{isTr ? 'Kuralı Kopyala' : 'Copy Invariant'}</span>
          </button>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (function() {
    document.querySelectorAll('.copy-invariant-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-rule') || '';
        const label = btn.querySelector('.copy-inv-label');
        const isTr = document.documentElement.lang === 'tr';
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = isTr ? '✓ Kopyalandı!' : '✓ Copied!';
          if (typeof window.showToast === 'function') {
            window.showToast(isTr ? '✓ Değişmez kural panoya kopyalandı' : '✓ Invariant rule copied to clipboard');
          }
          setTimeout(() => {
            if (label) label.textContent = isTr ? 'Kuralı Kopyala' : 'Copy Invariant';
          }, 2000);
        } catch (_) {
          prompt('Kural:', text);
        }
      });
    });
  })();
</script>
