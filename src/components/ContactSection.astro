---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="contact" class="py-16 sm:py-24 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-4 mb-12 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
      {isTr ? 'İletişim ve Temas' : 'Direct Channels'}
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      {isTr 
        ? "Form duvarı yok. Dağıtık mimariler, telemetri hatları ve veritabanı optimizasyonu üzerine doğrudan mühendislik teması." 
        : "No form walls. Direct engineering channels for distributed architectures, telemetry pipelines, and database optimization discussions."}
    </p>
  </div>

  <!-- Direct Channels Grid (Open, Airy, No Boxiness) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-2">
    <!-- Email Channel -->
    <div class="space-y-3 pb-6 md:pb-0 border-b md:border-b-0 md:border-r border-[var(--border)] md:pr-8">
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-dim)]">
        <span class="uppercase tracking-wider font-semibold text-[var(--text-accent)]">{isTr ? 'E-posta' : 'Email'}</span>
        <button
          type="button"
          id="copy-contact-email-btn"
          class="px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer text-[11px] tactile-btn inline-flex items-center gap-1"
          aria-label={isTr ? "E-postayı kopyala" : "Copy email address"}
        >
          <svg class="w-3 h-3 text-[var(--text-dim)] shrink-0 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-email-label">{isTr ? 'Kopyala' : 'Copy'}</span>
        </button>
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)] truncate" title={SITE_META.email}>
        {SITE_META.email}
      </div>

      <div>
        <a
          href={`mailto:${SITE_META.email}`}
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>{isTr ? 'Doğrudan Mesaj Gönder' : 'Send Direct Message'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- GitHub Channel -->
    <div class="space-y-3 pb-6 md:pb-0 border-b md:border-b-0 md:border-r border-[var(--border)] md:pr-8">
      <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        GitHub
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)]">
        github.com/ihtiyar07
      </div>

      <div>
        <a
          href={SITE_META.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>{isTr ? 'Açık Kaynak Depolar' : 'Inspect Repositories'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- LinkedIn Channel -->
    <div class="space-y-3">
      <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        LinkedIn
      </div>

      <div class="font-mono text-sm sm:text-base font-medium text-[var(--text)]">
        in/ahmet-ihtiyar
      </div>

      <div>
        <a
          href={SITE_META.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>{isTr ? 'Profili Görüntüle' : 'View LinkedIn Profile'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Availability Note -->
  <div class="mt-12 pt-6 border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-mono text-[var(--text-dim)]">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)]"></span>
      <span class="text-[var(--text)] font-medium">
        {isTr ? 'Teknik Değerlendirme & Danışmanlık:' : 'Technical Inquiries & Advisory:'}
      </span>
      <span>
        {isTr ? 'Dağıtık telemetri hatları, IoT geçitleri, zaman serisi optimizasyonu' : 'Distributed telemetry, IoT gateways, time-series optimization'}
      </span>
    </div>
  </div>
</section>

<!-- Email Copy Script -->
<script is:inline>
  (function() {
    const copyBtn = document.getElementById('copy-contact-email-btn');
    if (!copyBtn) return;
    copyBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const email = 'ahmetihtiyar1453@gmail.com';
      const label = copyBtn.querySelector('.copy-email-label');
      const isTr = document.documentElement.lang === 'tr';
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = isTr ? '✓ Kopyalandı' : '✓ Copied';
        if (typeof window.showToast === 'function') {
          window.showToast(isTr ? '✓ E-posta panoya kopyalandı' : '✓ Email copied to clipboard');
        }
        setTimeout(() => {
          if (label) label.textContent = isTr ? 'Kopyala' : 'Copy';
        }, 2000);
      } catch (_) {
        prompt('E-posta:', email);
      }
    });
  })();
</script>
