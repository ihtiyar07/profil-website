---
import { SECONDARY_PROJECTS } from '../data/secondaryProjects';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="secondary-projects" class="py-16 sm:py-24 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-4 mb-10 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
      {isTr ? 'Sistem Kayıt Defteri' : 'System Registry'}
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      {isTr 
        ? "Üretim ortamlarında bizzat kurduğum, idame ettiğim ve otomatize ettiğim operasyonel sistemler, hipervizör kümeleri ve kurumsal altyapılar." 
        : "Operational systems, bare-metal hypervisor clusters, and enterprise infrastructure architected and maintained across production environments."}
    </p>
  </div>

  <!-- Full-Width Registry Ledger -->
  <div class="border-t border-[var(--border)] divide-y divide-[var(--border)]">
    {SECONDARY_PROJECTS.map((project, idx) => (
      <div class="py-6 group flex flex-col md:flex-row md:items-baseline justify-between gap-4 hover:bg-[var(--bg-subtle)]/50 transition-colors px-2 -mx-2 rounded-[2px]">
        <!-- Left: ID & Name & Scope -->
        <div class="flex-1 space-y-2">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-[var(--text-accent)] font-semibold">
              SYS-{String(idx + 1).padStart(2, '0')}
            </span>
            <h3 class="font-sans text-base sm:text-lg font-semibold text-[var(--text)] group-hover:text-[var(--text-accent)] transition-colors">
              {project.name}
            </h3>
          </div>

          <p class="text-sm text-[var(--text-muted)] font-sans leading-relaxed max-w-[72ch]">
            {project.whatItDid[lang]}
          </p>

          <div class="font-mono text-xs text-[var(--text-dim)] pt-1 flex flex-wrap gap-x-2 gap-y-1">
            <span class="text-[var(--text-muted)] font-medium">Stack:</span>
            <span>{project.stack.split(',').map((item) => item.trim()).join(' · ')}</span>
          </div>
        </div>

        <!-- Right: Year & Scope Badge -->
        <div class="font-mono text-xs text-[var(--text-dim)] shrink-0 self-start md:self-auto">
          <span>{typeof project.year === 'string' ? project.year : project.year[lang]}</span>
        </div>
      </div>
    ))}
  </div>
</section>
