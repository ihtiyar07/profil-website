---
import { SECONDARY_PROJECTS } from '../data/secondaryProjects';
---

<section id="secondary-projects" class="py-10 sm:py-14 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-1.5 mb-6 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      Diğer Çalışmalar & Sistemler
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Daha önce geliştirdiğim veya yönetimini üstlendiğim sistemler, ERP entegrasyonları ve altyapılar.
    </p>
  </div>

  <!-- Responsive 2-Column Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {SECONDARY_PROJECTS.map((project, idx) => (
      <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/30 hover:bg-[var(--bg-subtle)]/70 hover:border-[var(--border-strong)] transition-all p-5 rounded-[2px] flex flex-col justify-between space-y-3">
        <div class="space-y-2">
          <div class="flex items-center justify-between font-mono text-xs">
            <span class="text-[var(--text-accent)] font-semibold">{String(idx + 1).padStart(2, '0')}</span>
            <span class="text-[var(--text-dim)]">{project.year}</span>
          </div>

          <h3 class="font-sans text-base font-semibold text-[var(--text)] transition-colors">
            {project.name}
          </h3>

          <p class="text-xs sm:text-sm text-[var(--text-muted)] font-sans leading-relaxed">
            {project.whatItDid}
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--border)]/60 font-mono text-[11px] text-[var(--text-dim)]">
          {project.stack.split(',').map((item) => item.trim()).join(' · ')}
        </div>
      </div>
    ))}
  </div>
</section>
