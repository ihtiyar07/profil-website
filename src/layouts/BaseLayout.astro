---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE_META } from '../data/siteMeta';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  articleMeta?: {
    publishDate: string;
    tags: string[];
  };
  fullWidth?: boolean;
}

const {
  title = SITE_META.title,
  description = SITE_META.bioShort,
  canonicalPath = '',
  articleMeta,
  fullWidth = false
} = Astro.props;

const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, SITE_META.siteUrl).toString();

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImagePath = cleanPath === '' 
  ? '/og/index.png' 
  : `/og/${cleanPath}.png`;
const ogImageUrl = new URL(ogImagePath, SITE_META.siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmet İhtiyar",
  "url": SITE_META.siteUrl,
  "jobTitle": "Veritabanı & Depolama",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "İstanbul",
    "addressCountry": "TR"
  },
  "sameAs": [
    SITE_META.github,
    SITE_META.linkedin
  ],
  "knowsAbout": [
    "Database Architecture",
    "PostgreSQL Internals",
    "Oracle Database Optimization",
    "TimescaleDB & Hypertables",
    "Storage Engines & ZFS",
    "Zero-Impact Metadata Extraction",
    "Memgraph Schema Lineage",
    "Apache Arrow IPC",
    "Distributed Systems",
    "Query Performance Tuning"
  ]
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ahmet İhtiyar" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ahmet İhtiyar — Veritabanı Mimarisi Yazıları" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant FOUC prevention for light/dark theme -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] transition-colors">
    <a href="#main-content" class="skip-link">
      Ana içeriğe atla
    </a>

    <!-- Full-Width Shell: Topic Sidebar on the left + Expanded Main Column on the right -->
    <div class="min-h-screen flex flex-col md:flex-row">
      <!-- Topic Tree Sidebar (Desktop sticky sidebar + Mobile responsive header) -->
      <Sidebar />

      <!-- Main Column: Fills the remaining screen with generous width, eliminating empty space -->
      <div class="flex-1 min-w-0 flex flex-col min-h-screen">
        <main id="main-content" class:list={[
          "flex-1 w-full",
          fullWidth ? "flex flex-col" : "max-w-[1140px] w-full mx-auto px-5 sm:px-8 lg:px-10 py-6 sm:py-10"
        ]}>
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- Global Fullscreen Code Modal -->
    <div 
      id="code-fullscreen-modal" 
      class="fixed inset-0 z-[100] bg-black/85 backdrop-blur-md hidden flex-col p-3 sm:p-6 transition-all duration-200"
      role="dialog"
      aria-modal="true"
      aria-label="Kod ve Betik Tam Ekran Modalı"
    >
      <div class="w-full max-w-6xl mx-auto h-full flex flex-col bg-[#0d1117] border border-[#30363d] rounded-[3px] shadow-2xl overflow-hidden">
        <!-- Modal Header -->
        <div class="px-4 py-3 border-b border-[#30363d] bg-[#161b22] flex items-center justify-between gap-3 text-xs font-mono text-[#c9d1d9] select-none">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <span class="font-semibold text-white uppercase tracking-wider text-[11px]" id="code-modal-lang">KOD & BETİK İNCELEME</span>
          </div>

          <div class="flex items-center gap-2">
            <!-- Wrap Toggle Button -->
            <button
              type="button"
              id="code-modal-wrap-btn"
              class="px-2.5 py-1 rounded-[2px] bg-[#21262d] border border-[#30363d] text-[#c9d1d9] hover:text-white hover:border-[#8b949e] transition-colors cursor-pointer text-[11px] flex items-center gap-1.5"
            >
              <span>Satır Kaydır:</span>
              <span id="code-modal-wrap-state" class="text-[var(--accent)] font-semibold">Kapalı</span>
            </button>

            <!-- Copy Button -->
            <button
              type="button"
              id="code-modal-copy-btn"
              class="px-2.5 py-1 rounded-[2px] bg-[#21262d] border border-[#30363d] text-[#c9d1d9] hover:text-white hover:border-[#8b949e] transition-colors cursor-pointer text-[11px] flex items-center gap-1.5"
            >
              <span>Kopyala</span>
            </button>

            <!-- Close Button -->
            <button
              type="button"
              id="code-modal-close-btn"
              class="px-2.5 py-1 rounded-[2px] bg-[#da3633]/20 hover:bg-[#da3633]/40 border border-[#f85149]/40 text-[#f85149] hover:text-white transition-colors cursor-pointer text-[11px] flex items-center gap-1 font-semibold"
              aria-label="Kapat (Escape)"
            >
              <span>✕ Kapat</span>
              <span class="text-[10px] opacity-75 hidden sm:inline">(Esc)</span>
            </button>
          </div>
        </div>

        <!-- Modal Code Viewport -->
        <div class="flex-1 overflow-auto p-4 sm:p-6 bg-[#0d1117]">
          <pre id="code-modal-pre" class="font-mono text-[13px] sm:text-[14px] leading-[1.75] text-[#e6edf3] select-text outline-none whitespace-pre"></pre>
        </div>
      </div>
    </div>

    <!-- Global Accessible Toast Notification -->
    <div id="global-toast" role="status" aria-live="polite">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span id="toast-message"></span>
    </div>

    <script is:inline>
      window.showToast = function(msg, duration = 2500) {
        const toast = document.getElementById('global-toast');
        const text = document.getElementById('toast-message');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.add('toast-show');
        if (window.__toastTimeout) clearTimeout(window.__toastTimeout);
        window.__toastTimeout = setTimeout(() => {
          toast.classList.remove('toast-show');
        }, duration);
      };

      // Universal clean copy + fullscreen modal for all article code blocks
      (function() {
        const codeModal = document.getElementById('code-fullscreen-modal');
        const codeModalPre = document.getElementById('code-modal-pre');
        const codeModalLang = document.getElementById('code-modal-lang');
        const codeModalCloseBtn = document.getElementById('code-modal-close-btn');
        const codeModalWrapBtn = document.getElementById('code-modal-wrap-btn');
        const codeModalWrapState = document.getElementById('code-modal-wrap-state');
        const codeModalCopyBtn = document.getElementById('code-modal-copy-btn');
        let currentModalRawCode = '';
        let isWrapped = false;

        function closeCodeModal() {
          if (!codeModal) return;
          codeModal.classList.add('hidden');
          codeModal.classList.remove('flex');
          document.body.style.overflow = '';
        }

        function openCodeModal(pre) {
          if (!codeModal || !codeModalPre) return;
          const codeEl = pre.querySelector('code');
          const rawCode = codeEl ? codeEl.innerText : pre.innerText;
          currentModalRawCode = rawCode;

          // Determine language from class like language-sql or language-bash
          let lang = 'KOD';
          const langMatch = (codeEl?.className || pre.className).match(/language-([a-zA-Z0-9_-]+)/);
          if (langMatch && langMatch[1]) {
            lang = langMatch[1].toUpperCase();
          }
          if (codeModalLang) codeModalLang.textContent = `${lang} · TAM EKRAN İNCELEME`;

          // Clone syntax-highlighted HTML or text
          if (codeEl) {
            codeModalPre.innerHTML = codeEl.innerHTML;
          } else {
            codeModalPre.textContent = rawCode;
          }

          codeModal.classList.remove('hidden');
          codeModal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        if (codeModalCloseBtn) {
          codeModalCloseBtn.addEventListener('click', closeCodeModal);
        }

        if (codeModal) {
          codeModal.addEventListener('click', (e) => {
            if (e.target === codeModal) closeCodeModal();
          });
        }

        if (codeModalWrapBtn) {
          codeModalWrapBtn.addEventListener('click', () => {
            isWrapped = !isWrapped;
            if (codeModalPre) {
              if (isWrapped) {
                codeModalPre.classList.remove('whitespace-pre');
                codeModalPre.classList.add('whitespace-pre-wrap');
                if (codeModalWrapState) codeModalWrapState.textContent = 'Açık';
              } else {
                codeModalPre.classList.remove('whitespace-pre-wrap');
                codeModalPre.classList.add('whitespace-pre');
                if (codeModalWrapState) codeModalWrapState.textContent = 'Kapalı';
              }
            }
          });
        }

        if (codeModalCopyBtn) {
          codeModalCopyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(currentModalRawCode);
              codeModalCopyBtn.textContent = 'Kopyalandı ✓';
              codeModalCopyBtn.classList.add('text-[var(--status-green)]', 'border-[var(--status-green)]');
              if (typeof window.showToast === 'function') {
                window.showToast('Kod panoya kopyalandı');
              }
              setTimeout(() => {
                codeModalCopyBtn.textContent = 'Kopyala';
                codeModalCopyBtn.classList.remove('text-[var(--status-green)]', 'border-[var(--status-green)]');
              }, 2000);
            } catch (_) {
              prompt('Kod:', currentModalRawCode);
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && codeModal && !codeModal.classList.contains('hidden')) {
            closeCodeModal();
          }
        });

        function setupArticlePreCopy() {
          document.querySelectorAll('.prose pre, article pre').forEach((pre) => {
            if (pre.closest('.pre-copy-wrapper') || pre.closest('[data-no-auto-copy]') || pre.id === 'code-modal-pre') return;

            const wrapper = document.createElement('div');
            wrapper.className = 'relative group pre-copy-wrapper';
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            // Reserve room on top-right so long code lines never collide with the toolbar
            pre.style.paddingRight = '9.5rem';

            // Toolbar Container
            const toolbar = document.createElement('div');
            toolbar.className = 'absolute top-2.5 right-2.5 flex items-center gap-1.5 z-10 select-none';

            // 1. Expand / Fullscreen Button
            const btnExpand = document.createElement('button');
            btnExpand.type = 'button';
            btnExpand.className = 'code-expand-btn px-2 py-1 rounded-[2px] bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-white hover:border-[#8b949e] text-[11px] font-mono cursor-pointer shadow-xs tactile-btn transition-colors flex items-center gap-1';
            btnExpand.setAttribute('aria-label', 'Kodu tam ekran büyüt');
            btnExpand.setAttribute('title', 'Tam Ekran Büyüt');
            btnExpand.innerHTML = '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg><span>Büyüt</span>';

            btnExpand.addEventListener('click', () => {
              openCodeModal(pre);
            });

            // 2. Copy Button
            const btnCopy = document.createElement('button');
            btnCopy.type = 'button';
            btnCopy.className = 'px-2.5 py-1 rounded-[2px] bg-[#161b22] border border-[#30363d] text-[#c9d1d9] hover:text-white hover:border-[#8b949e] text-[11px] font-mono cursor-pointer shadow-xs tactile-btn transition-colors';
            btnCopy.setAttribute('aria-label', 'Kodu kopyala');
            btnCopy.textContent = 'Kopyala';

            btnCopy.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btnCopy.textContent = 'Kopyalandı';
                btnCopy.classList.add('text-[var(--status-green)]', 'border-[var(--status-green)]');
                if (typeof window.showToast === 'function') {
                  window.showToast('Kod panoya kopyalandı');
                }
                setTimeout(() => {
                  btnCopy.textContent = 'Kopyala';
                  btnCopy.classList.remove('text-[var(--status-green)]', 'border-[var(--status-green)]');
                }, 2000);
              } catch (_) {
                prompt('Kod:', code);
              }
            });

            toolbar.appendChild(btnExpand);
            toolbar.appendChild(btnCopy);
            wrapper.appendChild(toolbar);
          });
        }

        function setupResponsiveTables() {
          document.querySelectorAll('.prose table, article table').forEach((table) => {
            if (table.closest('.table-responsive-wrapper')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          });
        }

        function initArticleEnhancements() {
          setupArticlePreCopy();
          setupResponsiveTables();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initArticleEnhancements);
        } else {
          initArticleEnhancements();
        }
      })();
    </script>
  </body>
</html>
