---
import { SECONDARY_PROJECTS } from '../data/secondaryProjects';
---

<section id="secondary-projects" class="py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-2 mb-10 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      Diğer Çalışmalar & Sistemler
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Daha önce geliştirdiğim veya yönetimini üstlendiğim sistemler, ERP entegrasyonları ve altyapılar.
    </p>
  </div>

  <!-- Full-Width Registry Ledger -->
  <div class="border-t border-[var(--border)] divide-y divide-[var(--border)]">
    {SECONDARY_PROJECTS.map((project, idx) => (
      <div class="py-5 sm:py-6 group flex flex-col md:flex-row md:items-baseline justify-between gap-4 hover:bg-[var(--bg-subtle)]/40 transition-colors px-2 -mx-2 rounded-[2px]">
        <!-- Left: Name & Scope -->
        <div class="flex-1 space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-[var(--text-accent)] font-semibold">
              {String(idx + 1).padStart(2, '0')}
            </span>
            <h3 class="font-sans text-base font-semibold text-[var(--text)] group-hover:text-[var(--text-accent)] transition-colors">
              {project.name}
            </h3>
          </div>

          <p class="text-sm sm:text-[15px] text-[var(--text-muted)] font-sans leading-relaxed max-w-[85ch]">
            {project.whatItDid}
          </p>

          <div class="font-mono text-[11px] text-[var(--text-dim)] pt-0.5 flex flex-wrap gap-x-2 gap-y-1">
            <span>{project.stack.split(',').map((item) => item.trim()).join(' · ')}</span>
          </div>
        </div>

        <!-- Right: Year -->
        <div class="font-mono text-xs text-[var(--text-dim)] shrink-0 self-start md:self-auto">
          <span>{project.year}</span>
        </div>
      </div>
    ))}
  </div>
</section>
