---
import { PIPELINE_STOPS, INFRASTRUCTURE_STRIP } from '../data/pipelineStops';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="pipeline" class="py-12 sm:py-16 border-b border-[var(--border)] scroll-mt-20 sm:scroll-mt-24">
  <!-- Section Title -->
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
        01 — {isTr ? 'Omurga Mimarisi' : 'Backbone Architecture'}
      </span>
      <span class="h-px w-8 bg-[var(--border)]"></span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-2">
      <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
        {isTr ? 'Verinin Yolu' : 'The Path of Data'}
      </h2>
      <p class="font-mono text-xs text-[var(--text-dim)]">
        {isTr ? 'Cihaz → Aktarım → Kuyruk → Depolama → Teslimat → Güven' : 'Device → Transport → Queue → Storage → Delivery → Trust'}
      </p>
    </div>
  </div>

  <!-- The Pipeline Stage (Large SVG / HTML Flow) -->
  <div class="relative bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[3px] p-4 sm:p-6 mb-6">
    <!-- Telemetry Ping Simulator Control Strip -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 p-3 bg-[var(--bg)] border border-[var(--border)] rounded-[2px]">
      <div class="flex items-center gap-3">
        <button
          id="telemetry-ping-btn"
          type="button"
          class="px-3 py-1.5 bg-[#E8590C] hover:bg-[#CF4E08] text-white text-xs font-mono font-medium rounded-[2px] inline-flex items-center gap-2 cursor-pointer tactile-btn shadow-sm"
          title={isTr ? "6 istasyon boyunca telemetri paket akışını simüle et (Kısayol: P veya Boşluk)" : "Simulate telemetry stream across all 6 stations (Shortcut: P or Space)"}
          aria-label={isTr ? "Telemetri ping simülasyonunu başlat" : "Fire telemetry ping simulation"}
        >
          <span class="w-2 h-2 rounded-full bg-white animate-pulse" aria-hidden="true"></span>
          <span id="ping-btn-label">{isTr ? 'Telemetri Pingi Ateşle' : 'Fire Telemetry Ping'}</span>
          <kbd class="kbd-key text-[9px] px-1 py-0 bg-black/20 border-white/20 text-white hidden sm:inline-flex">P</kbd>
        </button>
        <div class="hidden sm:flex items-center gap-1.5 font-mono text-[11px] text-[var(--text-dim)]">
          <span>{isTr ? 'Kısayol:' : 'Shortcut:'}</span>
          <kbd class="kbd-key">1–6</kbd>
          <span>{isTr ? 'ile durak seç' : 'select stop'}</span>
        </div>
      </div>

      <!-- Telemetry Live Monitor Feed Ticker -->
      <div class="flex items-center gap-2 font-mono text-xs overflow-hidden max-w-full">
        <span class="led-status led-green shrink-0" id="pipeline-status-led" aria-hidden="true"></span>
        <div class="truncate text-[11px]" id="pipeline-telemetry-feed">
          <span class="text-[var(--text-dim)]">[MONITOR]:</span>
          <span class="text-[var(--text-muted)]" id="telemetry-log-text">
            {isTr ? 'Hattaki tüm istasyonlar senkronize · Hazır' : 'All stations synchronized · Ready for ingestion'}
          </span>
        </div>
      </div>
    </div>

    <!-- Desktop Flow Schematic (Visible SVG Track + Animated Packet) -->
    <div class="hidden md:block relative mb-5">
      <!-- Continuous Schematic SVG Track with Track Illumination -->
      <div class="relative h-10 w-full mb-2">
        <svg class="w-full h-full" viewBox="0 0 1000 40" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <!-- Main Bus Line (Base) -->
          <line x1="40" y1="20" x2="960" y2="20" stroke="var(--border-strong)" stroke-width="2" />
          
          <!-- Illuminated Segment Overlays -->
          <line id="track-seg-0" x1="83" y1="20" x2="250" y2="20" stroke="#E8590C" stroke-width="2.5" opacity="0.35" class="transition-opacity duration-300" />
          <line id="track-seg-1" x1="250" y1="20" x2="417" y2="20" stroke="#E8590C" stroke-width="2.5" opacity="0.2" class="transition-opacity duration-300" />
          <line id="track-seg-2" x1="417" y1="20" x2="583" y2="20" stroke="#E8590C" stroke-width="2.5" opacity="0.2" class="transition-opacity duration-300" />
          <line id="track-seg-3" x1="583" y1="20" x2="750" y2="20" stroke="#E8590C" stroke-width="2.5" opacity="0.2" class="transition-opacity duration-300" />
          <line id="track-seg-4" x1="750" y1="20" x2="917" y2="20" stroke="#E8590C" stroke-width="2.5" opacity="0.2" class="transition-opacity duration-300" />

          <!-- Directional Arrows between nodes -->
          <path d="M190 16 L200 20 L190 24" stroke="var(--border-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M350 16 L360 20 L350 24" stroke="var(--border-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M510 16 L520 20 L510 24" stroke="var(--border-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M670 16 L680 20 L670 24" stroke="var(--border-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M830 16 L840 20 L830 24" stroke="var(--border-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Station Nodes on track (Interactive) -->
          <circle cx="83" cy="20" r="6" fill="#E8590C" stroke="#E8590C" stroke-width="2" class="svg-node svg-node-0 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-0" role="button" aria-label="01 Edge / ESP32" />
          <circle cx="250" cy="20" r="5" fill="var(--bg)" stroke="var(--border-strong)" stroke-width="2" class="svg-node svg-node-1 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-1" role="button" aria-label="02 Transport / MQTT" />
          <circle cx="417" cy="20" r="5" fill="var(--bg)" stroke="var(--border-strong)" stroke-width="2" class="svg-node svg-node-2 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-2" role="button" aria-label="03 Queue / RabbitMQ" />
          <circle cx="583" cy="20" r="5" fill="var(--bg)" stroke="var(--border-strong)" stroke-width="2" class="svg-node svg-node-3 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-3" role="button" aria-label="04 Storage / TimescaleDB" />
          <circle cx="750" cy="20" r="5" fill="var(--bg)" stroke="var(--border-strong)" stroke-width="2" class="svg-node svg-node-4 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-4" role="button" aria-label="05 Delivery / Apache Arrow" />
          <circle cx="917" cy="20" r="5" fill="var(--bg)" stroke="var(--border-strong)" stroke-width="2" class="svg-node svg-node-5 transition-all duration-200 cursor-pointer hover:r-[7px]" id="svg-node-5" role="button" aria-label="06 Trust / X.509" />

          <!-- Shockwave Indicator Rings for Ping Simulation -->
          <circle cx="83" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-0" />
          <circle cx="250" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-1" />
          <circle cx="417" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-2" />
          <circle cx="583" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-3" />
          <circle cx="750" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-4" />
          <circle cx="917" cy="20" r="5" fill="none" stroke="#E8590C" stroke-width="2" class="ping-ring-marker hidden" id="ping-ring-5" />

          <!-- Dedicated Glowing Ping Packet -->
          <circle id="svg-ping-packet" cx="83" cy="20" r="5.5" fill="#E8590C" stroke="#FFFFFF" stroke-width="1.5" class="opacity-0 pointer-events-none transition-all duration-150" />
        </svg>

        <!-- Ambient Traveling Packet (Desktop) -->
        <div class="pipeline-packet-desktop w-2.5 h-2.5 bg-[#E8590C] rounded-full pointer-events-none" aria-hidden="true" title="Veri Paketi" id="pipeline-ambient-packet"></div>
      </div>

      <!-- 6 Interactive Horizontal Station Cards with Keyboard Hints -->
      <div class="relative z-10 grid grid-cols-6 gap-2" role="tablist" aria-label={isTr ? "Veri Hattı Durakları" : "Data Pipeline Stops"}>
        {PIPELINE_STOPS.map((stop, idx) => (
          <button
            type="button"
            role="tab"
            class="pipeline-stop-btn group text-left p-2.5 rounded-[2px] bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C] focus-visible:outline-2 focus-visible:outline-[#E8590C] transition-all cursor-pointer flex flex-col justify-between min-h-[96px] tactile-btn"
            data-stop-id={stop.id}
            data-index={idx}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${stop.id}`}
            id={`btn-${stop.id}`}
            tabindex={idx === 0 ? "0" : "-1"}
          >
            <div class="flex items-center justify-between w-full mb-1">
              <span class="font-mono text-[10px] text-[var(--text-dim)] font-medium flex items-center gap-1">
                <span>{stop.order}</span>
                <kbd class="kbd-key text-[8px] px-1 py-0 hidden lg:inline-flex">{idx + 1}</kbd>
              </span>
              <span class="stop-indicator w-2 h-2 rounded-full border border-[var(--border-strong)] bg-transparent group-hover:border-[#E8590C] transition-colors"></span>
            </div>
            <div>
              <div class="font-serif text-sm font-medium text-[var(--text)] leading-tight mb-1 group-hover:text-[#E8590C] transition-colors">
                {stop.name[lang]}
              </div>
              <div class="font-mono text-[10px] text-[var(--text-muted)] truncate">
                {stop.tech[0]}
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Mobile Vertical Flow -->
    <div class="md:hidden relative mb-6 pl-7 border-l-2 border-[var(--border-strong)] space-y-3" role="tablist" aria-label={isTr ? "Veri Hattı Durakları" : "Data Pipeline Stops"}>
      <!-- Mobile moving packet -->
      <div class="pipeline-packet-mobile w-2.5 h-2.5 bg-[#E8590C] rounded-full" aria-hidden="true"></div>

      {PIPELINE_STOPS.map((stop, idx) => (
        <button
          type="button"
          role="tab"
          class="pipeline-stop-btn-mobile w-full text-left p-3 rounded-[2px] bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C] focus-visible:outline-2 focus-visible:outline-[#E8590C] transition-colors tactile-btn"
          data-stop-id={stop.id}
          data-index={idx}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`panel-${stop.id}`}
          id={`btn-mobile-${stop.id}`}
          tabindex={idx === 0 ? "0" : "-1"}
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-xs text-[#E8590C] font-semibold flex items-center gap-1.5">
              <span>{stop.order}</span>
              <kbd class="kbd-key text-[9px] px-1">{idx + 1}</kbd>
            </span>
            <span class="font-mono text-[10px] text-[var(--text-dim)]">{stop.badge[lang]}</span>
          </div>
          <div class="font-serif text-base text-[var(--text)] font-medium">{stop.name[lang]}</div>
          <div class="font-mono text-xs text-[var(--text-muted)] mt-1">
            {stop.tech.slice(0, 3).join(' · ')}
          </div>
        </button>
      ))}
    </div>

    <!-- Stop Detail Inspection Panels -->
    <div class="border-t border-[var(--border)] pt-5 mt-2">
      {PIPELINE_STOPS.map((stop, idx) => (
        <div
          id={`panel-${stop.id}`}
          class={`pipeline-detail-panel ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'} space-y-5 transition-all duration-200`}
          role="tabpanel"
          aria-labelledby={`btn-${stop.id}`}
        >
          <!-- Panel Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[var(--border)]">
            <div class="flex items-center gap-2.5">
              <span class="font-mono text-xs px-2 py-0.5 bg-[#E8590C] text-white rounded-[2px] font-semibold">
                {stop.order}
              </span>
              <h3 class="text-xl sm:text-2xl font-serif text-[var(--text)]">
                {stop.name[lang]}
              </h3>
            </div>
            <!-- Technology tags in context -->
            <div class="flex flex-wrap gap-1.5 font-mono text-[11px]">
              {stop.tech.map((t) => (
                <span class="px-2 py-0.5 bg-[var(--bg-code)] text-[var(--text)] border border-[var(--border)] rounded-[2px]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <!-- 4-Section Inspection Matrix with Engineering Corner Marks -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-sans">
            <!-- 1. O Katmanda Ne Yaptım -->
            <div class="p-3.5 bg-[var(--bg)] border border-[var(--border)] rounded-[2px] space-y-1.5 tech-corner-marks shadow-sm">
              <div class="font-mono text-[11px] font-semibold text-[#E8590C] uppercase tracking-wider flex items-center gap-1.5">
                <span aria-hidden="true">■</span>
                <span>{isTr ? 'O Katmanda Ne Yaptım' : 'What I Engineered'}</span>
              </div>
              <p class="text-[var(--text)] leading-relaxed text-[13px]">
                {stop.whatIDid[lang]}
              </p>
            </div>

            <!-- 2. Hangi Kararı Neden Verdim -->
            <div class="p-3.5 bg-[var(--bg)] border border-[var(--border)] rounded-[2px] space-y-1.5 tech-corner-marks shadow-sm">
              <div class="font-mono text-[11px] font-semibold text-[var(--text)] uppercase tracking-wider flex items-center gap-1.5">
                <span class="text-[#E8590C]" aria-hidden="true">▸</span>
                <span>{isTr ? 'Hangi Kararı Neden Verdim' : 'Architectural Rationale'}</span>
              </div>
              <p class="text-[var(--text-muted)] leading-relaxed text-[13px]">
                {stop.whyDecision[lang]}
              </p>
            </div>

            <!-- 3. Hangi Alternatifi Eledim -->
            <div class="p-3.5 bg-[var(--bg)] border border-[var(--border)] rounded-[2px] space-y-1.5 tech-corner-marks shadow-sm">
              <div class="font-mono text-[11px] font-semibold text-[var(--text-dim)] uppercase tracking-wider flex items-center gap-1.5">
                <span aria-hidden="true">✕</span>
                <span>{isTr ? 'Hangi Alternatifi Eledim' : 'Alternative Eliminated'}</span>
              </div>
              <p class="text-[var(--text-muted)] leading-relaxed text-[13px]">
                {stop.alternativeEliminated[lang]}
              </p>
            </div>

            <!-- 4. Ne Zorladı -->
            <div class="p-3.5 bg-[var(--bg)] border border-[var(--border)] rounded-[2px] space-y-1.5 tech-corner-marks shadow-sm">
              <div class="font-mono text-[11px] font-semibold text-[#E8590C] uppercase tracking-wider flex items-center gap-1.5">
                <span aria-hidden="true">▲</span>
                <span>{isTr ? 'Ne Zorladı & Çözüm' : 'Challenge & Mitigation'}</span>
              </div>
              <p class="text-[var(--text-muted)] leading-relaxed text-[13px]">
                {stop.challenge[lang]}
              </p>
            </div>
          </div>

          <!-- Deep Link to Relevant Case Study & Copy Note -->
          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
            <button
              type="button"
              class="copy-stop-note-btn text-[var(--text-muted)] hover:text-[#E8590C] inline-flex items-center gap-1.5 text-[11px] cursor-pointer tactile-btn px-2 py-1 rounded-[2px] bg-[var(--bg)] border border-[var(--border)]"
              data-stop-name={stop.name[lang]}
              data-stop-summary={`${stop.order}. ${stop.name[lang]}: ${stop.whatIDid[lang]}`}
            >
              <svg class="w-3 h-3 text-[var(--text-dim)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-note-text">{isTr ? 'Bu Katmanın Notunu Kopyala' : 'Copy Stop Summary'}</span>
            </button>

            <a
              href={stop.caseLink.href}
              class="text-[#E8590C] hover:text-[#CF4E08] hover:underline font-medium inline-flex items-center gap-1.5 p-1 group"
            >
              <span>{stop.caseLink.text[lang]}</span>
              <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Infrastructure Ground Strip (Altyapı Zemini) -->
  <div class="border border-[var(--border)] bg-[var(--bg)] rounded-[2px] px-4 py-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-[#E8590C] rounded-full inline-block"></span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-dim)] font-semibold">
          {isTr ? 'Altyapı Zemini (Infrastructure Ground)' : 'Infrastructure Ground Plane'}
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-[var(--text-muted)]">
        {INFRASTRUCTURE_STRIP.map((infra) => (
          <span class="inline-flex items-center gap-1 hover:text-[var(--text)] transition-colors" title={infra.desc}>
            <span class="text-[var(--text-dim)]">·</span>
            <span class="font-medium text-[var(--text)]">{infra.name}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Interactive Pipeline & Telemetry Ping Simulator Script -->
<script is:inline>
  (function() {
    function setupPipeline() {
      const desktopBtns = Array.from(document.querySelectorAll('.pipeline-stop-btn'));
      const mobileBtns = Array.from(document.querySelectorAll('.pipeline-stop-btn-mobile'));
      const panels = Array.from(document.querySelectorAll('.pipeline-detail-panel'));
      const svgNodes = Array.from(document.querySelectorAll('.svg-node'));
      const trackSegments = [
        document.getElementById('track-seg-0'),
        document.getElementById('track-seg-1'),
        document.getElementById('track-seg-2'),
        document.getElementById('track-seg-3'),
        document.getElementById('track-seg-4')
      ];

      const pingBtn = document.getElementById('telemetry-ping-btn');
      const pingBtnLabel = document.getElementById('ping-btn-label');
      const telemetryLog = document.getElementById('telemetry-log-text');
      const isTurkish = document.documentElement.lang === 'tr';

      const STOP_IDS = ['device', 'transport', 'queue', 'storage', 'delivery', 'security'];

      const PING_TELEMETRY_LOGS = isTurkish ? [
        '[01/06 EDGE] ESP32 Modbus RTU: Regs #40001-40016 OK (24.2°C, 58% RH) · CRC: 0xA4F1 [1.2ms]',
        '[02/06 NET] MQTT TLS 1.3: Topic tele/chiller01 -> broker (QoS 1, PktId: 849) [4.8ms]',
        '[03/06 QUEUE] RabbitMQ AMQP: tele.direct exchange -> worker pool acked [0.8ms]',
        '[04/06 STORE] TimescaleDB: Chunk #8192 Inserted (Columnar Compressed) [2.1ms]',
        '[05/06 STREAM] Apache Arrow: Zero-copy IPC RecordBatch -> Float64Array buffer [1.3ms]',
        '[06/06 TRUST] X.509 + RFC 3161: PKCS#11 Sealed & Timestamped [3.4ms]'
      ] : [
        '[01/06 EDGE] ESP32 Modbus RTU: Regs #40001-40016 OK (24.2°C, 58% RH) · CRC: 0xA4F1 [1.2ms]',
        '[02/06 NET] MQTT TLS 1.3: Topic tele/chiller01 -> broker (QoS 1, PktId: 849) [4.8ms]',
        '[03/06 QUEUE] RabbitMQ AMQP: tele.direct exchange -> worker pool acked [0.8ms]',
        '[04/06 STORE] TimescaleDB: Chunk #8192 Inserted (Columnar Compressed) [2.1ms]',
        '[05/06 STREAM] Apache Arrow: Zero-copy IPC RecordBatch -> Float64Array buffer [1.3ms]',
        '[06/06 TRUST] X.509 + RFC 3161: PKCS#11 Sealed & Timestamped [3.4ms]'
      ];

      function updateTrackIllumination(activeIdx) {
        trackSegments.forEach((seg, sIdx) => {
          if (!seg) return;
          if (sIdx < activeIdx) {
            seg.setAttribute('opacity', '0.9');
            seg.setAttribute('stroke', '#E8590C');
          } else if (sIdx === activeIdx) {
            seg.setAttribute('opacity', '0.5');
            seg.setAttribute('stroke', '#E8590C');
          } else {
            seg.setAttribute('opacity', '0.15');
            seg.setAttribute('stroke', 'var(--border-strong)');
          }
        });
      }

      function flashRing(nodeIdx) {
        const ring = document.getElementById(`ping-ring-${nodeIdx}`);
        if (!ring) return;
        ring.classList.remove('hidden');
        ring.classList.remove('ping-shockwave');
        // Force reflow
        void ring.offsetWidth;
        ring.classList.add('ping-shockwave');
        setTimeout(() => {
          ring.classList.add('hidden');
        }, 650);
      }

      function activateStop(stopId, focusTarget = false) {
        let activeIdx = 0;

        // Update desktop buttons
        desktopBtns.forEach((btn, idx) => {
          const isTarget = btn.getAttribute('data-stop-id') === stopId;
          btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          btn.setAttribute('tabindex', isTarget ? '0' : '-1');
          const indicator = btn.querySelector('.stop-indicator');
          if (isTarget) {
            activeIdx = idx;
            btn.classList.add('border-[#E8590C]', 'bg-[var(--bg-subtle)]');
            if (indicator) {
              indicator.classList.remove('bg-transparent', 'border-[var(--border-strong)]');
              indicator.classList.add('bg-[#E8590C]', 'border-[#E8590C]');
            }
            if (focusTarget) btn.focus();
          } else {
            btn.classList.remove('border-[#E8590C]', 'bg-[var(--bg-subtle)]');
            if (indicator) {
              indicator.classList.remove('bg-[#E8590C]', 'border-[#E8590C]');
              indicator.classList.add('bg-transparent', 'border-[var(--border-strong)]');
            }
          }
        });

        // Update mobile buttons
        mobileBtns.forEach((btn) => {
          const isTarget = btn.getAttribute('data-stop-id') === stopId;
          btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          btn.setAttribute('tabindex', isTarget ? '0' : '-1');
          if (isTarget) {
            btn.classList.add('border-[#E8590C]', 'bg-[var(--bg-subtle)]');
          } else {
            btn.classList.remove('border-[#E8590C]', 'bg-[var(--bg-subtle)]');
          }
        });

        // Update SVG node markers
        svgNodes.forEach((node, idx) => {
          if (idx === activeIdx) {
            node.setAttribute('fill', '#E8590C');
            node.setAttribute('stroke', '#E8590C');
            node.setAttribute('r', '7');
          } else {
            node.setAttribute('fill', 'var(--bg)');
            node.setAttribute('stroke', 'var(--border-strong)');
            node.setAttribute('r', '5');
          }
        });

        // Update Track Segments
        updateTrackIllumination(activeIdx);

        // Update panels
        panels.forEach((panel) => {
          if (panel.id === `panel-${stopId}`) {
            panel.classList.remove('hidden', 'opacity-0');
            panel.classList.add('block', 'opacity-100');
          } else {
            panel.classList.remove('block', 'opacity-100');
            panel.classList.add('hidden', 'opacity-0');
          }
        });
      }

      // Event listeners for desktop tabs
      desktopBtns.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          const stopId = btn.getAttribute('data-stop-id');
          if (stopId) activateStop(stopId);
        });

        // Keyboard arrow navigation
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIdx = (idx + 1) % desktopBtns.length;
            const nextId = desktopBtns[nextIdx].getAttribute('data-stop-id');
            if (nextId) activateStop(nextId, true);
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIdx = (idx - 1 + desktopBtns.length) % desktopBtns.length;
            const prevId = desktopBtns[prevIdx].getAttribute('data-stop-id');
            if (prevId) activateStop(prevId, true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            const firstId = desktopBtns[0].getAttribute('data-stop-id');
            if (firstId) activateStop(firstId, true);
          } else if (e.key === 'End') {
            e.preventDefault();
            const lastId = desktopBtns[desktopBtns.length - 1].getAttribute('data-stop-id');
            if (lastId) activateStop(lastId, true);
          }
        });
      });

      mobileBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const stopId = btn.getAttribute('data-stop-id');
          if (stopId) activateStop(stopId);
        });
      });

      // SVG schematic nodes click listeners
      svgNodes.forEach((node, idx) => {
        node.addEventListener('click', () => {
          const stopId = STOP_IDS[idx];
          if (stopId) activateStop(stopId);
        });
      });

      // Telemetry Ping Simulation
      let isPinging = false;
      const NODE_X_COORDS = [83, 250, 417, 583, 750, 917];
      const svgPingPacket = document.getElementById('svg-ping-packet');

      function runTelemetryPing() {
        if (isPinging) return;
        isPinging = true;

        if (pingBtn) {
          pingBtn.setAttribute('disabled', 'true');
          pingBtn.classList.add('opacity-75');
        }
        if (pingBtnLabel) {
          pingBtnLabel.textContent = isTurkish ? 'Ping İletiliyor...' : 'Transmitting Ping...';
        }

        if (svgPingPacket) {
          svgPingPacket.setAttribute('cx', String(NODE_X_COORDS[0]));
          svgPingPacket.classList.remove('opacity-0');
        }

        const delays = [0, 200, 400, 600, 800, 1000];
        delays.forEach((delay, hopIdx) => {
          setTimeout(() => {
            const stopId = STOP_IDS[hopIdx];
            activateStop(stopId);
            flashRing(hopIdx);

            if (svgPingPacket) {
              svgPingPacket.setAttribute('cx', String(NODE_X_COORDS[hopIdx]));
            }

            if (telemetryLog) {
              telemetryLog.textContent = PING_TELEMETRY_LOGS[hopIdx];
            }
          }, delay);
        });

        // Complete Ping
        setTimeout(() => {
          isPinging = false;
          if (svgPingPacket) {
            svgPingPacket.classList.add('opacity-0');
          }
          if (pingBtn) {
            pingBtn.removeAttribute('disabled');
            pingBtn.classList.remove('opacity-75');
          }
          if (pingBtnLabel) {
            pingBtnLabel.textContent = isTurkish ? 'Telemetri Pingi Ateşle' : 'Fire Telemetry Ping';
          }
          if (telemetryLog) {
            telemetryLog.textContent = isTurkish 
              ? '✔ PING TAMAMLANDI · Toplam Gecikme: 13.6ms · 0 Paket Kaybı · Uçtan Uca Bütünlük: %100'
              : '✔ PING VERIFIED · Total Latency: 13.6ms · 0 Packet Loss · End-to-end Integrity: 100%';
          }
          if (typeof window.showToast === 'function') {
            window.showToast(isTurkish ? '✓ Telemetri hattı uçtan uca doğrulandı (13.6ms)' : '✓ Telemetry pipeline verified end-to-end (13.6ms)');
          }
        }, 1300);
      }

      pingBtn?.addEventListener('click', runTelemetryPing);

      // Keyboard numbers 1 to 6 to switch stops, and P for ping
      window.addEventListener('keydown', (e) => {
        // CRITICAL: Ignore modifier keys so browser tab switching (Ctrl+1..6) and Print (Ctrl+P) remain untouched
        if (e.ctrlKey || e.metaKey || e.altKey) {
          return;
        }

        const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
        if (tag === 'input' || tag === 'textarea' || (document.activeElement && document.activeElement.isContentEditable)) {
          return;
        }

        const num = parseInt(e.key, 10);
        if (num >= 1 && num <= 6) {
          e.preventDefault();
          const targetId = STOP_IDS[num - 1];
          if (targetId) activateStop(targetId, true);
        } else if (e.key === 'p' || e.key === 'P') {
          e.preventDefault();
          runTelemetryPing();
        }
      });

      // Stop Note Copy Buttons
      document.querySelectorAll('.copy-stop-note-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const summary = btn.getAttribute('data-stop-summary') || '';
          const label = btn.querySelector('.copy-note-text');
          try {
            await navigator.clipboard.writeText(summary);
            if (label) label.textContent = isTurkish ? '✓ Kopyalandı!' : '✓ Copied!';
            if (typeof window.showToast === 'function') {
              window.showToast(isTurkish ? '✓ Katman özeti kopyalandı' : '✓ Stop summary copied');
            }
            setTimeout(() => {
              if (label) label.textContent = isTurkish ? 'Bu Katmanın Notunu Kopyala' : 'Copy Stop Summary';
            }, 2000);
          } catch (_) {
            prompt('Özet:', summary);
          }
        });
      });

      // Initialize with first stop active
      activateStop('device');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPipeline);
    } else {
      setupPipeline();
    }
  })();
</script>
