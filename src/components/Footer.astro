---
import { getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();

// Build sırasında tüm posts içeriklerini tarayarak en güncel yayın/güncelleme tarihini bulma
const allPosts = await getCollection('posts');

let latestTimestamp = 0;

allPosts.forEach((item) => {
  const dateStr = item.data?.date;
  if (dateStr) {
    const time = new Date(dateStr).getTime();
    if (!isNaN(time) && time > latestTimestamp) {
      latestTimestamp = time;
    }
  }
});

const turkishMonths = [
  'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran',
  'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'
];

const latestDate = latestTimestamp > 0 ? new Date(latestTimestamp) : new Date();
const lastUpdatedFormatted = `${turkishMonths[latestDate.getMonth()]} ${latestDate.getFullYear()}`;
---

<footer class="w-full border-t border-[var(--border)]/70 bg-[var(--bg)] text-[11.5px] py-5 transition-colors">
  <div class="max-w-[1140px] w-full mx-auto px-5 sm:px-8 lg:px-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-[var(--text-dim)]">
      <!-- Colophon / Identity -->
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-sans">
        <span class="font-medium text-[var(--text-muted)]">© {currentYear} Ahmet İhtiyar</span>
        <span class="text-[var(--border-strong)]" aria-hidden="true">·</span>
        <span>PostgreSQL & Veritabanı Mimarisi Notları</span>
      </div>

      <!-- Freshness & Feed -->
      <div class="flex items-center gap-2.5 font-mono text-[11px]">
        <span>Son güncelleme: {lastUpdatedFormatted}</span>
        <span class="text-[var(--border-strong)]" aria-hidden="true">·</span>
        <a
          href="/rss.xml"
          class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors inline-flex items-center gap-0.5"
          title="RSS Akışı"
        >
          <span>RSS</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</footer>
