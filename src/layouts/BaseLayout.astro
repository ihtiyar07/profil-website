---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE_META } from '../data/siteMeta';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  articleMeta?: {
    publishDate: string;
    tags: string[];
  };
}

const {
  title = SITE_META.title,
  description = SITE_META.bioShort,
  canonicalPath = '',
  articleMeta
} = Astro.props;

const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, SITE_META.siteUrl).toString();

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImagePath = cleanPath === '' 
  ? '/og/index.png' 
  : `/og/${cleanPath}.png`;
const ogImageUrl = new URL(ogImagePath, SITE_META.siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmet İhtiyar",
  "url": SITE_META.siteUrl,
  "jobTitle": "Veritabanı & Depolama",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "İstanbul",
    "addressCountry": "TR"
  },
  "sameAs": [
    SITE_META.github,
    SITE_META.linkedin
  ],
  "knowsAbout": [
    "Database Architecture",
    "PostgreSQL Internals",
    "Oracle Database Optimization",
    "TimescaleDB & Hypertables",
    "Storage Engines & ZFS",
    "Zero-Impact Metadata Extraction",
    "Memgraph Schema Lineage",
    "Apache Arrow IPC",
    "Distributed Systems",
    "Query Performance Tuning"
  ]
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ahmet İhtiyar" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ahmet İhtiyar — Veritabanı Mimarisi Yazıları" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant FOUC prevention for light/dark theme -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] transition-colors">
    <a href="#main-content" class="skip-link">
      Ana içeriğe atla
    </a>

    <!-- Full-Width Shell: Topic Sidebar on the left + Expanded Main Column on the right -->
    <div class="min-h-screen flex flex-col lg:flex-row">
      <!-- Topic Tree Sidebar (Desktop sticky sidebar + Mobile responsive header) -->
      <Sidebar />

      <!-- Main Column: Fills the remaining screen with generous width, eliminating empty space -->
      <div class="flex-1 min-w-0 flex flex-col min-h-screen">
        <main id="main-content" class="flex-1 w-full px-6 sm:px-10 lg:px-12 xl:px-16 py-6 sm:py-10">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- Global Accessible Toast Notification -->
    <div id="global-toast" role="status" aria-live="polite">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span id="toast-message"></span>
    </div>

    <script is:inline>
      window.showToast = function(msg, duration = 2500) {
        const toast = document.getElementById('global-toast');
        const text = document.getElementById('toast-message');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.add('toast-show');
        if (window.__toastTimeout) clearTimeout(window.__toastTimeout);
        window.__toastTimeout = setTimeout(() => {
          toast.classList.remove('toast-show');
        }, duration);
      };

      // Universal clean copy button for all article code blocks
      (function() {
        function setupArticlePreCopy() {
          document.querySelectorAll('.prose pre, article pre').forEach((pre) => {
            if (pre.closest('.pre-copy-wrapper') || pre.closest('[data-no-auto-copy]')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'relative group pre-copy-wrapper';
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            // Reserve room on top-right so long code lines never collide with the button
            pre.style.paddingRight = '5.5rem';

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'absolute top-2.5 right-2.5 px-2.5 py-1 rounded-[2px] bg-[#161b22] border border-[#30363d] text-[#c9d1d9] hover:text-white hover:border-[#8b949e] text-[11px] font-mono cursor-pointer shadow-xs tactile-btn transition-colors select-none z-10';
            btn.setAttribute('aria-label', 'Kodu kopyala');
            btn.textContent = 'Kopyala';

            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btn.textContent = 'Kopyalandı';
                btn.classList.add('text-[var(--status-green)]', 'border-[var(--status-green)]');
                if (typeof window.showToast === 'function') {
                  window.showToast('Kod panoya kopyalandı');
                }
                setTimeout(() => {
                  btn.textContent = 'Kopyala';
                  btn.classList.remove('text-[var(--status-green)]', 'border-[var(--status-green)]');
                }, 2000);
              } catch (_) {
                prompt('Kod:', code);
              }
            });

            wrapper.appendChild(btn);
          });
        }

        function setupResponsiveTables() {
          document.querySelectorAll('.prose table, article table').forEach((table) => {
            if (table.closest('.table-responsive-wrapper')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          });
        }

        function initArticleEnhancements() {
          setupArticlePreCopy();
          setupResponsiveTables();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initArticleEnhancements);
        } else {
          initArticleEnhancements();
        }
      })();
    </script>
  </body>
</html>
