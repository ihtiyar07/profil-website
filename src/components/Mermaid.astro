---
interface Props {
  code: string;
  title?: string;
}

const { code, title } = Astro.props;
const uniqueId = `mermaid-${Math.random().toString(36).substring(2, 9)}`;
---

<figure class="mermaid-container relative my-6 not-prose border border-[var(--border)] rounded-[2px] bg-[var(--bg-card)] shadow-xs">
  <div class="px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--text-dim)] select-none">
    <span class="flex items-center gap-2 font-medium text-[var(--text)]">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span>{title || 'Mimari Şema'}</span>
    </span>

    <div class="flex items-center gap-2">
      <span class="text-[10px] text-[var(--text-dim)] border border-[var(--border)] px-1.5 py-0.5 rounded-[2px] bg-[var(--bg)] hidden sm:flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)] animate-pulse" aria-hidden="true"></span>
        <span>Bileşen detayları için tıkla</span>
      </span>

      <!-- Fullscreen / Zoom Trigger Button -->
      <button
        type="button"
        class="mermaid-fullscreen-trigger px-2.5 py-1 text-[11px] font-mono rounded-[2px] border border-[var(--border)] bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-pointer flex items-center gap-1.5 shadow-2xs tactile-btn"
        title="Mimariyi Tam Ekran / Büyütülmüş Olarak İncele"
        aria-label="Mimariyi Tam Ekran Büyüt"
      >
        <svg class="w-3.5 h-3.5 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
        </svg>
        <span class="font-medium">Tam Ekran Büyüt</span>
      </button>
    </div>
  </div>
  
  <div class="p-4 sm:p-5 overflow-x-auto flex justify-center items-center min-h-[160px] bg-[var(--bg)]/40 cursor-zoom-in group" title="Büyütmek için tıklayabilir veya Tam Ekran butonunu kullanabilirsiniz">
    <div class="mermaid-diagram opacity-0 transition-opacity duration-300 w-full flex justify-center" id={uniqueId} data-code={code}>
      <pre class="font-mono text-xs text-[var(--text-muted)] p-2 overflow-x-auto">{code.trim()}</pre>
    </div>
  </div>

  <!-- Interactive Component Details Dialog / Popover -->
  <div 
    class="mermaid-node-dialog pointer-events-none opacity-0 fixed z-[120] transition-all duration-200 w-80 max-w-[calc(100vw-2rem)] p-3.5 rounded-[2px] border border-[var(--border)] bg-[var(--bg-card)] shadow-xl text-left backdrop-blur-sm"
    role="dialog"
    aria-hidden="true"
  >
    <div class="flex items-start justify-between gap-2 border-b border-[var(--border)] pb-2 mb-2">
      <div>
        <span class="node-dialog-role font-mono text-[10px] uppercase tracking-wider text-[var(--accent)] font-semibold block"></span>
        <h4 class="node-dialog-title font-serif text-sm font-semibold text-[var(--text)] leading-tight"></h4>
      </div>
      <button type="button" class="node-dialog-close text-[var(--text-dim)] hover:text-[var(--text)] p-1 -mr-1 -mt-1 cursor-pointer transition-colors text-xs font-mono" aria-label="Kapat">✕</button>
    </div>
    <p class="node-dialog-desc text-xs text-[var(--text-muted)] leading-relaxed mb-2 font-sans"></p>
    <div class="node-dialog-detail text-[11px] font-mono text-[var(--text-dim)] bg-[var(--bg-subtle)] p-2 rounded-[2px] border border-[var(--border)] hidden"></div>
  </div>

  <!-- Dedicated Fullscreen Diagram Modal -->
  <div 
    class="mermaid-fullscreen-modal fixed inset-0 z-[100] bg-[var(--bg)]/98 backdrop-blur-md hidden flex-col p-3 sm:p-5 select-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Mimari Diyagram Tam Ekran İnceleme"
  >
    <!-- Modal Header with Zoom Controls -->
    <div class="px-4 py-2.5 border border-[var(--border)] bg-[var(--bg-subtle)] flex items-center justify-between gap-3 text-xs font-mono text-[var(--text-dim)] rounded-t-[3px]">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] shrink-0" aria-hidden="true"></span>
        <span class="font-semibold text-[var(--text)] truncate">{title || 'Mimari Şema'}</span>
        <span class="text-[10px] text-[var(--text-dim)] border border-[var(--border)] px-1.5 py-0.5 rounded-[2px] bg-[var(--bg)] hidden md:inline">
          Bileşen detayları için kutulara tıklayabilirsiniz
        </span>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <!-- Zoom Out -->
        <button
          type="button"
          class="mermaid-zoom-out px-2.5 py-1 rounded-[2px] border border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] text-[var(--text)] transition-colors cursor-pointer text-xs font-mono"
          title="Uzaklaştır"
          aria-label="Uzaklaştır"
        >
          －
        </button>

        <!-- Zoom Level Indicator / Reset -->
        <button
          type="button"
          class="mermaid-zoom-reset px-2.5 py-1 rounded-[2px] border border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] text-[var(--text)] transition-colors cursor-pointer text-xs font-mono font-medium"
          title="Ölçeği Sıfırla"
        >
          <span class="zoom-level-text">%125</span>
        </button>

        <!-- Zoom In -->
        <button
          type="button"
          class="mermaid-zoom-in px-2.5 py-1 rounded-[2px] border border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] text-[var(--text)] transition-colors cursor-pointer text-xs font-mono"
          title="Yakınlaştır"
          aria-label="Yakınlaştır"
        >
          ＋
        </button>

        <span class="text-[var(--border)]">|</span>

        <!-- Close Button -->
        <button
          type="button"
          class="mermaid-fullscreen-close px-2.5 py-1 rounded-[2px] bg-[#da3633]/15 hover:bg-[#da3633]/30 border border-[#f85149]/30 text-[#f85149] hover:text-white transition-colors cursor-pointer text-xs font-mono font-semibold flex items-center gap-1"
          aria-label="Kapat"
        >
          <span>✕ Kapat</span>
          <span class="text-[10px] opacity-75 hidden sm:inline">(Esc)</span>
        </button>
      </div>
    </div>

    <!-- Fullscreen SVG Viewport Canvas -->
    <div class="mermaid-fullscreen-canvas flex-1 w-full overflow-auto flex items-center justify-center p-6 bg-[var(--bg-card)] border-x border-b border-[var(--border)] rounded-b-[3px] relative cursor-grab active:cursor-grabbing">
      <div class="mermaid-fullscreen-stage transition-transform duration-100 ease-out origin-center flex items-center justify-center min-w-full min-h-full">
        <!-- SVG will be injected here -->
      </div>
    </div>
  </div>
</figure>

<style is:global>
  .mermaid-diagram svg {
    min-width: 620px;
    max-width: 100%;
    height: auto;
  }
  .mermaid-diagram svg .node.has-tooltip {
    cursor: pointer;
  }
  .mermaid-diagram svg .node.has-tooltip:hover {
    filter: brightness(1.05) drop-shadow(0 2px 6px rgba(232, 89, 12, 0.2));
  }
  .mermaid-diagram svg .node.active-tooltip rect,
  .mermaid-diagram svg .node.active-tooltip polygon,
  .mermaid-diagram svg .node.active-tooltip circle,
  .mermaid-diagram svg .node.active-tooltip path {
    stroke: var(--accent) !important;
    stroke-width: 2px !important;
  }
</style>

