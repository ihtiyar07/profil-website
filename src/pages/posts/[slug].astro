---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostSlug } from '../../data/slugUtils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => {
    const slug = getPostSlug(entry);
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout 
  title={`${entry.data.title} — Ahmet İhtiyar`} 
  description={entry.data.summary}
  articleMeta={{ publishDate: entry.data.date, tags: entry.data.tags }}
>
  <article class="py-8 sm:py-12 space-y-8 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="space-y-4 pb-6 border-b border-[var(--border)]">
      <div class="flex items-center justify-between">
        <a
          href="/#articles"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
          aria-label="Yazılar ve notlar listesine dön"
        >
          <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
          <span>Yazılara Dön</span>
        </a>
        <div class="font-mono text-xs text-[var(--text-dim)] flex items-center gap-2">
          <time datetime={entry.data.date}>{entry.data.date}</time>
          <span>·</span>
          <span>{entry.data.readingTime}</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-[2.5rem] font-serif text-[var(--text)] tracking-tight leading-[1.2]">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-[var(--text-muted)] font-sans leading-relaxed">
        {entry.data.summary}
      </p>

      <div class="flex flex-wrap items-center gap-1.5 pt-1">
        {entry.data.tags.map((tag) => (
          <a
            href={`/#articles?tag=${encodeURIComponent(tag)}`}
            class="font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors cursor-pointer"
            title={`#${tag} etiketine ait yazıları filtrele`}
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>

    <!-- Article Content with Optimal Reading Typography -->
    <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-8 [&>h2]:pb-2 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h2]:text-[var(--text)] [&>h3]:text-xl [&>h3]:font-serif [&>h3]:pt-4 [&>h3]:pb-1 [&>h3]:text-[var(--text)] [&>p]:text-[15.5px] sm:[&>p]:text-[16px] [&>p]:leading-[1.75] [&>p]:text-[var(--text)] [&_strong]:font-semibold [&_strong]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ul>li]:my-1.5 [&>ol>li]:my-1.5 [&>ul>li]:leading-relaxed [&>ol>li]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-[var(--accent)] [&>blockquote]:pl-4 [&>blockquote]:py-1 [&>blockquote]:italic [&>blockquote]:text-[var(--text-muted)] [&>pre]:bg-[var(--bg-code)] [&>pre]:border [&>pre]:border-[var(--border)] [&>pre]:p-4 [&>pre]:rounded-[2px] [&>code]:font-mono [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[13px] [&_:not(pre)>code]:bg-[var(--bg-subtle)] [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-[2px] [&_:not(pre)>code]:border [&_:not(pre)>code]:border-[var(--border)]">
      <Content />
    </div>

    <!-- Footer Back Link & Feedback -->
    <div class="pt-8 border-t border-[var(--border)] flex flex-col sm:flex-row justify-between sm:items-center gap-4 font-mono text-xs">
      <a
        href="/#articles"
        class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
        <span>Yazılara Dön</span>
      </a>
      <a
        href="mailto:ahmetihtiyar1453@gmail.com"
        class="text-[var(--text-muted)] hover:text-[var(--accent)] hover:underline inline-flex items-center gap-1"
      >
        <span>Yazı Hakkında Geri Bildirim Ver</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
</BaseLayout>
