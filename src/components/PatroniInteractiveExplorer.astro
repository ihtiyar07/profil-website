---
// Interactive Patroni HA & Failover Explorer Component
---

<div class="patroni-explorer not-prose my-8 border border-[var(--border)] bg-[var(--bg-subtle)]/50 rounded-[2px] overflow-hidden shadow-sm">
  <!-- Component Header -->
  <div class="px-4 py-3 bg-[var(--bg)] border-b border-[var(--border)] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--status-green)] animate-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text)]">
        Patroni PostgreSQL HA & Otomatik Failover Simülatörü
      </span>
    </div>
    <span class="font-mono text-[11px] text-[var(--text-dim)]">
      PostgreSQL 16 · Patroni 3.3.0 · etcd v3.5 · Patroni-UI
    </span>
  </div>

  <!-- Interactive Scenario Selector Tabs -->
  <div class="p-3 bg-[var(--bg-subtle)]/70 border-b border-[var(--border)] flex flex-wrap gap-1.5" role="tablist" aria-label="Patroni Senaryoları">
    <button
      type="button"
      class="patroni-scenario-btn px-2.5 py-1.5 rounded-[2px] text-xs font-mono transition-all cursor-pointer bg-[var(--text)] text-[var(--bg)] font-medium border border-[var(--text)] is-active"
      data-scenario="sync"
      role="tab"
      aria-selected="true"
    >
      01 · Sağlıklı Küme & Senkron Akış
    </button>
    <button
      type="button"
      class="patroni-scenario-btn px-2.5 py-1.5 rounded-[2px] text-xs font-mono transition-all cursor-pointer bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] hover:border-[var(--border-strong)]"
      data-scenario="switchover"
      role="tab"
      aria-selected="false"
    >
      02 · Planlı Bakım & Switchover
    </button>
    <button
      type="button"
      class="patroni-scenario-btn px-2.5 py-1.5 rounded-[2px] text-xs font-mono transition-all cursor-pointer bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] hover:border-[var(--border-strong)]"
      data-scenario="failover"
      role="tab"
      aria-selected="false"
    >
      03 · Primary Çökmesi & Failover
    </button>
    <button
      type="button"
      class="patroni-scenario-btn px-2.5 py-1.5 rounded-[2px] text-xs font-mono transition-all cursor-pointer bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] hover:border-[var(--border-strong)]"
      data-scenario="splitbrain"
      role="tab"
      aria-selected="false"
    >
      04 · Ağ İzolasyonu & Fencing
    </button>
    <button
      type="button"
      class="patroni-scenario-btn px-2.5 py-1.5 rounded-[2px] text-xs font-mono transition-all cursor-pointer bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] hover:border-[var(--border-strong)]"
      data-scenario="rewind"
      role="tab"
      aria-selected="false"
    >
      05 · pg_rewind ile Yeniden Katılma
    </button>
  </div>

  <!-- Interactive Consensus & Cluster Flow Diagram -->
  <div class="px-4 py-3 bg-[var(--bg)] border-b border-[var(--border)]">
    <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] mb-2 font-semibold">
      Konsensüs ve Yönlendirme Durumu (Consensus & Routing Lifecycle)
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 text-center text-xs font-mono">
      <div class="p-2 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] flex flex-col justify-center">
        <span class="text-[10px] text-[var(--text-dim)] block">1. İstemci & Yük Dengeleyici</span>
        <span class="font-semibold text-[var(--text)]" id="patroni-flow-step-1">HAProxy: Port 5000 -> pg-node-1</span>
      </div>
      <div class="p-2 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] flex flex-col justify-center">
        <span class="text-[10px] text-[var(--text-dim)] block">2. DCS (etcd Quorum 2/3)</span>
        <span class="font-semibold text-[var(--accent)]" id="patroni-flow-step-2">/leader -> pg-node-1 (TTL 28s)</span>
      </div>
      <div class="p-2 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] flex flex-col justify-center">
        <span class="text-[10px] text-[var(--text-dim)] block">3. Patroni Daemon</span>
        <span class="font-semibold text-[var(--text)]" id="patroni-flow-step-3">loop_wait 10s · Health: 200 OK</span>
      </div>
      <div class="p-2 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] flex flex-col justify-center">
        <span class="text-[10px] text-[var(--text-dim)] block">4. PostgreSQL Replikasyon</span>
        <span class="font-semibold text-[var(--status-green)]" id="patroni-flow-step-4">Sync Standby: 0 lag (RPO=0)</span>
      </div>
    </div>
  </div>

  <!-- 3-Node Topology Live Visualizer -->
  <div class="p-4 bg-[var(--bg)] border-b border-[var(--border)]">
    <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] mb-2 font-semibold">
      Canlı Düğüm Topolojisi (Node Topology Matrix)
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Node 1 -->
      <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/60 space-y-1.5 font-mono text-xs" id="topo-card-node1">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-[var(--text)]">pg-node-1</span>
          <span class="px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium bg-[var(--status-green)]/15 text-[var(--status-green)] border border-[var(--status-green)]/30" id="topo-role-node1">Primary</span>
        </div>
        <div class="text-[11px] text-[var(--text-muted)] space-y-0.5">
          <div>IP: 192.168.10.11:5432</div>
          <div>Timeline: <span id="topo-tl-node1" class="font-semibold text-[var(--text)]">TL 1</span></div>
          <div>Durum: <span id="topo-state-node1" class="text-[var(--status-green)]">running</span></div>
        </div>
      </div>

      <!-- Node 2 -->
      <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/60 space-y-1.5 font-mono text-xs" id="topo-card-node2">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-[var(--text)]">pg-node-2</span>
          <span class="px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30" id="topo-role-node2">Sync Standby</span>
        </div>
        <div class="text-[11px] text-[var(--text-muted)] space-y-0.5">
          <div>IP: 192.168.10.12:5432</div>
          <div>Timeline: <span id="topo-tl-node2" class="font-semibold text-[var(--text)]">TL 1</span></div>
          <div>Durum: <span id="topo-state-node2" class="text-[var(--status-green)]">running (0 lag)</span></div>
        </div>
      </div>

      <!-- Node 3 -->
      <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/60 space-y-1.5 font-mono text-xs" id="topo-card-node3">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-[var(--text)]">pg-node-3</span>
          <span class="px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium bg-[var(--bg)] text-[var(--text-muted)] border border-[var(--border)]" id="topo-role-node3">Async Standby</span>
        </div>
        <div class="text-[11px] text-[var(--text-muted)] space-y-0.5">
          <div>IP: 192.168.10.13:5432</div>
          <div>Timeline: <span id="topo-tl-node3" class="font-semibold text-[var(--text)]">TL 1</span></div>
          <div>Durum: <span id="topo-state-node3" class="text-[var(--status-green)]">running (0 lag)</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- View Mode Switcher: patronictl list | etcd DCS State | HAProxy & pg_controldata | Patroni Web UI -->
  <div class="p-4 space-y-4">
    <!-- Summary Description of Scenario -->
    <div class="text-xs sm:text-sm font-sans text-[var(--text-muted)] bg-[var(--bg)] p-3 border border-[var(--border)] rounded-[2px]" id="patroni-scenario-description">
      pg-node-1 lider konumunda, pg-node-2 senkron replika olarak işlem taahhütlerini (commit) doğrular, pg-node-3 asenkron olarak takip eder.
    </div>

    <!-- Inspector Tabs -->
    <div class="border border-[var(--border)] rounded-[2px] bg-[var(--bg)] overflow-hidden">
      <!-- Tab Header Buttons -->
      <div class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--bg-subtle)]/70 px-3 py-2 flex-wrap gap-2">
        <div class="flex items-center gap-1.5 flex-wrap">
          <button
            type="button"
            class="patroni-tab-btn px-2 py-1 text-xs font-mono font-medium rounded-[2px] bg-[var(--text)] text-[var(--bg)] is-active cursor-pointer"
            data-target="cli"
          >
            patronictl list (Küme Tablosu)
          </button>
          <button
            type="button"
            class="patroni-tab-btn px-2 py-1 text-xs font-mono font-medium rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] cursor-pointer"
            data-target="dcs"
          >
            etcd / DCS Anahtarları (JSON)
          </button>
          <button
            type="button"
            class="patroni-tab-btn px-2 py-1 text-xs font-mono font-medium rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] cursor-pointer"
            data-target="haproxy"
          >
            HAProxy & Timeline ID
          </button>
          <button
            type="button"
            class="patroni-tab-btn px-2 py-1 text-xs font-mono font-medium rounded-[2px] text-[var(--accent)] hover:text-[var(--text)] bg-[var(--accent-subtle)] cursor-pointer flex items-center gap-1"
            data-target="ui"
          >
            <span>Web UI (Patroni Dashboard)</span>
          </button>
        </div>

        <button
          type="button"
          id="patroni-copy-btn"
          class="px-2 py-0.5 text-[11px] font-mono rounded-[2px] border border-[var(--border)] bg-[var(--bg)] text-[var(--text-dim)] hover:text-[var(--text)] transition-colors inline-flex items-center gap-1 cursor-pointer"
        >
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="patroni-copy-text">Kopyala</span>
        </button>
      </div>

      <!-- Tab Content 1: CLI -->
      <div id="patroni-panel-cli" class="patroni-panel p-4 font-mono text-xs overflow-x-auto bg-[#0D1117] text-[#E6EDF3]">
        <pre><code id="patroni-code-cli">{`+ Cluster: postgres-ha (7349182391029381023) +---------+
| Member    | Host          | Role    | State   | TL | Lag in MB |
+-----------+---------------+---------+---------+----+-----------+
| pg-node-1 | 192.168.10.11 | Primary | running |  1 |           |
| pg-node-2 | 192.168.10.12 | Sync    | running |  1 |         0 |
| pg-node-3 | 192.168.10.13 | Replica | running |  1 |         0 |
+-----------+---------------+---------+---------+----+-----------+`}</code></pre>
      </div>

      <!-- Tab Content 2: DCS JSON -->
      <div id="patroni-panel-dcs" class="patroni-panel p-4 font-mono text-xs overflow-x-auto bg-[#0D1117] text-[#E6EDF3] hidden">
        <pre><code id="patroni-code-dcs">{`// etcdctl get --prefix /service/postgres-ha/
/service/postgres-ha/leader:
{"version": "3.3.0", "role": "primary", "state": "running", "leader": "pg-node-1"}

/service/postgres-ha/sync:
{"leader": "pg-node-1", "sync_standby": "pg-node-2"}

/service/postgres-ha/members/pg-node-1:
{"conn_url": "postgres://192.168.10.11:5432/postgres", "api_url": "http://192.168.10.11:8008/patroni", "state": "running", "role": "primary", "xlog_location": 184549384}`}</code></pre>
      </div>

      <!-- Tab Content 3: HAProxy & Timeline -->
      <div id="patroni-panel-haproxy" class="patroni-panel p-4 font-mono text-xs overflow-x-auto bg-[#0D1117] text-[#E6EDF3] hidden">
        <pre><code id="patroni-code-haproxy">{`# HAProxy Sağlık Kontrolleri (Port 5000 Write Havuzu):
$ curl -s -i http://192.168.10.11:8008/primary
HTTP/1.1 200 OK
Content-Type: application/json
{"state": "running", "postmaster_start_time": "2026-11-10 14:00:01 UTC", "role": "primary", "server_version": 160002}

$ curl -s -i http://192.168.10.12:8008/primary
HTTP/1.1 503 Service Unavailable

# pg_controldata /var/lib/postgresql/data (pg-node-1):
Database cluster state:               in production
Latest checkpoint's TimeLineID:        1
Latest checkpoint's REDO WAL file:     00000001000000000000000B`}</code></pre>
      </div>

      <!-- Tab Content 4: Patroni Web Dashboard Preview -->
      <div id="patroni-panel-ui" class="patroni-panel p-4 font-sans text-xs bg-[var(--bg)] hidden space-y-3">
        <!-- Dashboard Cluster Header -->
        <div class="p-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="space-y-0.5">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[var(--status-green)]"></span>
              <span class="font-mono font-semibold text-[var(--text)] text-xs">postgres-ha.cluster.local</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 bg-[var(--status-green)]/15 text-[var(--status-green)] rounded-[2px] font-medium" id="patroni-ui-quorum-badge">Quorum: 2/3 (Sağlıklı)</span>
            </div>
            <div class="text-[11px] text-[var(--text-muted)] font-mono">
              Konsensüs Motoru: <span class="text-[var(--text)] font-semibold">etcd v3.5</span> · Replikasyon: <span class="text-[var(--status-green)] font-semibold">Synchronous (RPO=0)</span>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="patroni-action-switchover"
              class="px-2.5 py-1 text-[11px] font-mono font-medium rounded-[2px] bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] transition-colors cursor-pointer tactile-btn"
            >
              ⚡ Switchover Yap
            </button>
            <button
              type="button"
              id="patroni-action-pause"
              class="px-2.5 py-1 text-[11px] font-mono font-medium rounded-[2px] border border-[var(--border)] bg-[var(--bg)] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors cursor-pointer tactile-btn"
            >
              ⏸ Bakım Modu
            </button>
          </div>
        </div>

        <!-- Visual Node Monitor Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 font-mono text-xs">
          <!-- Node 1 Card in Dashboard -->
          <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/70 space-y-2" id="ui-box-node1">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-1.5">
              <span class="font-semibold text-[var(--text)]">pg-node-1</span>
              <span id="ui-card-role-node1" class="px-1.5 py-0.5 text-[10px] rounded-[2px] bg-[var(--status-green)]/15 text-[var(--status-green)] font-medium">PRIMARY</span>
            </div>
            <div class="space-y-1 text-[11px] text-[var(--text-muted)]">
              <div class="flex justify-between"><span>REST Sağlık:</span> <span id="ui-card-health-node1" class="text-[var(--status-green)] font-semibold">200 OK</span></div>
              <div class="flex justify-between"><span>Timeline:</span> <span id="ui-card-tl-node1" class="text-[var(--text)] font-semibold">TL 1</span></div>
              <div class="flex justify-between"><span>WAL LSN:</span> <span class="text-[var(--text)]">0/184549384</span></div>
              <div class="flex justify-between"><span>Replication Lag:</span> <span id="ui-card-lag-node1" class="text-[var(--text)]">0 MB</span></div>
            </div>
          </div>

          <!-- Node 2 Card in Dashboard -->
          <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/70 space-y-2" id="ui-box-node2">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-1.5">
              <span class="font-semibold text-[var(--text)]">pg-node-2</span>
              <span id="ui-card-role-node2" class="px-1.5 py-0.5 text-[10px] rounded-[2px] bg-[var(--accent-subtle)] text-[var(--accent)] font-medium">SYNC STANDBY</span>
            </div>
            <div class="space-y-1 text-[11px] text-[var(--text-muted)]">
              <div class="flex justify-between"><span>REST Sağlık:</span> <span id="ui-card-health-node2" class="text-[var(--status-green)] font-semibold">200 OK (replica)</span></div>
              <div class="flex justify-between"><span>Timeline:</span> <span id="ui-card-tl-node2" class="text-[var(--text)] font-semibold">TL 1</span></div>
              <div class="flex justify-between"><span>WAL LSN:</span> <span class="text-[var(--text)]">0/184549384</span></div>
              <div class="flex justify-between"><span>Replication Lag:</span> <span id="ui-card-lag-node2" class="text-[var(--status-green)] font-semibold">0 ms (0 byte)</span></div>
            </div>
          </div>

          <!-- Node 3 Card in Dashboard -->
          <div class="p-3 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/70 space-y-2" id="ui-box-node3">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-1.5">
              <span class="font-semibold text-[var(--text)]">pg-node-3</span>
              <span id="ui-card-role-node3" class="px-1.5 py-0.5 text-[10px] rounded-[2px] bg-[var(--bg)] text-[var(--text-muted)] border border-[var(--border)] font-medium">ASYNC STANDBY</span>
            </div>
            <div class="space-y-1 text-[11px] text-[var(--text-muted)]">
              <div class="flex justify-between"><span>REST Sağlık:</span> <span id="ui-card-health-node3" class="text-[var(--status-green)] font-semibold">200 OK (replica)</span></div>
              <div class="flex justify-between"><span>Timeline:</span> <span id="ui-card-tl-node3" class="text-[var(--text)] font-semibold">TL 1</span></div>
              <div class="flex justify-between"><span>WAL LSN:</span> <span class="text-[var(--text)]">0/184549384</span></div>
              <div class="flex justify-between"><span>Replication Lag:</span> <span id="ui-card-lag-node3" class="text-[var(--text)]">0 byte</span></div>
            </div>
          </div>
        </div>

        <div class="p-2.5 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] text-[11px] text-[var(--text-muted)] font-mono flex items-center gap-2">
          <span>💡</span>
          <span>Açık kaynak <strong class="text-[var(--text)]">Patroni-UI</strong>, <strong class="text-[var(--text)]">Zalando Grafana Dashboard</strong> ve HAProxy Stats (<code class="text-[var(--accent)]">:8404</code>) arayüzleri, Patroni REST API'sini tarayıcı üzerinden izlemek ve tek tıkla failover yönetmek için kullanılır.</span>
        </div>
      </div>
    </div>

    <!-- Architectural Insights Callout -->
    <div class="p-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] flex items-start gap-2.5 text-xs font-mono">
      <span class="text-[var(--accent)] font-bold">⚡ Mimari Çıkarım:</span>
      <span class="text-[var(--text-muted)] font-sans" id="patroni-architecture-note">
        Senkron replikasyon modunda (synchronous_mode: true), pg-node-1 yerel diske yazdığı WAL bloğunu pg-node-2'ye flush ettirmeden istemciye COMMIT yanıtı dönmez. Bu sayede donanım arızalarında RPO (Recovery Point Objective) tam olarak 0'dır.
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const patroniScenarios = {
      sync: {
        desc: "pg-node-1 lider konumunda, pg-node-2 senkron replika olarak işlem taahhütlerini (commit) doğrular, pg-node-3 asenkron olarak takip eder.",
        step1: "HAProxy: Port 5000 -> pg-node-1",
        step2: "/leader -> pg-node-1 (TTL 28s)",
        step3: "loop_wait 10s · Health: 200 OK",
        step4: "Sync Standby: 0 lag (RPO=0)",
        node1: { role: "Primary", roleClass: "bg-[var(--status-green)]/15 text-[var(--status-green)] border-[var(--status-green)]/30", tl: "TL 1", state: "running", stateClass: "text-[var(--status-green)]" },
        node2: { role: "Sync Standby", roleClass: "bg-[var(--accent-subtle)] text-[var(--accent)] border-[var(--accent)]/30", tl: "TL 1", state: "running (0 lag)", stateClass: "text-[var(--status-green)]" },
        node3: { role: "Async Standby", roleClass: "bg-[var(--bg)] text-[var(--text-muted)] border-[var(--border)]", tl: "TL 1", state: "running (0 lag)", stateClass: "text-[var(--status-green)]" },
        uiNode1: { role: "PRIMARY", roleClass: "bg-[var(--status-green)]/15 text-[var(--status-green)]", health: "200 OK", lag: "0 MB" },
        uiNode2: { role: "SYNC STANDBY", roleClass: "bg-[var(--accent-subtle)] text-[var(--accent)]", health: "200 OK (replica)", lag: "0 ms (0 byte)" },
        uiNode3: { role: "ASYNC STANDBY", roleClass: "bg-[var(--bg)] text-[var(--text-muted)] border border-[var(--border)]", health: "200 OK (replica)", lag: "0 byte" },
        quorum: "Quorum: 2/3 (Sağlıklı)",
        cli: `+ Cluster: postgres-ha (7349182391029381023) +---------+
| Member    | Host          | Role    | State   | TL | Lag in MB |
+-----------+---------------+---------+---------+----+-----------+
| pg-node-1 | 192.168.10.11 | Primary | running |  1 |           |
| pg-node-2 | 192.168.10.12 | Sync    | running |  1 |         0 |
| pg-node-3 | 192.168.10.13 | Replica | running |  1 |         0 |
+-----------+---------------+---------+---------+----+-----------+`,
        dcs: `// etcdctl get --prefix /service/postgres-ha/
