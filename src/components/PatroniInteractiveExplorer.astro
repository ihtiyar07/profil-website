        note: "Split-Brain felaketinde iki sunucu da kendisini Primary sanıp farklı istemcilerden yazma kabul ederse veritabanı geri döndürülemez şekilde bozulur. Patroni, etcd lease'i yenilenemediği anda PostgreSQL'i 'immediate' modda öldürür (fencing); asla tek başına yazmaya devam etmesine izin vermez."
      },
      rewind: {
        desc: "Çöken veya izole olan eski primary (pg-node-1) sisteme geri döndü. Timeline farkı pg_rewind ile fork noktasından itibaren otomatik eşitlenir.",
        stepNote1: "pg_rewind yerel timeline 1 ile küme timeline 2 arasındaki ayrışan blokları yeni liderden çekti.",
        stepNote2: "standby.signal dosyasıyla pg-node-1 sıfırdan veri çekmeye gerek kalmadan replika olarak başladı.",
        uiNode1: { role: "REPLICA (REWOUND)", roleClass: "bg-[var(--status-green)]/15 text-[var(--status-green)]", health: "200 OK (replica)", tl: "TL 2", lag: "0 MB" },
        uiNode2: { role: "PRIMARY", roleClass: "bg-[var(--status-green)]/15 text-[var(--status-green)]", health: "200 OK", tl: "TL 2", lag: "0 MB" },
