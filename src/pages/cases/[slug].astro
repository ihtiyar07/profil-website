---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseSlug } from '../../data/slugUtils';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases
    .filter((entry) => entry.data.lang === 'tr')
    .map((entry) => {
      const slug = getCaseSlug(entry);
      return {
        params: { slug },
        props: { entry }
      };
    });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout lang="tr" title={`${entry.data.title} — Ahmet İhtiyar`} description={entry.data.summary}>
  <article class="py-8 sm:py-12 space-y-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="space-y-3 pb-6 border-b border-[var(--border)]">
      <div class="flex items-center justify-between">
        <a href="/#cases" class="font-mono text-xs text-[var(--text-accent)] hover:underline inline-flex items-center gap-1">
          ← Vaka Çalışmalarına Dön ({entry.data.fileNumber})
        </a>
        <span class="font-mono text-xs text-[var(--text-dim)]">
          {entry.data.date}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif text-[var(--text)] tracking-tight">
        {entry.data.title}
      </h1>

      <p class="font-mono text-xs text-[var(--text-muted)]">
        {entry.data.tagline}
      </p>

      <div class="font-mono text-xs text-[var(--text-accent)] pl-3 border-l border-[var(--text-accent)] py-1">
        {entry.data.testedScale}
      </div>

      <div class="font-mono text-xs text-[var(--text-muted)] pt-1">
        <span class="text-[var(--text-dim)]">Yığın: </span>
        <span class="text-[var(--text)]">{entry.data.stack.join(' · ')}</span>
      </div>
    </div>

    <!-- Content -->
    <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-6 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h3]:text-xl [&>h3]:font-serif [&>p]:text-[14px] [&>p]:leading-relaxed [&>p]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ol>li]:my-1.5 [&>ul>li]:my-1 [&>pre]:bg-[var(--bg-code)] [&>pre]:border [&>pre]:border-[var(--border)] [&>pre]:p-4 [&>pre]:rounded-[2px] [&>code]:font-mono">
      <Content />
    </div>

    <!-- Footer Back Link -->
    <div class="pt-8 border-t border-[var(--border)] flex justify-between items-center font-mono text-xs">
      <a href="/#cases" class="text-[var(--text-accent)] hover:underline inline-flex items-center gap-1">
        ← Vaka Çalışmaları Listesi
      </a>
      <a href="mailto:ahmetihtiyar1453@gmail.com" class="text-[var(--text-muted)] hover:text-[var(--accent)] hover:underline">
        Mimariyi Tartışmak İçin E-posta Gönder ↗
      </a>
    </div>
  </article>
</BaseLayout>
