---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseSlug, getPostSlug } from '../../data/slugUtils';
import { SITE_META } from '../../data/siteMeta';
import { getAdjacentNavItems, type FlatNavItem } from '../../data/navigation';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => {
    const slug = getCaseSlug(entry);
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allCases = await getCollection('cases');
const allPosts = await getCollection('posts');
const currentSlug = getCaseSlug(entry);
const currentPath = `/cases/${currentSlug}`;

// Prev and Next documents resolved from the single-source-of-truth sidebar order:
const adjacent = getAdjacentNavItems(currentPath);

function resolveAdjacentDoc(item: FlatNavItem | null) {
  if (!item) return null;
  const post = allPosts.find((p) => `/posts/${getPostSlug(p)}` === item.href);
  const caseItem = allCases.find((c) => `/cases/${getCaseSlug(c)}` === item.href);
  return {
    href: item.href,
    title: post?.data.title || caseItem?.data.title || item.title,
    sectionTitle: item.sectionTitle,
    parentTitle: item.parentTitle
  };
}

const prevDoc = resolveAdjacentDoc(adjacent.prev);
const nextDoc = resolveAdjacentDoc(adjacent.next);

const sortedCases = allCases.sort((a, b) => a.data.fileNumber.localeCompare(b.data.fileNumber));
const otherCases = sortedCases.filter((c) => getCaseSlug(c) !== currentSlug);

const tocHeadings = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3),
  { depth: 2, slug: 'kaynaklar', text: 'Kaynaklar & İleri Okuma' }
];
---

<BaseLayout 
  title={`${entry.data.title} — Ahmet İhtiyar`} 
  description={entry.data.summary}
  fullWidth={true}
>
  <div class="flex-1 w-full flex flex-col xl:flex-row items-stretch relative min-h-screen">
    <!-- Main Case Study Column (Centered with comfortable reading measure) -->
    <div id="case-main-col" class="flex-1 min-w-0 px-5 sm:px-8 lg:px-12 py-6 sm:py-10 transition-all duration-300 flex justify-center">
      <article class="w-full max-w-[860px] space-y-8">
        <!-- Header -->
        <div class="space-y-4 pb-6 border-b border-[var(--border)]">
          <div class="flex items-center justify-between">
            <a
              href="/"
              class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
              aria-label="Ana sayfaya dön"
            >
              <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
              <span>Ana Sayfaya Dön ({entry.data.fileNumber})</span>
            </a>

            <span class="font-mono text-xs text-[var(--text-dim)]" style={`view-transition-name: case-date-${currentSlug};`}>
              {entry.data.date}
            </span>
          </div>

        <h1 class="text-3xl sm:text-4xl lg:text-[2.5rem] font-serif text-[var(--text)] tracking-tight leading-[1.2]" style={`view-transition-name: case-title-${currentSlug};`}>
          {entry.data.title}
        </h1>

        <p class="text-base sm:text-lg text-[var(--text-muted)] font-sans leading-relaxed">
          {entry.data.tagline}
        </p>

        <div class="font-mono text-xs text-[var(--text-accent)] pl-3 border-l-2 border-[var(--accent)] py-1.5 bg-[var(--accent-subtle)]/30 rounded-r-[2px]">
          {entry.data.testedScale}
        </div>

        <div class="flex flex-wrap items-center gap-1.5 pt-1">
          <span class="font-mono text-xs text-[var(--text-dim)] mr-1">Yığın:</span>
          {entry.data.stack.map((tech) => (
            <span class="font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-muted)]">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Mobile/Tablet Inline TOC -->
      {tocHeadings.length > 0 && (
        <div class="xl:hidden p-4 bg-[var(--bg-subtle)]/60 border border-[var(--border)] rounded-[2px] space-y-2">
          <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
            İçindekiler
          </div>
          <nav class="space-y-1 text-xs">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block py-0.5 text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors',
                  h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}

      <!-- Case Study Content with Optimal Reading Typography -->
      <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-8 [&>h2]:pb-2 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h2]:text-[var(--text)] [&>h3]:text-xl [&>h3]:font-serif [&>h3]:pt-4 [&>h3]:pb-1 [&>h3]:text-[var(--text)] [&>p]:text-[15.5px] sm:[&>p]:text-[16px] [&>p]:leading-[1.75] [&>p]:text-[var(--text)] [&_strong]:font-semibold [&_strong]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ul>li]:my-1.5 [&>ol>li]:my-1.5 [&>ul>li]:leading-relaxed [&>ol>li]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-[var(--accent)] [&>blockquote]:pl-4 [&>blockquote]:py-1 [&>blockquote]:italic [&>blockquote]:text-[var(--text-muted)] [&>code]:font-mono [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[13px] [&_:not(pre)>code]:bg-[var(--bg-subtle)] [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-[2px] [&_:not(pre)>code]:border [&_:not(pre)>code]:border-[var(--border)] [&>hr]:border-[var(--border)] [&>hr]:my-8 [&>hr:has(+section#kaynaklar)]:hidden">
        <Content />
      </div>

      <!-- Case Study Bottom Navigation & Discussion -->
      <div class="pt-8 border-t border-[var(--border)] space-y-4">
        <!-- Top bar: Back link + Subtle feedback link -->
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2.5 font-mono text-xs text-[var(--text-dim)]">
          <a
            href="/"
            class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
            aria-label="Ana sayfaya dön"
          >
            <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
            <span>Ana Sayfaya Dön</span>
          </a>

          <a
            href={`mailto:${SITE_META.email}?subject=${encodeURIComponent(`Vaka İncelemesi: ${entry.data.title}`)}`}
            class="hover:text-[var(--text)] hover:underline inline-flex items-center gap-1 transition-colors text-[11px]"
          >
            <span>Mimariyi tartışmak için e-posta gönder</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <!-- Next / Prev Document Navigation Cards -->
        <nav aria-label="Döküman gezintisi" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          {prevDoc ? (
            <a
              href={prevDoc.href}
              class="group px-3.5 py-2.5 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/30 hover:bg-[var(--bg-subtle)]/80 hover:border-[var(--accent-border)] transition-all flex flex-col justify-between gap-1"
            >
              <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors min-w-0">
                <span aria-hidden="true">←</span>
                <span>Önceki</span>
                <span class="text-[var(--border-strong)]">·</span>
                <span class="truncate">{prevDoc.sectionTitle}</span>
              </div>
              <span class="font-sans text-[12.5px] sm:text-[13px] font-medium text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 sm:line-clamp-2 leading-snug transition-colors">
                {prevDoc.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextDoc && (
            <a
              href={nextDoc.href}
              class="group px-3.5 py-2.5 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/30 hover:bg-[var(--bg-subtle)]/80 hover:border-[var(--accent-border)] transition-all flex flex-col justify-between gap-1 text-right sm:col-start-2"
            >
              <div class="flex items-center justify-end gap-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors min-w-0">
                <span class="truncate">{nextDoc.sectionTitle}</span>
                <span class="text-[var(--border-strong)]">·</span>
                <span>Sonraki</span>
                <span aria-hidden="true">→</span>
              </div>
              <span class="font-sans text-[12.5px] sm:text-[13px] font-medium text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 sm:line-clamp-2 leading-snug transition-colors">
                {nextDoc.title}
              </span>
            </a>
          )}
        </nav>
      </div>
    </article>
    </div>

    <!-- Sticky Right Sidebar: Docked flush right with border-l, zero gap on the right, collapsible -->
    <aside 
      id="article-right-panel"
      class="hidden xl:block w-72 2xl:w-80 shrink-0 border-l border-[var(--border)] bg-[var(--bg)] px-5 py-8 space-y-5 self-start sticky top-0 max-h-screen overflow-y-auto transition-all duration-300 select-none"
    >
      <!-- Panel Header -->
      <div class="border-b border-[var(--border)] pb-2 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        <span>Gezinti & Notlar</span>
      </div>

      <!-- TOC Card -->
      {tocHeadings.length > 0 && (
        <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/50 p-4 rounded-[2px] space-y-3">
          <div class="flex items-center gap-1.5 border-b border-[var(--border)] pb-2.5 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <span>İçindekiler</span>
          </div>

          <nav aria-label="İçindekiler" class="space-y-1 text-xs font-sans max-h-[calc(100vh-20rem)] overflow-y-auto pr-1">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-heading-slug={h.slug}
                class:list={[
                  'toc-anchor-link block py-1 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors leading-snug rounded-[2px] px-1.5',
                  h.depth === 3 ? 'pl-4 text-[11.5px] text-[var(--text-dim)]' : 'font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}


      <!-- Other Cases Card -->
      {otherCases.length > 0 && (
        <div class="border border-[var(--border)] bg-[var(--bg-subtle)]/30 p-4 rounded-[2px] space-y-2.5">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] font-semibold border-b border-[var(--border)] pb-2">
            Diğer Vaka Çalışmaları
          </div>
          <div class="space-y-1.5">
            {otherCases.map((other) => (
              <a
                href={`/cases/${getCaseSlug(other)}`}
                class="block group text-xs hover:bg-[var(--bg)] p-1.5 -mx-1.5 rounded-[2px] transition-colors"
              >
                <div class="flex items-center gap-1.5 font-mono text-[10px] text-[var(--text-dim)]">
                  <span class="text-[var(--accent)] font-semibold">{other.data.fileNumber}</span>
                  <span>·</span>
                  <span>{other.data.date}</span>
                </div>
                <span class="font-serif text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 block leading-snug">
                  {other.data.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Jump to Top Link -->
      <div class="pt-1">
        <a
          href="#main-content"
          class="font-mono text-[11px] text-[var(--text-dim)] hover:text-[var(--text)] inline-flex items-center gap-1 transition-colors"
        >
          <span>↑ Başa Dön</span>
        </a>
      </div>
    </aside>
  </div>

  <!-- Table of Contents Scrollspy Script -->
  <script is:inline>
    (function() {
      function initCasePage() {
        // Scrollspy for Table of Contents
        const tocLinks = document.querySelectorAll('.toc-anchor-link');
        if (!tocLinks.length) return;

        const headings = Array.from(document.querySelectorAll('h2[id], h3[id]'));
        if (!headings.length) return;

        function onScroll() {
          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          const windowHeight = window.innerHeight;
          const docHeight = document.documentElement.scrollHeight;
          const isNearBottom = (windowHeight + scrollY) >= (docHeight - 120);

          let currentActive = null;

          if (isNearBottom) {
            // When scrolled near or to the bottom of the page, choose the last visible heading
            for (let i = headings.length - 1; i >= 0; i--) {
              const rect = headings[i].getBoundingClientRect();
              if (rect.top < windowHeight - 40) {
                currentActive = headings[i].id;
                break;
              }
            }
            if (!currentActive && headings.length > 0) {
              currentActive = headings[headings.length - 1].id;
            }
          } else {
            // Normal reading line: heading passing 140px threshold
            const threshold = 140;
            for (let i = 0; i < headings.length; i++) {
              const rect = headings[i].getBoundingClientRect();
              if (rect.top <= threshold) {
                currentActive = headings[i].id;
              } else {
                break;
              }
            }
            if (!currentActive && headings.length > 0) {
              currentActive = headings[0].id;
            }
          }

          let activeLink = null;
          tocLinks.forEach(link => {
            const slug = link.getAttribute('data-heading-slug');
            if (slug === currentActive) {
              link.classList.add('bg-[var(--bg)]', 'text-[var(--accent)]', 'font-semibold', 'border-l-2', 'border-[var(--accent)]', 'pl-2');
              activeLink = link;
            } else {
              link.classList.remove('bg-[var(--bg)]', 'text-[var(--accent)]', 'font-semibold', 'border-l-2', 'border-[var(--accent)]', 'pl-2');
            }
          });

          // Auto-scroll active item into view inside the TOC container if needed
          if (activeLink) {
            activeLink.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
        }

        // Add instant click sync to all TOC links
        tocLinks.forEach(link => {
          link.addEventListener('click', () => {
            setTimeout(onScroll, 80);
          });
        });

        window.removeEventListener('scroll', window.__caseScrollHandler);
        window.__caseScrollHandler = onScroll;
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCasePage);
      } else {
        initCasePage();
      }
      document.addEventListener('astro:page-load', initCasePage);
    })();
  </script>
</BaseLayout>
