---
import { SITE_META } from '../data/siteMeta';
---

<section id="contact" class="py-8 sm:py-10 scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-1.5 mb-6 max-w-2xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      İletişim
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-muted)] font-sans leading-relaxed">
      İlişkisel veritabanları, depolama motorları ve sorgu optimizasyonu konularında doğrudan ulaşabilirsiniz.
    </p>
  </div>

  <!-- Direct Channels Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
    <!-- Email Channel -->
    <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]/35 hover:border-[var(--accent-border)] hover:bg-[var(--bg-subtle)]/65 transition-all p-5 flex flex-col justify-between gap-4">
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider font-semibold text-[var(--text-accent)]">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>E-posta</span>
        </span>
        <button
          type="button"
          id="copy-contact-email-btn"
          class="px-2 py-0.5 rounded-md bg-[var(--bg)] border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--border-strong)] transition-colors cursor-pointer text-[11px] font-mono tactile-btn inline-flex items-center"
          aria-label="E-postayı kopyala"
        >
          <span class="copy-email-label">Kopyala</span>
        </button>
      </div>

      <div class="font-mono text-[13.5px] sm:text-sm font-medium text-[var(--text)] truncate" title={SITE_META.email}>
        {SITE_META.email}
      </div>

      <div>
        <a
          href={`mailto:${SITE_META.email}`}
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>E-posta Gönder</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- GitHub Channel -->
    <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]/35 hover:border-[var(--accent-border)] hover:bg-[var(--bg-subtle)]/65 transition-all p-5 flex flex-col justify-between gap-4">
      <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
      </div>

      <div class="font-mono text-[13.5px] sm:text-sm font-medium text-[var(--text)]">
        github.com/ihtiyar07
      </div>

      <div>
        <a
          href={SITE_META.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>Açık Kaynak Kodlar</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- LinkedIn Channel -->
    <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]/35 hover:border-[var(--accent-border)] hover:bg-[var(--bg-subtle)]/65 transition-all p-5 flex flex-col justify-between gap-4">
      <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
        </svg>
        <span>LinkedIn</span>
      </div>

      <div class="font-mono text-[13.5px] sm:text-sm font-medium text-[var(--text)]">
        in/ahmet-ihtiyar
      </div>

      <div>
        <a
          href={SITE_META.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 hover:underline"
        >
          <span>Bağlantı Kur</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Email Copy Script -->
<script is:inline>
  (function() {
    function initContactCopy() {
      const copyBtn = document.getElementById('copy-contact-email-btn');
      if (!copyBtn) return;
      copyBtn.onclick = async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const email = 'ahmetihtiyar1453@gmail.com';
        const label = copyBtn.querySelector('.copy-email-label');
        try {
          await navigator.clipboard.writeText(email);
          if (label) label.textContent = 'Kopyalandı';
          if (typeof window.showToast === 'function') {
            window.showToast('E-posta panoya kopyalandı');
          }
          setTimeout(() => {
            if (label) label.textContent = 'Kopyala';
          }, 2000);
        } catch (_) {
          prompt('E-posta:', email);
        }
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactCopy);
    } else {
      initContactCopy();
    }
    document.addEventListener('astro:page-load', initContactCopy);
  })();
</script>
