---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE_META } from '../data/siteMeta';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  articleMeta?: {
    publishDate: string;
    tags: string[];
  };
  fullWidth?: boolean;
}

const {
  title = SITE_META.title,
  description = SITE_META.bioShort,
  canonicalPath = '',
  articleMeta,
  fullWidth = false
} = Astro.props;

const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, SITE_META.siteUrl).toString();

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImagePath = cleanPath === '' 
  ? '/og/index.png' 
  : `/og/${cleanPath}.png`;
const ogImageUrl = new URL(ogImagePath, SITE_META.siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmet İhtiyar",
  "url": SITE_META.siteUrl,
  "jobTitle": "Veritabanı & Depolama",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "İstanbul",
    "addressCountry": "TR"
  },
  "sameAs": [
    SITE_META.github,
    SITE_META.linkedin
  ],
  "knowsAbout": [
    "Database Architecture",
    "PostgreSQL Internals",
    "Oracle Database Optimization",
    "TimescaleDB & Hypertables",
    "Storage Engines & ZFS",
    "Zero-Impact Metadata Extraction",
    "Memgraph Schema Lineage",
    "Apache Arrow IPC",
    "Distributed Systems",
    "Query Performance Tuning"
  ]
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ahmet İhtiyar" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ahmet İhtiyar — Veritabanı Mimarisi Yazıları" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Astro ClientRouter for View Transitions & Morphing -->
    <ClientRouter />

    <!-- Instant FOUC prevention for light/dark theme -->
    <script is:inline>
      (function() {
        function resolveTheme() {
          try {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            return (stored === 'dark' || (!stored && prefersDark)) ? 'dark' : 'light';
          } catch (_) {
            return 'light';
          }
        }
        function applyThemeToDoc(doc) {
          const theme = resolveTheme();
          if (doc?.documentElement && doc.documentElement.getAttribute('data-theme') !== theme) {
            doc.documentElement.setAttribute('data-theme', theme);
          }
        }
        applyThemeToDoc(document);
        document.addEventListener('astro:before-swap', (e) => {
          applyThemeToDoc(e.newDocument);
        });
        document.addEventListener('astro:after-swap', () => {
          applyThemeToDoc(document);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)]">
    <!-- Top Route Progress Bar for Cinematic View Transitions -->
    <div
      id="route-progress-bar"
      class="fixed top-0 left-0 h-[2px] bg-[var(--accent)] z-[999] pointer-events-none opacity-0 w-0"
      aria-hidden="true"
    ></div>

    <a href="#main-content" class="skip-link">
      Ana içeriğe atla
    </a>

    <!-- Full-Width Shell: Topic Sidebar on the left + Expanded Main Column on the right -->
    <div class="min-h-screen flex flex-col md:flex-row">
      <!-- Topic Tree Sidebar (Desktop sticky sidebar + Mobile responsive header) -->
      <Sidebar />

      <!-- Main Column: Fills the remaining screen with generous width, eliminating empty space -->
      <div class="flex-1 min-w-0 flex flex-col min-h-screen" style="view-transition-name: page-content;">
        <main id="main-content" class:list={[
          "flex-1 w-full",
          fullWidth ? "flex flex-col" : "max-w-[1140px] w-full mx-auto px-5 sm:px-8 lg:px-10 py-6 sm:py-10"
        ]}>
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- Global Accessible Toast Notification -->
    <div id="global-toast" role="status" aria-live="polite">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span id="toast-message"></span>
    </div>

    <script is:inline>
      window.showToast = function(msg, duration = 2500) {
        const toast = document.getElementById('global-toast');
        const text = document.getElementById('toast-message');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.add('toast-show');
        if (window.__toastTimeout) clearTimeout(window.__toastTimeout);
        window.__toastTimeout = setTimeout(() => {
          toast.classList.remove('toast-show');
        }, duration);
      };

      // Universal clean copy header for all article code blocks
      (function() {
        function setupArticlePreCopy() {
          document.querySelectorAll('.prose pre, article pre').forEach((pre) => {
            if (pre.closest('.pre-copy-wrapper') || pre.closest('[data-no-auto-copy]') || pre.closest('.not-prose')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'relative group pre-copy-wrapper';
            pre.parentNode?.insertBefore(wrapper, pre);

            // Detect language label from Shiki data-language or className
            const codeEl = pre.querySelector('code');
            let langLabel = pre.getAttribute('data-language') || '';
            if (!langLabel) {
              const langMatch = (codeEl?.className || pre.className).match(/language-([a-zA-Z0-9_-]+)/);
              langLabel = langMatch?.[1] || 'kod';
            }

            // Dedicated Top Header Bar (never overlaps code or shrinks horizontal width)
            const header = document.createElement('div');
            header.className = 'pre-code-header';

            const langBadge = document.createElement('span');
            langBadge.className = 'font-mono text-[11px] uppercase tracking-wider text-[#8b949e]';
            langBadge.textContent = langLabel;

            const btnCopy = document.createElement('button');
            btnCopy.type = 'button';
            btnCopy.className = 'px-2.5 py-0.5 rounded-[2px] bg-[#21262d] border border-[#30363d] text-[#c9d1d9] hover:text-white hover:border-[#8b949e] text-[11px] font-mono cursor-pointer tactile-btn transition-colors';
            btnCopy.setAttribute('aria-label', 'Kodu kopyala');
            btnCopy.textContent = 'Kopyala';

            btnCopy.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btnCopy.textContent = 'Kopyalandı';
                btnCopy.classList.add('text-[var(--status-green)]', 'border-[var(--status-green)]');
                if (typeof window.showToast === 'function') {
                  window.showToast('Kod panoya kopyalandı');
                }
                setTimeout(() => {
                  btnCopy.textContent = 'Kopyala';
                  btnCopy.classList.remove('text-[var(--status-green)]', 'border-[var(--status-green)]');
                }, 2000);
              } catch (_) {
                prompt('Kod:', code);
              }
            });

            header.appendChild(langBadge);
            header.appendChild(btnCopy);
            wrapper.appendChild(header);
            wrapper.appendChild(pre);
          });
        }

        function setupResponsiveTables() {
          document.querySelectorAll('.prose table, article table').forEach((table) => {
            if (table.closest('.table-responsive-wrapper')) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          });
        }

        function initArticleEnhancements() {
          setupArticlePreCopy();
          setupResponsiveTables();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initArticleEnhancements);
        } else {
          initArticleEnhancements();
        }
        document.addEventListener('astro:page-load', initArticleEnhancements);

        // Progress bar choreography for View Transitions
        document.addEventListener('astro:before-preparation', () => {
          const bar = document.getElementById('route-progress-bar');
          if (bar) {
            bar.style.transition = 'width 280ms ease, opacity 100ms ease';
            bar.style.opacity = '1';
            bar.style.width = '70%';
          }
        });

        document.addEventListener('astro:page-load', () => {
          const bar = document.getElementById('route-progress-bar');
          if (bar) {
            bar.style.width = '100%';
            setTimeout(() => {
              bar.style.opacity = '0';
              setTimeout(() => {
                bar.style.transition = 'none';
                bar.style.width = '0%';
              }, 200);
            }, 150);
          }
        });
      })();
    </script>
  </body>
</html>
