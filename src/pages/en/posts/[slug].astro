---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((entry) => entry.data.lang === 'en')
    .map((entry) => {
      const slug = entry.id.replace(/en$/, '');
      return {
        params: { slug },
        props: { entry }
      };
    });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout 
  lang="en" 
  title={`${entry.data.title} — Ahmet İhtiyar`} 
  description={entry.data.summary}
  articleMeta={{ publishDate: entry.data.date, tags: entry.data.tags }}
>
  <article class="py-8 sm:py-12 space-y-8 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="space-y-4 pb-6 border-b border-[var(--border)]">
      <div class="flex items-center justify-between">
        <a href="/en#writing" class="font-mono text-xs text-[#E8590C] hover:underline inline-flex items-center gap-1">
          ← Back to Articles
        </a>
        <div class="font-mono text-xs text-[var(--text-dim)] flex items-center gap-2">
          <span>{entry.data.date}</span>
          <span>·</span>
          <span>{entry.data.readingTime}</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif text-[var(--text)] tracking-tight leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
        {entry.data.summary}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {entry.data.tags.map((tag) => (
          <span class="font-mono text-[11px] px-2 py-0.5 bg-[var(--bg-code)] text-[var(--text-muted)] border border-[var(--border)] rounded-[2px]">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Article Content -->
    <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-6 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h3]:text-xl [&>h3]:font-serif [&>p]:text-[14px] [&>p]:leading-relaxed [&>p]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>pre]:bg-[var(--bg-code)] [&>pre]:border [&>pre]:border-[var(--border)] [&>pre]:p-4 [&>pre]:rounded-[2px] [&>code]:font-mono">
      <Content />
    </div>

    <!-- Footer Back Link -->
    <div class="pt-8 border-t border-[var(--border)] flex justify-between items-center font-mono text-xs">
      <a href="/en#writing" class="text-[#E8590C] hover:underline inline-flex items-center gap-1">
        ← Back to Writing
      </a>
      <a href="mailto:ahmetihtiyar1453@gmail.com" class="text-[var(--text-muted)] hover:text-[#E8590C] hover:underline">
        Email Feedback on this Article ↗
      </a>
    </div>
  </article>
</BaseLayout>
