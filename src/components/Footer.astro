---
import { SITE_META } from '../data/siteMeta';
---

<footer class="w-full border-t border-[var(--border)] bg-[var(--bg)] text-xs font-mono py-8 transition-colors">
  <div class="w-full px-6 sm:px-10 lg:px-12 xl:px-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[var(--text-muted)]">
      <!-- Identity & Scope -->
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] shrink-0" aria-hidden="true"></span>
        <span class="font-semibold text-[var(--text)]">Ahmet İhtiyar</span>
        <span class="text-[var(--text-dim)]">·</span>
        <span class="text-[var(--text-muted)]">Veritabanı & Depolama Notları</span>
        <span class="text-[var(--text-dim)] hidden md:inline">·</span>
        <span class="text-[var(--text-dim)] hidden md:inline">İstanbul, Türkiye</span>
      </div>

      <!-- Links & Navigation -->
      <div class="flex flex-wrap items-center gap-4 text-[var(--text-dim)] text-[11.5px]">
        <a 
          href={SITE_META.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[var(--text)] transition-colors"
        >
          GitHub ↗
        </a>
        <a 
          href={SITE_META.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[var(--text)] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a 
          href={`mailto:${SITE_META.email}`} 
          class="hover:text-[var(--text)] transition-colors"
        >
          E-posta
        </a>
        <a 
          href="/rss.xml" 
          class="hover:text-[var(--text)] transition-colors"
        >
          RSS
        </a>
        <span class="text-[var(--border)]">|</span>
        <a 
          href="#main-content" 
          class="hover:text-[var(--text)] transition-colors inline-flex items-center gap-1"
        >
          <span>Başa Dön</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
