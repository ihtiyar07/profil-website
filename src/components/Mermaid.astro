---
interface TabItem {
  id: string;
  label: string;
  code: string;
  ariaLabel?: string;
  summarySteps?: string[];
}

interface Props {
  code?: string;
  title?: string;
  tabs?: TabItem[];
  ariaLabel?: string;
  summarySteps?: string[];
}

const { code, title, tabs, ariaLabel, summarySteps } = Astro.props;
const uniqueId = `mermaid-${Math.random().toString(36).substring(2, 9)}`;
const isTabbed = Array.isArray(tabs) && tabs.length > 0;
---

<figure class="mermaid-container relative my-6 not-prose border border-[var(--border)] rounded-[2px] bg-[var(--bg-card)] shadow-xs" id={uniqueId}>
  <!-- Top Bar -->
  <div class="px-3 sm:px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-subtle)] flex items-center justify-between gap-2 text-xs font-mono text-[var(--text-dim)] select-none">
    <span class="flex items-center gap-2 font-medium text-[var(--text)] truncate">
      <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
      <span class="mermaid-container-title truncate">{title || 'Mimari Şema'}</span>
    </span>

    <div class="flex items-center gap-1.5 shrink-0">
      <span class="text-[10px] text-[var(--text-dim)] border border-[var(--border)] px-1.5 py-0.5 rounded-[2px] bg-[var(--bg)] hidden sm:flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        <span>Bileşen detayları için tıkla</span>
      </span>

      <!-- Fullscreen / Zoom Button -->
      <button 
        type="button" 
        class="mermaid-fullscreen-btn flex items-center gap-1.5 text-[11px] font-mono text-[var(--text-dim)] hover:text-[var(--text)] border border-[var(--border)] px-2 py-0.5 rounded-[2px] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer shrink-0"
        aria-label="Şemayı tam ekran aç"
        title="Tam ekran aç (ESC ile kapat)"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
        </svg>
        <span>Tam Ekran</span>
      </button>
    </div>
  </div>

  <!-- Tabs Header (if tabbed) -->
  {isTabbed && (
    <div 
      role="tablist" 
      aria-label="Mimari Şema Sekmeleri" 
      class="mermaid-tablist flex items-center gap-1 px-3 py-1.5 border-b border-[var(--border)] bg-[var(--bg)]/60 overflow-x-auto scrollbar-none text-xs font-mono select-none"
    >
      {tabs.map((tab, idx) => (
        <button
          type="button"
          role="tab"
          id={`${uniqueId}-tab-${tab.id}`}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`${uniqueId}-pane-${tab.id}`}
          tabindex={idx === 0 ? 0 : -1}
          data-tab-id={tab.id}
          class={`mermaid-tab-btn px-3 py-1.5 rounded-[2px] transition-all cursor-pointer border whitespace-nowrap text-xs ${
            idx === 0
              ? "bg-[var(--bg-card)] text-[var(--accent)] font-semibold border-[var(--border)] shadow-xs"
              : "text-[var(--text-dim)] hover:text-[var(--text)] border-transparent hover:bg-[var(--bg-subtle)]"
          }`}
        >
          {tab.label}
        </button>
      ))}
    </div>
  )}

  <!-- Diagram Content Area -->
  <div class="mermaid-diagrams-wrap relative p-3 sm:p-5 overflow-x-auto flex justify-center items-center min-h-[120px] bg-[var(--bg-subtle)]/30">
    {isTabbed ? (
      tabs.map((tab, idx) => (
        <div
          role="tabpanel"
          id={`${uniqueId}-pane-${tab.id}`}
          aria-labelledby={`${uniqueId}-tab-${tab.id}`}
          tabindex={0}
          class={`mermaid-tabpane w-full ${idx === 0 ? "block" : "hidden"}`}
        >
          <div 
            class="mermaid-diagram w-full flex justify-center" 
            id={`${uniqueId}-${tab.id}`} 
            data-code={tab.code}
            role="img"
            aria-label={tab.ariaLabel || `${tab.label} Şeması`}
          >
            <div class="mermaid-loading flex items-center justify-center py-10 px-4 text-xs font-mono text-[var(--text-dim)] gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
              <span>Şema yükleniyor...</span>
            </div>
          </div>
        </div>
      ))
    ) : (
      <div 
        class="mermaid-diagram w-full flex justify-center" 
        id={`${uniqueId}-diagram`} 
        data-code={code}
        role="img"
        aria-label={ariaLabel || title || "Mimari Şema"}
      >
        <div class="mermaid-loading flex items-center justify-center py-10 px-4 text-xs font-mono text-[var(--text-dim)] gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
          <span>Mimari şema yükleniyor...</span>
        </div>
      </div>
    )}
  </div>

  <!-- Fixed Component Details Panel (Underneath the diagram) -->
  <div class="mermaid-details-panel border-t border-[var(--border)] bg-[var(--bg-card)] p-3.5 sm:p-4 text-left transition-colors">
    <div class="details-default-view flex items-center justify-between text-xs font-mono text-[var(--text-dim)]">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        <span class="font-medium text-[var(--text)]">Bileşen Detayı:</span>
        <span class="text-[var(--text-dim)]">Bir bileşene tıklayın</span>
      </div>
      <span class="text-[10px] text-[var(--text-dim)] hidden sm:inline">Enter/Tıkla: Detay Göster · ESC: Temizle</span>
    </div>

    <div class="details-active-view hidden space-y-2">
      <div class="flex items-start justify-between gap-3 border-b border-[var(--border)] pb-2">
        <div>
          <span class="details-role font-mono text-[10px] uppercase tracking-wider text-[var(--accent)] font-semibold block"></span>
          <h4 class="details-title font-serif text-base font-semibold text-[var(--text)] leading-tight"></h4>
        </div>
        <button 
          type="button" 
          class="details-reset-btn text-[var(--text-dim)] hover:text-[var(--text)] border border-[var(--border)] px-1.5 py-0.5 rounded-[2px] text-[10px] font-mono cursor-pointer transition-colors bg-[var(--bg-subtle)]"
          aria-label="Detay panelini sıfırla"
        >
          Temizle
        </button>
      </div>
      <p class="details-desc text-xs sm:text-[13px] text-[var(--text-muted)] leading-relaxed font-sans"></p>
      <div class="details-extra text-[11px] font-mono text-[var(--text-dim)] bg-[var(--bg-subtle)] p-2 rounded-[2px] border border-[var(--border)] hidden"></div>
    </div>
  </div>

  <!-- Collapsible Textual Summary (Accessibility details/summary) -->
  <div class="mermaid-text-summaries border-t border-[var(--border)] bg-[var(--bg-subtle)]/40 text-xs font-mono">
    {isTabbed ? (
      tabs.map((tab, idx) => (
        tab.summarySteps && tab.summarySteps.length > 0 ? (
          <details 
            class={`mermaid-text-summary px-4 py-2 text-[var(--text-dim)] ${idx === 0 ? "block" : "hidden"}`} 
            data-summary-for={tab.id}
          >
            <summary class="cursor-pointer hover:text-[var(--text)] transition-colors select-none font-medium flex items-center gap-1.5">
              <span>Metin olarak oku: {tab.label} adımları</span>
            </summary>
            <ol class="mt-2.5 space-y-1.5 list-decimal pl-5 text-[var(--text-muted)] font-sans leading-relaxed text-xs">
              {tab.summarySteps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </details>
        ) : null
      ))
    ) : summarySteps && summarySteps.length > 0 ? (
      <details class="mermaid-text-summary px-4 py-2 text-[var(--text-dim)]">
        <summary class="cursor-pointer hover:text-[var(--text)] transition-colors select-none font-medium flex items-center gap-1.5">
          <span>Metin olarak oku (Şema Adımları)</span>
        </summary>
        <ol class="mt-2.5 space-y-1.5 list-decimal pl-5 text-[var(--text-muted)] font-sans leading-relaxed text-xs">
          {summarySteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </details>
    ) : null}
  </div>

  <!-- Fullscreen Modal Container -->
  <div 
    class="mermaid-modal fixed inset-0 z-[200] hidden bg-[var(--bg)]/95 backdrop-blur-md flex flex-col p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Tam Ekran Mimari Şema"
  >
    <div class="flex items-center justify-between border-b border-[var(--border)] pb-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        <h3 class="font-mono text-sm font-semibold text-[var(--text)] modal-title">{title || 'Mimari Şema (Tam Ekran)'}</h3>
      </div>
      <button 
        type="button" 
        class="modal-close-btn flex items-center gap-1.5 text-xs font-mono text-[var(--text-dim)] hover:text-[var(--text)] border border-[var(--border)] px-2.5 py-1 rounded-[2px] bg-[var(--bg-subtle)] hover:bg-[var(--bg)] transition-colors cursor-pointer"
        aria-label="Tam ekranı kapat"
      >
        <span>Kapat (ESC)</span>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <div class="flex-1 overflow-auto flex items-center justify-center p-2 modal-content">
      <!-- Active SVG injected here -->
    </div>
  </div>
</figure>

<style is:global>
  .mermaid-diagram {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .mermaid-diagram svg {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-width: 0 !important;
    display: block;
    margin: 0 auto;
  }
  .mermaid-diagram svg .node {
    cursor: pointer;
    transition: stroke 0.15s ease, filter 0.15s ease;
  }
  .mermaid-diagram svg .node:hover rect,
  .mermaid-diagram svg .node:hover polygon,
  .mermaid-diagram svg .node:hover circle,
  .mermaid-diagram svg .node:hover path {
    stroke: var(--accent) !important;
    stroke-width: 2px !important;
  }
  .mermaid-diagram svg .node.selected-node rect,
  .mermaid-diagram svg .node.selected-node polygon,
  .mermaid-diagram svg .node.selected-node circle,
  .mermaid-diagram svg .node.selected-node path {
    stroke: var(--accent) !important;
    stroke-width: 2.5px !important;
    filter: drop-shadow(0 1px 4px var(--accent-subtle));
  }
  .mermaid-diagram svg text {
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 14px !important;
  }

  /* Light Theme ClassDef Palettes */
  .mermaid-diagram svg .node.process > rect,
  .mermaid-diagram svg .node.process > polygon,
  .mermaid-diagram svg .node.process > circle {
    fill: #EFF6FF !important;
    stroke: #2563EB !important;
    stroke-width: 1.5px !important;
  }
  .mermaid-diagram svg .node.process text {
    fill: #0F172A !important;
  }

  .mermaid-diagram svg .node.memory > rect,
  .mermaid-diagram svg .node.memory > polygon,
  .mermaid-diagram svg .node.memory > circle {
    fill: #F0FDFA !important;
    stroke: #0D9488 !important;
    stroke-width: 1.5px !important;
  }
  .mermaid-diagram svg .node.memory text {
    fill: #042F2E !important;
  }

  .mermaid-diagram svg .node.storage > rect,
  .mermaid-diagram svg .node.storage > polygon,
  .mermaid-diagram svg .node.storage > circle,
  .mermaid-diagram svg .node.storage > path {
    fill: #F5F5F4 !important;
    stroke: #78716C !important;
    stroke-width: 1.5px !important;
  }
  .mermaid-diagram svg .node.storage text {
    fill: #292524 !important;
  }

  .mermaid-diagram svg .node.primary > rect,
  .mermaid-diagram svg .node.primary > polygon,
  .mermaid-diagram svg .node.primary > circle {
    stroke: var(--accent) !important;
    stroke-width: 2.5px !important;
  }

  .mermaid-diagram svg .node.primaryMem > rect,
  .mermaid-diagram svg .node.primaryMem > polygon,
  .mermaid-diagram svg .node.primaryMem > circle {
    fill: #F0FDFA !important;
    stroke: var(--accent) !important;
    stroke-width: 2.5px !important;
  }

  /* Dark Theme Overrides */
  html[data-theme="dark"] .mermaid-diagram svg .node.process > rect,
  html[data-theme="dark"] .mermaid-diagram svg .node.process > polygon,
  html[data-theme="dark"] .mermaid-diagram svg .node.process > circle {
    fill: #1E293B !important;
    stroke: #60A5FA !important;
    stroke-width: 1.5px !important;
  }
  html[data-theme="dark"] .mermaid-diagram svg .node.process text {
    fill: #F8FAFC !important;
  }

  html[data-theme="dark"] .mermaid-diagram svg .node.memory > rect,
  html[data-theme="dark"] .mermaid-diagram svg .node.memory > polygon,
  html[data-theme="dark"] .mermaid-diagram svg .node.memory > circle {
    fill: #134E4A !important;
    stroke: #2DD4BF !important;
    stroke-width: 1.5px !important;
  }
  html[data-theme="dark"] .mermaid-diagram svg .node.memory text {
    fill: #F0FDFA !important;
  }

  html[data-theme="dark"] .mermaid-diagram svg .node.storage > rect,
  html[data-theme="dark"] .mermaid-diagram svg .node.storage > polygon,
  html[data-theme="dark"] .mermaid-diagram svg .node.storage > circle,
  html[data-theme="dark"] .mermaid-diagram svg .node.storage > path {
    fill: #292524 !important;
    stroke: #A8A29E !important;
    stroke-width: 1.5px !important;
  }
  html[data-theme="dark"] .mermaid-diagram svg .node.storage text {
    fill: #F5F5F4 !important;
  }

  html[data-theme="dark"] .mermaid-diagram svg .node.primary > rect,
  html[data-theme="dark"] .mermaid-diagram svg .node.primary > polygon,
  html[data-theme="dark"] .mermaid-diagram svg .node.primary > circle {
    stroke: var(--accent) !important;
    stroke-width: 2.5px !important;
  }

  html[data-theme="dark"] .mermaid-diagram svg .node.primaryMem > rect,
  html[data-theme="dark"] .mermaid-diagram svg .node.primaryMem > polygon,
  html[data-theme="dark"] .mermaid-diagram svg .node.primaryMem > circle {
    fill: #134E4A !important;
    stroke: var(--accent) !important;
    stroke-width: 2.5px !important;
  }
</style>

<script>
  import mermaid from 'mermaid';

  const EXPLANATIONS: Record<string, { title: string; role: string; desc: string; detail?: string }> = {
    // PostgreSQL
    'postmaster': {
      title: 'Postmaster (Ana Süreç)',
      role: 'PostgreSQL Çekirdek Süreci',
