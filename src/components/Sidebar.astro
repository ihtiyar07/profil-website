---
import { SITE_META } from '../data/siteMeta';

interface NavArticleItem {
  title: string;
  href: string;
}

interface NavSection {
  id: string;
  title: string;
  items: NavArticleItem[];
}

const navSections: NavSection[] = [
  {
    id: 'postgresql',
    title: 'PostgreSQL',
    items: [
      {
        title: 'PostgREST: Sıfır Kodla REST API',
        href: '/posts/postgrest-ile-postgresql-uzerinden-aninda-rest-api'
      },
      {
        title: 'TimescaleDB Continuous Aggregates',
        href: '/posts/timescaledb-continuous-aggregates-ve-retention-pratikte'
      },
      {
        title: 'TimescaleDB & Hypertables Mimarisi',
        href: '/cases/timescaledb'
      },
      {
        title: 'MetaDB: Zero-Lock Katalog Analizi',
        href: '/cases/metadb'
      }
    ]
  },
  {
    id: 'oracle',
    title: 'Oracle DB',
    items: [
      {
        title: 'AWR ve ASH ile Darboğaz Tespiti',
        href: '/posts/awr-ve-ash-ile-bir-oracle-darbogazini-bulmak'
      },
      {
        title: 'MetaDB: Canlı Sistemde Sıfır Kilit',
        href: '/cases/metadb'
      }
    ]
  },
  {
    id: 'storage',
    title: 'Depolama & Altyapı',
    items: [
      {
        title: 'Arrow ile DB\'den Zero-Copy Akış',
        href: '/posts/arrow-ile-dbden-tarayiciya-zero-copy'
      },
      {
        title: 'Apache Arrow Mimari Vaka Dosyası',
        href: '/cases/apache-arrow'
      },
      {
        title: 'Proxmox VE: Ağ, NAT ve ZFS',
        href: '/posts/dedicated-sunucuya-sifirdan-proxmox-ag-ve-firewall-notlari'
      },
      {
        title: 'JWT vs Redis ile O(1) Yetki İptali',
        href: '/posts/jwtde-yetki-tasimak-neden-her-zaman-iyi-fikir-degil'
      }
    ]
  },
  {
    id: 'general',
    title: 'Genel Sayfalar',
    items: [
      {
        title: 'Ana Sayfa',
        href: '/'
      },
      {
        title: 'Yazılar & Notlar',
        href: '/#articles'
      },
      {
        title: 'Sistem Mimarileri',
        href: '/#systems'
      },
      {
        title: 'Diğer Çalışmalar',
        href: '/#secondary-projects'
      },
      {
        title: 'İletişim & Kanallar',
        href: '/#contact'
      }
    ]
  }
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!-- Desktop Sticky Sidebar (Left Column) -->
<aside class="hidden lg:flex flex-col w-64 xl:w-72 shrink-0 h-screen sticky top-0 border-r border-[var(--border)] bg-[var(--bg)] overflow-y-auto select-none transition-colors z-30">
  <div class="p-5 flex flex-col justify-between min-h-full">
    <!-- Top: Identity & Collapsible Topic Tree -->
    <div class="space-y-6">
      <!-- Identity & Brand Header -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Ahmet İhtiyar — Ana Sayfa">
        <picture class="shrink-0">
          <source srcset="/profile.webp" type="image/webp" />
          <img
            src="/profile.png"
            alt="Ahmet İhtiyar"
            width="36"
            height="36"
            class="w-9 h-9 rounded-[2px] object-cover grayscale contrast-105 border border-[var(--border)] group-hover:grayscale-0 transition-all duration-300"
          />
        </picture>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)] shrink-0"></span>
            <span class="font-sans text-xs font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors truncate">
              Ahmet İhtiyar
            </span>
          </div>
          <p class="font-mono text-[11px] text-[var(--text-dim)] truncate">
            Veritabanı & Depolama
          </p>
        </div>
      </a>

      <!-- Collapsible Topic Tree Navigation -->
      <nav aria-label="Konu ve Yazı Ağacı" class="space-y-4">
        {navSections.map((section) => {
          // Check if any child item matches current path
          const hasActiveChild = section.items.some(item => {
            const cleanHref = item.href.replace(/\/+$/, '') || '/';
            return cleanHref === currentPath;
          });

          return (
            <div class="sidebar-accordion-group border-b border-[var(--border)]/60 pb-3 last:border-b-0">
              <!-- Accordion Toggle Header -->
              <button
                type="button"
                class="sidebar-accordion-btn w-full flex items-center justify-between px-2 py-1.5 text-[11px] font-mono font-semibold uppercase tracking-wider text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors rounded-[2px] cursor-pointer focus:outline-none"
                aria-expanded="true"
                data-section-id={section.id}
              >
                <span class="flex items-center gap-1.5">
                  <svg class="chevron-icon w-3 h-3 text-[var(--text-dim)] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                  <span class="text-[var(--text-muted)] font-medium">{section.title}</span>
                </span>
                <span class="text-[10px] font-mono text-[var(--text-dim)] opacity-70">
                  {section.items.length}
                </span>
              </button>

              <!-- Collapsible Article Links List (Direct Links to Posts/Cases) -->
              <div class="sidebar-accordion-content space-y-0.5 pl-2.5 pt-1">
                {section.items.map((item) => {
                  const cleanHref = item.href.replace(/\/+$/, '') || '/';
                  const isActive = cleanHref === currentPath && currentPath !== '/';

                  return (
                    <a
                      href={item.href}
                      class:list={[
                        'sidebar-article-link flex items-center justify-between px-2 py-1.5 rounded-[2px] text-xs font-sans transition-colors group',
                        isActive
                          ? 'bg-[var(--bg-subtle)] text-[var(--accent)] font-semibold border-l-2 border-[var(--accent)] pl-2'
                          : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]'
                      ]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <span class="truncate">{item.title}</span>
                      <span class="text-[10px] font-mono text-[var(--text-dim)] opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">→</span>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })}
      </nav>
    </div>

    <!-- Bottom: Theme Switcher & Social Links -->
    <div class="pt-4 mt-6 border-t border-[var(--border)] space-y-3">
      <!-- Theme Switch Button -->
      <button
        type="button"
        class="theme-toggle-btn w-full px-2.5 py-1.5 text-xs font-mono rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors cursor-pointer flex items-center justify-between"
        aria-label="Temayı Değiştir"
      >
        <span class="flex items-center gap-2">
          <svg class="theme-icon-sun w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon-moon w-3.5 h-3.5 hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="theme-label">Görünüm</span>
        </span>
        <span class="theme-mode-text text-[11px] text-[var(--text-dim)]">Açık</span>
      </button>

      <!-- External Channels -->
      <div class="flex items-center justify-between text-[11px] font-mono text-[var(--text-dim)] px-1">
        <a href={SITE_META.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors">GitHub</a>
        <span>·</span>
        <a href={SITE_META.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors">LinkedIn</a>
        <span>·</span>
        <a href={`mailto:${SITE_META.email}`} class="hover:text-[var(--text)] transition-colors">E-posta</a>
      </div>
    </div>
  </div>
</aside>

<!-- Mobile Sticky Topbar + Drawer Menu -->
<div class="lg:hidden sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md transition-colors">
  <div class="px-4 h-14 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-green)]"></span>
      <span class="font-sans text-xs font-semibold text-[var(--text)]">Ahmet İhtiyar</span>
      <span class="font-mono text-[11px] text-[var(--text-dim)] border-l border-[var(--border)] pl-2">Veritabanı & Depolama</span>
    </a>

    <!-- Mobile Actions (Theme + Hamburger) -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="theme-toggle-btn p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] w-8 h-8 flex items-center justify-center cursor-pointer"
        aria-label="Temayı Değiştir"
      >
        <svg class="theme-icon-sun w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
        </svg>
        <svg class="theme-icon-moon w-3.5 h-3.5 hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle-btn"
        type="button"
        class="p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] w-8 h-8 flex items-center justify-center cursor-pointer"
        aria-label="Menüyü Aç/Kapat"
        aria-expanded="false"
        aria-controls="mobile-sidebar-drawer"
      >
        <svg id="hamburger-icon" class="w-4 h-4 text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4 h-4 text-[var(--text)] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer (Collapsible Topic Tree) -->
  <div id="mobile-sidebar-drawer" class="hidden border-t border-[var(--border)] bg-[var(--bg)] px-4 py-4 space-y-4 max-h-[calc(100vh-3.5rem)] overflow-y-auto shadow-lg">
    {navSections.map((section) => (
      <div class="mobile-accordion-group border-b border-[var(--border)]/60 pb-3 last:border-b-0 space-y-1">
        <button
          type="button"
          class="mobile-accordion-btn w-full flex items-center justify-between px-2 py-1.5 text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors rounded-[2px]"
          aria-expanded="true"
        >
          <span class="flex items-center gap-1.5">
            <svg class="chevron-icon w-3.5 h-3.5 text-[var(--text-dim)] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
            <span>{section.title}</span>
          </span>
          <span class="text-[10px] font-mono text-[var(--text-dim)] opacity-70">
            {section.items.length}
          </span>
        </button>

        <div class="mobile-accordion-content space-y-0.5 pl-3 pt-1">
          {section.items.map((item) => (
            <a
              href={item.href}
              class="mobile-article-link block px-2.5 py-1.5 rounded-[2px] text-xs font-sans text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors"
            >
              {item.title}
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="pt-3 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono text-[var(--text-dim)] px-2">
      <a href={SITE_META.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE_META.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={`mailto:${SITE_META.email}`}>E-posta</a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // 1. Theme Controller
    const themeButtons = document.querySelectorAll('.theme-toggle-btn');
    const sunIcons = document.querySelectorAll('.theme-icon-sun');
    const moonIcons = document.querySelectorAll('.theme-icon-moon');
    const modeTexts = document.querySelectorAll('.theme-mode-text');

    function syncThemeUI(theme) {
      if (theme === 'dark') {
        sunIcons.forEach(i => i.classList.remove('hidden'));
        moonIcons.forEach(i => i.classList.add('hidden'));
        modeTexts.forEach(t => t.textContent = 'Koyu');
      } else {
        moonIcons.forEach(i => i.classList.remove('hidden'));
        sunIcons.forEach(i => i.classList.add('hidden'));
        modeTexts.forEach(t => t.textContent = 'Açık');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    syncThemeUI(currentTheme);

    themeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const active = document.documentElement.getAttribute('data-theme') || 'light';
        const next = active === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (_) {}
        syncThemeUI(next);
      });
    });

    // 2. Collapsible Accordions (Desktop & Mobile)
    function setupAccordions(buttonSelector, contentSelector) {
      const toggleButtons = document.querySelectorAll(buttonSelector);

      toggleButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const parent = btn.closest('.sidebar-accordion-group, .mobile-accordion-group');
          const content = parent ? parent.querySelector(contentSelector) : null;
          const chevron = btn.querySelector('.chevron-icon');
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            btn.setAttribute('aria-expanded', 'false');
            content?.classList.add('hidden');
            chevron?.classList.add('-rotate-90');
          } else {
            btn.setAttribute('aria-expanded', 'true');
            content?.classList.remove('hidden');
            chevron?.classList.remove('-rotate-90');
          }
        });
      });
    }

    setupAccordions('.sidebar-accordion-btn', '.sidebar-accordion-content');
    setupAccordions('.mobile-accordion-btn', '.mobile-accordion-content');

    // 3. Mobile Drawer Open/Close
    const menuBtn = document.getElementById('mobile-menu-toggle-btn');
    const drawer = document.getElementById('mobile-sidebar-drawer');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuBtn && drawer) {
      menuBtn.addEventListener('click', () => {
        const isExp = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExp));
        if (isExp) {
          drawer.classList.add('hidden');
          hamburger?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          drawer.classList.remove('hidden');
          hamburger?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });
    }

    // Close mobile drawer when an article link is clicked
    document.querySelectorAll('.mobile-article-link').forEach(link => {
      link.addEventListener('click', () => {
        if (drawer) {
          drawer.classList.add('hidden');
          menuBtn?.setAttribute('aria-expanded', 'false');
          hamburger?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      });
    });
  })();
</script>
