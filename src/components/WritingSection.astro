---
import { getCollection } from 'astro:content';
import { getPostSlug } from '../data/slugUtils';
import BlueprintCrosshairs from './BlueprintCrosshairs.astro';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const allPosts = await getCollection('posts');
// Filter posts matching current language, sorted by date descending
const posts = allPosts
  .filter(p => p.data.lang === lang)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

{posts.length > 0 && (
  <section id="writing" class="relative py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-20 sm:scroll-mt-24">
    <BlueprintCrosshairs bottom={true} />

    <!-- 12-Column Swiss Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left 4 Columns: Sticky Section Header -->
      <div class="lg:col-span-4 space-y-4">
        <div class="lg:sticky lg:top-24 space-y-4">
          <!-- Section Number -->
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
              05 // {isTr ? 'YAZILAR' : 'TECHNICAL WRITING'}
            </span>
            <span class="h-px w-6 bg-[var(--border-strong)]"></span>
          </div>

          <!-- Editorial Title -->
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
            {isTr ? 'Mühendislik Notları' : 'Engineering Notes'}
          </h2>

          <!-- Index / Tag -->
          <div class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider leading-relaxed border-l border-[#E8590C] pl-2.5">
            {posts.length} {isTr ? 'MAKALE // DERİNLEMESİNE İNCELEME' : 'ARTICLES // IN-DEPTH DIAGNOSTICS'}
          </div>

          <!-- Short Description -->
          <p class="text-sm text-[var(--text-muted)] font-sans leading-relaxed">
            {isTr 
              ? "Dağıtık sistemler, veritabanı optimizasyonu, Linux çekirdeği ve donanım seviyesinde karşılaşılan darboğazların editoryal kayıtları." 
              : "In-depth engineering notes on distributed systems, database query planner bottlenecks, bare-metal virtualization, and edge protocols."}
          </p>
        </div>
      </div>

      <!-- Right 8 Columns: Spacious Publication Listing -->
      <div class="lg:col-span-8">
        <div class="divide-y divide-[var(--border)] border-t border-[var(--border)]">
          {posts.map((post) => {
            const cleanSlug = getPostSlug(post);
            const postUrl = isTr ? `/posts/${cleanSlug}` : `/en/posts/${cleanSlug}`;

            return (
              <article class="py-5 sm:py-6 group flex flex-col md:flex-row md:items-baseline justify-between gap-3 sm:gap-6 hover:bg-[var(--bg-subtle)] hover:pl-3 transition-all px-2 -mx-2 rounded-none border-l-2 border-transparent hover:border-[#E8590C]">
                <div class="space-y-2 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-[11px] text-[var(--text-dim)]">
                      {post.data.date}
                    </span>
                    <span class="text-[var(--text-dim)]" aria-hidden="true">·</span>
                    <span class="font-mono text-[11px] text-[var(--text-dim)]">
                      {post.data.readingTime}
                    </span>
                    <span class="text-[var(--text-dim)]" aria-hidden="true">·</span>
                    <span class="font-mono text-[11px] text-[var(--text-dim)]">
                      {post.data.tags.join(' · ')}
                    </span>
                  </div>

                  <h3 class="text-lg sm:text-xl font-serif text-[var(--text)] group-hover:text-[#E8590C] transition-colors leading-snug">
                    <a href={postUrl} class="focus:outline-none block">
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="text-xs sm:text-[13px] text-[var(--text-muted)] font-sans line-clamp-2 leading-relaxed max-w-[65ch]">
                    {post.data.summary}
                  </p>
                </div>

                <div class="shrink-0 self-start md:self-center font-mono text-xs text-[#E8590C] inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  <span>{isTr ? 'Yazıyı Oku' : 'Read Article'}</span>
                  <span aria-hidden="true">→</span>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
