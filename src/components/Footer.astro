---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<footer class="w-full border-t border-[var(--border)] bg-[var(--bg)] text-xs font-mono py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[var(--text-muted)]">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        <span class="font-semibold text-[var(--text)]">Ahmet İhtiyar</span>
        <span class="text-[var(--text-dim)]">·</span>
        <span>{isTr ? 'Sistem ve Arka Uç Mühendisi' : 'Systems & Backend Engineer'}</span>
      </div>

      <div class="flex items-center gap-4 text-[var(--text-dim)]">
        <a href="#main-content" class="hover:text-[var(--text)] transition-colors inline-flex items-center gap-1">
          <span>{isTr ? 'Başa Dön' : 'Back to Top'}</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-[var(--border)] text-[11px] text-[var(--text-dim)]">
      <div>
        {SITE_META.fontsNote[lang]}
      </div>
      <div>
        {isTr ? 'İstanbul, Türkiye' : 'Istanbul, Turkey'} · © {new Date().getFullYear()}
      </div>
    </div>
  </div>
</footer>
