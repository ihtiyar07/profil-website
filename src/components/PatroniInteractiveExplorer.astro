{"state": "running", "role": "replica", "timeline": 2}`,
        note: "pg_rewind olmasaydı, çatallanmış (diverged) eski primary'yi kümeye geri sokmak için yüzlerce gigabaytlık veriyi pg_basebackup ile ağdan baştan çekmek gerekirdi. pg_rewind yalnızca ayrışan birkaç megabaytlık bloğu kopyalayarak saniyeler içinde kurtarma sağlar."
      }
    };

    let activeScenarioKey = 'sync';

    const scenarioBtns = document.querySelectorAll('.patroni-scenario-btn');
    const descEl = document.getElementById('patroni-scenario-description');
    const stepNote1El = document.getElementById('patroni-step-note-1');
    const stepNote2El = document.getElementById('patroni-step-note-2');
    const noteEl = document.getElementById('patroni-architecture-note');

    const codeCli = document.getElementById('patroni-code-cli');
    const codeDcs = document.getElementById('patroni-code-dcs');
    const codeHaproxy = document.getElementById('patroni-code-haproxy');

    // UI dashboard elements
    const uiQuorumBadge = document.getElementById('patroni-ui-quorum-badge');
    const uiCardRoleNode1 = document.getElementById('ui-card-role-node1');
    const uiCardHealthNode1 = document.getElementById('ui-card-health-node1');
    const uiCardTlNode1 = document.getElementById('ui-card-tl-node1');
    const uiCardLagNode1 = document.getElementById('ui-card-lag-node1');

    const uiCardRoleNode2 = document.getElementById('ui-card-role-node2');
    const uiCardHealthNode2 = document.getElementById('ui-card-health-node2');
    const uiCardTlNode2 = document.getElementById('ui-card-tl-node2');
    const uiCardLagNode2 = document.getElementById('ui-card-lag-node2');

    const uiCardRoleNode3 = document.getElementById('ui-card-role-node3');
    const uiCardHealthNode3 = document.getElementById('ui-card-health-node3');
    const uiCardTlNode3 = document.getElementById('ui-card-tl-node3');
    const uiCardLagNode3 = document.getElementById('ui-card-lag-node3');

    const actionSwitchoverBtn = document.getElementById('patroni-action-switchover');
    const actionPauseBtn = document.getElementById('patroni-action-pause');

    function updateScenario(key) {
      activeScenarioKey = key;
      const data = patroniScenarios[key];
      if (!data) return;

      scenarioBtns.forEach(btn => {
        if (btn.getAttribute('data-scenario') === key) {
          btn.classList.remove('bg-[var(--bg)]', 'text-[var(--text-muted)]');
          btn.classList.add('bg-[var(--text)]', 'text-[var(--bg)]', 'font-medium');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.remove('bg-[var(--text)]', 'text-[var(--bg)]', 'font-medium');
          btn.classList.add('bg-[var(--bg)]', 'text-[var(--text-muted)]');
          btn.setAttribute('aria-selected', 'false');
        }
      });

      if (descEl) descEl.textContent = data.desc;
      if (stepNote1El) stepNote1El.textContent = data.stepNote1;
      if (stepNote2El) stepNote2El.textContent = data.stepNote2;
      if (noteEl) noteEl.textContent = data.note;

      // Update Dashboard elements
      if (uiQuorumBadge) uiQuorumBadge.textContent = data.quorum;
      if (uiCardRoleNode1) {
        uiCardRoleNode1.textContent = data.uiNode1.role;
        uiCardRoleNode1.className = 'px-1.5 py-0.2 text-[10px] rounded-[2px] font-medium ' + data.uiNode1.roleClass;
      }
      if (uiCardHealthNode1) uiCardHealthNode1.textContent = data.uiNode1.health;
      if (uiCardTlNode1) uiCardTlNode1.textContent = data.uiNode1.tl;
      if (uiCardLagNode1) uiCardLagNode1.textContent = data.uiNode1.lag;

      if (uiCardRoleNode2) {
        uiCardRoleNode2.textContent = data.uiNode2.role;
        uiCardRoleNode2.className = 'px-1.5 py-0.2 text-[10px] rounded-[2px] font-medium ' + data.uiNode2.roleClass;
      }
      if (uiCardHealthNode2) uiCardHealthNode2.textContent = data.uiNode2.health;
      if (uiCardTlNode2) uiCardTlNode2.textContent = data.uiNode2.tl;
      if (uiCardLagNode2) uiCardLagNode2.textContent = data.uiNode2.lag;

      if (uiCardRoleNode3) {
        uiCardRoleNode3.textContent = data.uiNode3.role;
        uiCardRoleNode3.className = 'px-1.5 py-0.2 text-[10px] rounded-[2px] font-medium ' + data.uiNode3.roleClass;
      }
      if (uiCardHealthNode3) uiCardHealthNode3.textContent = data.uiNode3.health;
      if (uiCardTlNode3) uiCardTlNode3.textContent = data.uiNode3.tl;
      if (uiCardLagNode3) uiCardLagNode3.textContent = data.uiNode3.lag;

      // Update Code Panes
      if (codeCli) codeCli.textContent = data.cli;
      if (codeDcs) codeDcs.textContent = data.dcs;
      if (codeHaproxy) codeHaproxy.textContent = data.haproxy;
    }

    scenarioBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const scenario = btn.getAttribute('data-scenario');
        if (scenario) updateScenario(scenario);
      });
    });

    if (actionSwitchoverBtn) {
      actionSwitchoverBtn.addEventListener('click', () => {
        updateScenario('switchover');
      });
    }

    if (actionPauseBtn) {
      let isPaused = false;
      actionPauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        actionPauseBtn.textContent = isPaused ? '▶ Bakımdan Çık (Resume)' : '⏸ Bakım Modu';
        if (uiQuorumBadge) {
          uiQuorumBadge.textContent = isPaused ? 'PAUSED (Bakım Modu)' : patroniScenarios[activeScenarioKey].quorum;
          uiQuorumBadge.className = isPaused
            ? 'text-[10px] font-mono px-1.5 py-0.5 bg-yellow-500/20 text-yellow-600 dark:text-yellow-400 rounded-[2px] font-medium'
            : 'text-[10px] font-mono px-1.5 py-0.5 bg-[var(--status-green)]/15 text-[var(--status-green)] rounded-[2px] font-medium';
        }
      });
    }

    // Step Copy Buttons
    document.querySelectorAll('.patroni-copy-step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const codeEl = document.getElementById(targetId);
        if (codeEl) {
          navigator.clipboard.writeText(codeEl.textContent || '').then(() => {
            const originalText = btn.textContent;
            btn.textContent = 'Kopyalandı!';
            setTimeout(() => {
              btn.textContent = originalText;
            }, 2000);
          });
        }
      });
    });
  })();
</script>
