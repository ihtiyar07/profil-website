---
import { SITE_META } from '../data/siteMeta';
import {
  navSections,
  getSectionTheme,
  type NavSection
} from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function sectionContainsPath(section: NavSection, path: string): boolean {
  for (const item of section.items) {
    if ((item.href.replace(/\/+$/, '') || '/') === path) return true;
    if (item.children?.some((c) => (c.href.replace(/\/+$/, '') || '/') === path)) {
      return true;
    }
  }
  return false;
}

const isLearningPathActive = currentPath === '/ogrenme-rotasi';
const anySectionContainsPath = navSections.some((s) => sectionContainsPath(s, currentPath));
---

<!-- Mobile Topbar (< 768px): Single lightweight bar without duplicate nav tree -->
<header
  transition:persist="sidebar-mobile-topbar"
  style="view-transition-name: sidebar-mobile-topbar;"
  class="md:hidden sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md"
>
  <div class="px-4 h-14 flex items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2.5 focus:outline-none min-w-0" aria-label="Ahmet İhtiyar — Ana Sayfa">
      <picture class="shrink-0">
        <source srcset="/profile.webp" type="image/webp" />
        <img
          src="/profile.png"
          alt="Ahmet İhtiyar"
          width="32"
          height="32"
          class="w-8 h-8 rounded-[2px] object-cover border border-[var(--border)]"
        />
      </picture>
      <div class="flex flex-col min-w-0">
        <span class="font-sans text-xs font-semibold text-[var(--text)] leading-tight truncate">Ahmet İhtiyar</span>
        <span class="font-mono text-[10px] text-[var(--text-dim)] leading-tight truncate">PostgreSQL Mimarisi</span>
      </div>
    </a>

    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        class="search-trigger-btn px-2 h-8 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] inline-flex items-center gap-1.5 cursor-pointer tactile-btn text-xs font-mono"
        aria-label="Makalelerde Ara"
        title="Ara (Ctrl+K)"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path stroke-linecap="round" d="m21 21-4.3-4.3" />
        </svg>
        <span class="text-[11px]">Ara</span>
      </button>

      <button
        type="button"
        class="theme-toggle-btn p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] w-8 h-8 flex items-center justify-center cursor-pointer tactile-btn"
        aria-label="Temayı Değiştir"
        title="Temayı Değiştir"
      >
        <svg class="theme-icon-sun w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon w-3.5 h-3.5 hidden text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle-btn"
        type="button"
        class="p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] bg-[var(--bg-subtle)] w-8 h-8 flex items-center justify-center cursor-pointer tactile-btn"
        aria-label="Navigasyon Menüsünü Aç/Kapat"
        aria-expanded="false"
        aria-controls="site-sidebar"
      >
        <svg id="hamburger-icon" class="w-4 h-4 text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4 h-4 text-[var(--text)] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div
  id="mobile-drawer-backdrop"
  transition:persist="sidebar-backdrop"
  class="fixed inset-0 bg-black/50 z-40 backdrop-blur-xs hidden md:hidden transition-opacity"
  aria-hidden="true"
></div>

<!-- Single Responsive Sidebar (Fixed slide-over drawer on mobile, Sticky column on >=768px) -->
<aside
  id="site-sidebar"
  transition:persist="sidebar-unified"
  style="view-transition-name: sidebar-desktop;"
  aria-label="Ana Navigasyon ve Konu Ağacı"
  class="fixed inset-y-0 left-0 z-50 w-[285px] -translate-x-full md:translate-x-0 md:sticky md:top-0 md:z-30 md:w-[280px] xl:w-[300px] shrink-0 h-screen border-r border-[var(--border)] bg-[var(--bg-card)]/95 dark:bg-[#0D1118] overflow-y-auto select-none transition-transform duration-200 ease-out flex flex-col"
>
  <div class="p-4 sm:p-5 flex flex-col justify-between min-h-full">
    <!-- Top Section: Brand + Search + Learning Path + Collapsible Topic Tree -->
    <div class="space-y-3">
      <!-- Mobile Drawer Close Header -->
      <div class="flex md:hidden items-center justify-between pb-2 border-b border-[var(--border)]">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-dim)] font-semibold">
          Navigasyon
        </span>
        <button
          id="mobile-drawer-close-inner"
          type="button"
          class="w-7 h-7 flex items-center justify-center rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] cursor-pointer"
          aria-label="Menüyü Kapat"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Identity & Brand Lockup (Clean, borderless header with bottom rule) -->
      <a
        href="/"
        class="sidebar-nav-link flex flex-col group focus:outline-none px-1.5 pt-0.5 pb-3 border-b border-[var(--border)]/80 transition-colors"
        title="Ana Sayfaya Dön"
        aria-label="Ahmet İhtiyar — Ana Sayfa"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-[1px] bg-[var(--accent)] shrink-0" aria-hidden="true"></span>
            <span class="font-sans text-[14px] font-semibold tracking-tight text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
              Ahmet İhtiyar
            </span>
          </div>
          <svg class="w-3.5 h-3.5 text-[var(--text-dim)] group-hover:text-[var(--accent)] opacity-0 group-hover:opacity-100 transition-opacity shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
        </div>
        <p class="font-mono text-[11px] text-[var(--text-dim)] mt-0.5 pl-4">
          PostgreSQL Mimarisi
        </p>
      </a>

      <!-- Search Command Palette Trigger (Distinct single input surface) -->
      <button
        type="button"
        id="sidebar-search-btn"
        class="search-trigger-btn w-full flex items-center justify-between px-2.5 py-2 rounded-[2px] border border-[var(--border)] bg-[var(--bg)] hover:border-[var(--accent-border)] hover:bg-[var(--bg-subtle)]/70 text-[var(--text-dim)] hover:text-[var(--text)] transition-colors cursor-pointer group shadow-2xs"
        aria-label="Dokümantasyonda Ara (Ctrl+K)"
      >
        <span class="flex items-center gap-2 text-xs font-sans">
          <svg class="w-3.5 h-3.5 text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path stroke-linecap="round" d="m21 21-4.3-4.3" />
          </svg>
          <span>Ara...</span>
        </span>
        <kbd class="font-mono text-[10px] px-1.5 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)]">
          ⌘K
        </kbd>
      </button>

      <!-- Learning Path Dedicated Link (Clean borderless nav item) -->
      <div class="pb-2.5 border-b border-[var(--border)]/60">
        <a
          href="/ogrenme-rotasi"
          class:list={[
            'sidebar-nav-link sidebar-learning-link flex items-center justify-between px-2 py-1.5 rounded-[2px] text-xs font-sans transition-colors group',
            isLearningPathActive
              ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium'
              : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]'
          ]}
          aria-current={isLearningPathActive ? 'page' : undefined}
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
            </svg>
            <span>Öğrenme Rotası</span>
          </span>
          <span class="text-[11px] font-mono text-[var(--text-dim)] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Collapsible Topic Tree Navigation -->
      <nav aria-label="Konu ve Yazı Ağacı" class="space-y-3.5 pt-0.5">
        {navSections.map((section) => {
          const theme = getSectionTheme(section.id);
          const isSectionActive = sectionContainsPath(section, currentPath);
          const isSectionExpanded = !anySectionContainsPath || isSectionActive;
          return (
            <div class="sidebar-accordion-group">
              <button
                type="button"
                class="sidebar-accordion-btn w-full flex items-center justify-between px-2 py-1 text-[10.5px] font-mono font-semibold uppercase tracking-[0.08em] text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]/70 transition-colors rounded-[2px] cursor-pointer focus:outline-none group"
                aria-label={`${section.title} alt başlıklarını aç veya kapat`}
                aria-expanded={isSectionExpanded ? 'true' : 'false'}
                data-section-id={section.id}
              >
                <span class="flex items-center gap-2 min-w-0">
                  <span class:list={['w-1.5 h-1.5 rounded-full shrink-0', theme.dot]} aria-hidden="true"></span>
                  <span class="font-semibold truncate min-w-0 text-left">{section.title}</span>
                </span>
                <span class="w-4 h-4 flex items-center justify-center shrink-0 text-[var(--text-dim)] group-hover:text-[var(--text)] transition-colors">
                  <svg class="toggle-chevron w-3 h-3 transition-transform duration-150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </button>

              <div class:list={['sidebar-accordion-wrapper', !isSectionExpanded && 'collapsed']}>
                <div>
                  <div class="space-y-0.5 pl-1 pt-1">
                    {section.items.map((item) => {
                      const cleanHref = item.href.replace(/\/+$/, '') || '/';
                      const isActive = cleanHref === currentPath;
                      const hasActiveChild = item.children?.some((c) => (c.href.replace(/\/+$/, '') || '/') === currentPath);
                      const hasChildren = item.children && item.children.length > 0;
                      const isExpandedDefault = isActive || hasActiveChild;

                      if (hasChildren) {
                        return (
                          <div class="has-subitems-group space-y-0.5">
                            <div class:list={[
                              'parent-row flex items-center justify-between rounded-[2px] transition-colors group',
                              isActive
                                ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)]'
                                : hasActiveChild
                                  ? 'bg-[var(--bg-subtle)]/70 text-[var(--text)] font-medium border-l border-[var(--accent)]/50'
                                  : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]'
                            ]}>
                              <a
                                href={item.href}
                                title={item.title}
                                class:list={[
                                  'sidebar-article-link sidebar-nav-link flex items-center min-w-0 flex-1 py-1.5 pl-2 pr-1 text-xs font-sans transition-colors',
                                  isActive ? 'text-[var(--accent)] font-medium' : hasActiveChild ? 'text-[var(--text)] font-medium' : ''
                                ]}
                                aria-current={isActive ? 'page' : undefined}
                              >
                                <span class="line-clamp-2 leading-snug break-words">{item.title}</span>
                              </a>

                              <button
                                type="button"
                                class="sidebar-subitem-toggle w-6 h-6 mr-1 flex items-center justify-center text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg)] rounded-[2px] cursor-pointer transition-colors focus:outline-none shrink-0"
                                aria-label={`${item.title} alt başlıklarını aç veya kapat`}
                                aria-expanded={isExpandedDefault ? 'true' : 'false'}
                              >
                                <svg class="toggle-chevron w-3 h-3 transition-transform duration-150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                              </button>
                            </div>

                            <div class:list={[
                              'sidebar-subitems-wrapper',
                              !isExpandedDefault && 'collapsed'
                            ]}>
                              <div>
                                <div class:list={['pl-3 ml-2.5 border-l space-y-0.5 my-0.5', theme.treeBorder]}>
                                  {item.children.map((child) => {
                                    const cleanChildHref = child.href.replace(/\/+$/, '') || '/';
                                    const isChildActive = cleanChildHref === currentPath;

                                    return (
                                      <a
                                        href={child.href}
                                        title={child.title}
                                        class:list={[
                                          'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1 rounded-[2px] text-[11.5px] font-sans transition-colors group',
                                          isChildActive
                                            ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)] -ml-[1px] pl-2 pr-1.5'
                                            : 'text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] pl-2 pr-1.5'
                                        ]}
                                        aria-current={isChildActive ? 'page' : undefined}
                                      >
                                        <span class="flex items-start gap-1.5 min-w-0 flex-1">
                                          <span class="w-1 h-1 rounded-full bg-[var(--text-dim)]/50 group-hover:bg-[var(--accent)] shrink-0 mt-1.5"></span>
                                          <span class="line-clamp-2 leading-snug break-words">{child.title}</span>
                                        </span>
                                        <span class="text-[9px] font-mono text-[var(--text-dim)] opacity-0 group-hover:opacity-100 transition-opacity ml-1 shrink-0" aria-hidden="true">→</span>
                                      </a>
                                    );
                                  })}
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      }

                      return (
                        <a
                          href={item.href}
                          title={item.title}
                          class:list={[
                            'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1.5 rounded-[2px] text-xs font-sans transition-colors group',
                            isActive
                              ? 'bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)] pl-2 pr-2'
                              : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] pl-2.5 pr-2'
                          ]}
                          aria-current={isActive ? 'page' : undefined}
                        >
                          <span class="line-clamp-2 leading-snug break-words">{item.title}</span>
                          <span class="text-[10px] font-mono text-[var(--text-dim)] opacity-0 group-hover:opacity-100 transition-opacity ml-1.5 shrink-0" aria-hidden="true">→</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </nav>
    </div>

    <!-- Bottom: Utility Bar (Social Icons + Theme Switcher) -->
    <div class="pt-3 mt-4 border-t border-[var(--border)] flex items-center justify-between px-1">
      <div class="flex items-center gap-1">
        <a
          href={SITE_META.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 flex items-center justify-center rounded-[2px] text-[var(--text-dim)] hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-800/70 border border-transparent hover:border-[var(--border)] transition-colors tactile-btn"
          title="GitHub"
          aria-label="GitHub Profilini Aç"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a
          href={SITE_META.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 flex items-center justify-center rounded-[2px] text-[var(--text-dim)] hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50/80 dark:hover:bg-blue-950/45 border border-transparent hover:border-blue-200/70 dark:hover:border-blue-800/50 transition-colors tactile-btn"
          title="LinkedIn"
          aria-label="LinkedIn Profilini Aç"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>
        <a
          href={`mailto:${SITE_META.email}`}
          class="w-7 h-7 flex items-center justify-center rounded-[2px] text-[var(--text-dim)] hover:text-teal-700 dark:hover:text-teal-300 hover:bg-teal-50/80 dark:hover:bg-teal-950/45 border border-transparent hover:border-teal-200/70 dark:hover:border-teal-800/50 transition-colors tactile-btn"
          title="E-posta"
          aria-label="E-posta Gönder"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>

      <button
        type="button"
        class="theme-toggle-btn w-7 h-7 flex items-center justify-center rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--border-strong)] transition-colors cursor-pointer tactile-btn"
        aria-label="Temayı Değiştir"
        title="Temayı Değiştir"
      >
        <svg class="theme-icon-sun w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon w-3.5 h-3.5 hidden text-[var(--text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .sidebar-accordion-wrapper,
  .sidebar-subitems-wrapper {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-accordion-wrapper.collapsed,
  .sidebar-subitems-wrapper.collapsed {
    grid-template-rows: 0fr;
  }
  .sidebar-accordion-wrapper > div,
  .sidebar-subitems-wrapper > div {
    overflow: hidden;
    min-height: 0;
  }

  .sidebar-accordion-btn[aria-expanded="true"] .toggle-chevron,
  .sidebar-subitem-toggle[aria-expanded="true"] .toggle-chevron {
    transform: rotate(90deg);
  }
  .sidebar-accordion-btn[aria-expanded="false"] .toggle-chevron,
  .sidebar-subitem-toggle[aria-expanded="false"] .toggle-chevron {
    transform: rotate(0deg);
  }
</style>

<script is:inline>
  (function() {
    if (window.__sidebarInitialized) return;
    window.__sidebarInitialized = true;

    const desktopMedia = window.matchMedia('(min-width: 768px)');
    let isMobileDrawerOpen = false;

    function getEffectiveTheme() {
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') return stored;
      } catch (_) {}
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function syncThemeUI(theme) {
      const sunIcons = document.querySelectorAll('.theme-icon-sun');
      const moonIcons = document.querySelectorAll('.theme-icon-moon');
      if (theme === 'dark') {
        sunIcons.forEach((i) => i.classList.remove('hidden'));
        moonIcons.forEach((i) => i.classList.add('hidden'));
      } else {
        moonIcons.forEach((i) => i.classList.remove('hidden'));
        sunIcons.forEach((i) => i.classList.add('hidden'));
      }
    }

    function syncSidebarAccessibility() {
      const sidebar = document.getElementById('site-sidebar');
      if (!sidebar) return;

      if (desktopMedia.matches) {
        sidebar.removeAttribute('aria-hidden');
        sidebar.removeAttribute('inert');
        sidebar.removeAttribute('role');
        sidebar.removeAttribute('aria-modal');
        sidebar.classList.remove('translate-x-0');
        document.getElementById('mobile-drawer-backdrop')?.classList.add('hidden');
        document.body.style.overflow = '';
        isMobileDrawerOpen = false;
      } else {
        if (isMobileDrawerOpen) {
          sidebar.removeAttribute('aria-hidden');
          sidebar.removeAttribute('inert');
          sidebar.setAttribute('role', 'dialog');
          sidebar.setAttribute('aria-modal', 'true');
        } else {
          sidebar.setAttribute('aria-hidden', 'true');
          sidebar.setAttribute('inert', '');
          sidebar.removeAttribute('role');
          sidebar.removeAttribute('aria-modal');
        }
      }
    }

    function openDrawer() {
      const menuBtn = document.getElementById('mobile-menu-toggle-btn');
      const sidebar = document.getElementById('site-sidebar');
      const backdrop = document.getElementById('mobile-drawer-backdrop');
      const hamburger = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      if (!sidebar || !menuBtn || desktopMedia.matches) return;

      isMobileDrawerOpen = true;
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop?.classList.remove('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
      hamburger?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      syncSidebarAccessibility();

      const firstFocusTarget = document.getElementById('mobile-drawer-close-inner') || sidebar.querySelector('a, button');
      firstFocusTarget?.focus();
    }

    function closeDrawer(restoreFocus) {
      const menuBtn = document.getElementById('mobile-menu-toggle-btn');
      const sidebar = document.getElementById('site-sidebar');
      const backdrop = document.getElementById('mobile-drawer-backdrop');
      const hamburger = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      if (!sidebar || !menuBtn) return;

      const wasOpen = isMobileDrawerOpen;
      isMobileDrawerOpen = false;
      sidebar.classList.remove('translate-x-0');
      sidebar.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
      syncSidebarAccessibility();

      if (restoreFocus && wasOpen) {
        menuBtn.focus();
      }
    }

    window.__closeMobileSidebar = closeDrawer;

    syncThemeUI(document.documentElement.getAttribute('data-theme') || getEffectiveTheme());
    syncSidebarAccessibility();

    desktopMedia.addEventListener('change', syncSidebarAccessibility);

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      try {
        if (!localStorage.getItem('theme')) {
          const next = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          syncThemeUI(next);
        }
      } catch (_) {}
    });

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const accordionBtn = target.closest('.sidebar-accordion-btn');
      if (accordionBtn) {
        e.preventDefault();
        e.stopPropagation();
        const group = accordionBtn.closest('.sidebar-accordion-group');
        const wrapper = group?.querySelector('.sidebar-accordion-wrapper');
        const isExpanded = accordionBtn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;
        accordionBtn.setAttribute('aria-expanded', String(nextState));
        wrapper?.classList.toggle('collapsed', !nextState);
        return;
      }

      const subToggle = target.closest('.sidebar-subitem-toggle');
      if (subToggle) {
        e.preventDefault();
        e.stopPropagation();
        const parentGroup = subToggle.closest('.has-subitems-group');
        const wrapper = parentGroup?.querySelector('.sidebar-subitems-wrapper');
        const isExpanded = subToggle.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;
        subToggle.setAttribute('aria-expanded', String(nextState));
        wrapper?.classList.toggle('collapsed', !nextState);
        return;
      }

      const parentArticleLink = target.closest('.has-subitems-group > .parent-row > .sidebar-article-link');
      if (parentArticleLink) {
        const parentGroup = parentArticleLink.closest('.has-subitems-group');
        const subWrapper = parentGroup?.querySelector('.sidebar-subitems-wrapper');
        const subToggle = parentGroup?.querySelector('.sidebar-subitem-toggle');
        subWrapper?.classList.remove('collapsed');
        subToggle?.setAttribute('aria-expanded', 'true');
      }

      if (target.closest('.theme-toggle-btn')) {
        const active = document.documentElement.getAttribute('data-theme') || getEffectiveTheme();
        const next = active === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (_) {}
        syncThemeUI(next);
        return;
      }

      const menuBtn = target.closest('#mobile-menu-toggle-btn');
      if (menuBtn) {
        if (isMobileDrawerOpen) closeDrawer(true);
        else openDrawer();
        return;
      }

      if (target.closest('#mobile-drawer-close-inner') || target.closest('#mobile-drawer-backdrop')) {
        closeDrawer(true);
        return;
      }

      if (target.closest('.sidebar-nav-link') && !desktopMedia.matches) {
        closeDrawer(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMobileDrawerOpen && !desktopMedia.matches) {
        closeDrawer(true);
      }
    });

    function updateActiveSidebarLinks() {
      const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
      syncThemeUI(document.documentElement.getAttribute('data-theme') || getEffectiveTheme());

      // Sync learning path button
      const learningLink = document.querySelector('.sidebar-learning-link');
      if (learningLink) {
        if (currentPath === '/ogrenme-rotasi') {
          learningLink.setAttribute('aria-current', 'page');
          learningLink.className = 'sidebar-nav-link sidebar-learning-link flex items-center justify-between px-2 py-1.5 rounded-[2px] text-xs font-sans transition-colors group bg-[var(--accent-subtle)] text-[var(--accent)] font-medium';
        } else {
          learningLink.removeAttribute('aria-current');
          learningLink.className = 'sidebar-nav-link sidebar-learning-link flex items-center justify-between px-2 py-1.5 rounded-[2px] text-xs font-sans transition-colors group text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]';
        }
      }

      // On landing/index routes where no article is active, expand all top-level categories by default
      const groups = Array.from(document.querySelectorAll('.sidebar-accordion-group'));
      const anySectionHasActive = groups.some((group) =>
        Array.from(group.querySelectorAll('.sidebar-article-link')).some((link) => {
          const href = link.getAttribute('href')?.replace(/\/+$/, '') || '/';
          return href === currentPath;
        })
      );

      groups.forEach((group) => {
        const btn = group.querySelector('.sidebar-accordion-btn');
        const wrapper = group.querySelector('.sidebar-accordion-wrapper');
        const hasActiveLink = Array.from(group.querySelectorAll('.sidebar-article-link')).some((link) => {
          const href = link.getAttribute('href')?.replace(/\/+$/, '') || '/';
          return href === currentPath;
        });
        const shouldExpand = !anySectionHasActive || hasActiveLink;

        btn?.setAttribute('aria-expanded', shouldExpand ? 'true' : 'false');
        wrapper?.classList.toggle('collapsed', !shouldExpand);
      });

      document.querySelectorAll('.sidebar-article-link').forEach((link) => {
        const href = link.getAttribute('href');
        if (!href) return;
        const cleanHref = href.replace(/\/+$/, '') || '/';
        const isActive = cleanHref === currentPath;
        const isChild = link.closest('.sidebar-subitems-wrapper') !== null;
        const parentGroup = link.closest('.has-subitems-group');

        if (isActive) {
          link.setAttribute('aria-current', 'page');
          if (isChild) {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1 rounded-[2px] text-[11.5px] font-sans transition-colors group bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)] -ml-[1px] pl-2 pr-1.5';
            if (parentGroup) {
              parentGroup.querySelector('.sidebar-subitems-wrapper')?.classList.remove('collapsed');
              parentGroup.querySelector('.sidebar-subitem-toggle')?.setAttribute('aria-expanded', 'true');
            }
          } else if (parentGroup) {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center min-w-0 flex-1 py-1.5 pl-2 pr-1 text-xs font-sans transition-colors text-[var(--accent)] font-medium';
            const parentRow = link.closest('.parent-row');
            if (parentRow) {
              parentRow.className = 'parent-row flex items-center justify-between rounded-[2px] transition-colors group bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)]';
            }
            parentGroup.querySelector('.sidebar-subitems-wrapper')?.classList.remove('collapsed');
            parentGroup.querySelector('.sidebar-subitem-toggle')?.setAttribute('aria-expanded', 'true');
          } else {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1.5 rounded-[2px] text-xs font-sans transition-colors group bg-[var(--accent-subtle)] text-[var(--accent)] font-medium border-l border-[var(--accent)] pl-2 pr-2';
          }
        } else {
          link.removeAttribute('aria-current');
          if (isChild) {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1 rounded-[2px] text-[11.5px] font-sans transition-colors group text-[var(--text-dim)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] pl-2 pr-1.5';
          } else if (parentGroup) {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center min-w-0 flex-1 py-1.5 pl-2 pr-1 text-xs font-sans transition-colors';
          } else {
            link.className = 'sidebar-article-link sidebar-nav-link flex items-center justify-between py-1.5 rounded-[2px] text-xs font-sans transition-colors group text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] pl-2.5 pr-2';
          }
        }
      });

      document.querySelectorAll('#site-sidebar .has-subitems-group').forEach((group) => {
        const activeChild = group.querySelector('.sidebar-subitems-wrapper [aria-current="page"]');
        const parentLink = group.querySelector(':scope > .parent-row > .sidebar-article-link');
        const parentRow = group.querySelector(':scope > .parent-row');
        const isParentActive = parentLink?.getAttribute('aria-current') === 'page';

        if (!isParentActive && parentRow && parentLink) {
          if (activeChild) {
            parentRow.className = 'parent-row flex items-center justify-between rounded-[2px] transition-colors group bg-[var(--bg-subtle)]/70 text-[var(--text)] font-medium border-l border-[var(--accent)]/50';
            parentLink.className = 'sidebar-article-link sidebar-nav-link flex items-center min-w-0 flex-1 py-1.5 pl-2 pr-1 text-xs font-sans transition-colors text-[var(--text)] font-medium';
          } else {
            parentRow.className = 'parent-row flex items-center justify-between rounded-[2px] transition-colors group text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)]';
            parentLink.className = 'sidebar-article-link sidebar-nav-link flex items-center min-w-0 flex-1 py-1.5 pl-2 pr-1 text-xs font-sans transition-colors';
          }
        }
      });

      closeDrawer(false);
    }

    document.addEventListener('astro:after-swap', updateActiveSidebarLinks);
    document.addEventListener('astro:page-load', updateActiveSidebarLinks);
  })();
</script>
