---
import { SITE_META } from '../data/siteMeta';
---

<section class="pt-2 sm:pt-4 pb-8 sm:pb-10 border-b border-[var(--border)]">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 sm:gap-8">
    <!-- Main Text Content -->
    <div class="flex-1 max-w-2xl lg:max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-[var(--accent)] bg-[var(--accent-subtle)] border border-[var(--accent-border)] px-2.5 py-1 rounded-[2px]">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        <span>PostgreSQL Mühendislik Notları</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-2xl sm:text-3xl lg:text-[2.25rem] font-serif leading-[1.2] tracking-tight text-[var(--text)]">
        Veritabanı çekirdeği, kilitleme modelleri ve yüksek erişebilirlik mimarileri.
      </h1>

      <!-- Requested Subtitle -->
      <p class="text-sm sm:text-[15.5px] text-[var(--text-muted)] font-sans leading-relaxed">
        PostgreSQL iç mimarisi, MVCC, kilit mekanizmaları ve production operasyonları üzerine uygulamalı Türkçe mühendislik rehberi.
      </p>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-2.5 pt-2">
        <a
          href="/ogrenme-rotasi"
          class="h-9 px-4 bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] border border-[var(--accent)] transition-colors text-xs font-mono font-medium inline-flex items-center justify-center gap-2 rounded-[2px] shadow-2xs cursor-pointer"
        >
          <span>Öğrenme Rotasına Başla</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#articles"
          class="h-9 px-4 bg-[var(--bg-card)] text-[var(--text)] hover:bg-[var(--bg-subtle)] border border-[var(--border-strong)] hover:border-[var(--accent)] transition-colors text-xs font-mono font-medium inline-flex items-center justify-center gap-2 rounded-[2px] shadow-2xs cursor-pointer"
        >
          <span>Tüm Yazıları Tara</span>
          <span aria-hidden="true">↓</span>
        </a>

        <div class="flex items-center gap-2 sm:ml-1">
          <a
            href={SITE_META.github}
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 px-3 border border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--border-strong)] transition-colors text-xs font-mono font-medium inline-flex items-center justify-center gap-1 rounded-[2px] shadow-2xs cursor-pointer"
          >
            <span>GitHub</span>
            <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
          </a>

          <a
            href={SITE_META.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 px-3 border border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--border-strong)] transition-colors text-xs font-mono font-medium inline-flex items-center justify-center gap-1 rounded-[2px] shadow-2xs cursor-pointer"
          >
            <span>LinkedIn</span>
            <span class="text-[var(--text-dim)]" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Editorial Framed Portrait -->
    <div class="shrink-0 self-start sm:self-center">
      <div class="p-1.5 sm:p-2 bg-[var(--bg-card)] border border-[var(--border)] rounded-[2px] shadow-2xs transition-colors duration-200">
        <picture>
          <source srcset="/profile.webp" type="image/webp" />
          <img
            src="/profile.png"
            alt="Ahmet İhtiyar"
            width="135"
            height="160"
            class="w-28 sm:w-32 lg:w-36 rounded-[2px] object-cover aspect-[4/5] block"
            loading="eager"
          />
        </picture>
        <div class="mt-2 text-center pb-0.5">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[var(--text-dim)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <span>Ahmet İhtiyar</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
