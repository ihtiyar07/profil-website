{"conn_url": "postgres://192.168.10.11:5432/postgres", "api_url": "http://192.168.10.11:8008/patroni", "state": "running", "role": "replica", "timeline": 2}`,
        haproxy: `# pg-node-1 artık read-only replica havuzuna dahil edilir:
$ curl -s -i http://192.168.10.11:8008/replica
