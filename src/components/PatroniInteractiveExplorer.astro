        stateNode2.className = data.node2.stateClass;
      }

      // Update Topo Node 3
      if (roleNode3) {
        roleNode3.textContent = data.node3.role;
        roleNode3.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium border ' + data.node3.roleClass;
      }
      if (tlNode3) tlNode3.textContent = data.node3.tl;
      if (stateNode3) {
        stateNode3.textContent = data.node3.state;
        stateNode3.className = data.node3.stateClass;
      }

      // Update Dashboard elements
      if (uiQuorumBadge) uiQuorumBadge.textContent = data.quorum;
      if (uiCardRoleNode1) {
        uiCardRoleNode1.textContent = data.uiNode1.role;
        uiCardRoleNode1.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium ' + data.uiNode1.roleClass;
      }
      if (uiCardHealthNode1) uiCardHealthNode1.textContent = data.uiNode1.health;
      if (uiCardTlNode1) uiCardTlNode1.textContent = data.node1.tl;
