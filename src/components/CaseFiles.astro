---
const systems = [
  {
    slug: 'metadb',
    id: '01',
    title: 'MetaDB: Dağıtık Veri Kataloğu ve Şema Soykütüğü',
    description: 'Canlı veritabanı tablolarına tam tarama yapmadan yerel katalog istatistiklerini (pg_class, ALL_TABLES) okuyan ve şema soykütüğünü Memgraph üzerinde modelleyen kurumsal metadata servisi.',
    stack: ['PostgreSQL', 'Oracle DB', 'MSSQL', 'Memgraph', 'Spring Boot', 'Temporal']
  },
  {
    slug: 'timescaledb',
    id: '02',
    title: 'TimescaleDB: Zaman Serisi Depolama ve Hypertables',
    description: 'Yüksek hacimli telemetri ve metrik verisi için chunk boyutlandırmanın RAM buffer cache kapasitesine göre ayarlanması, continuous aggregates ve sütunsal sıkıştırma.',
    stack: ['PostgreSQL', 'TimescaleDB', 'Zstd Sıkıştırma', 'Linux']
  },
  {
    slug: 'apache-arrow',
    id: '03',
    title: 'Apache Arrow: Sıfır Kopyalama (Zero-Copy) Veri Akışı',
    description: 'Büyük analitik sorgu sonuçlarının JSON serileştirme darboğazına girmeden doğrudan Arrow RecordBatch IPC akışıyla istemci belleğine eşlenmesi.',
    stack: ['Apache Arrow', '.NET 10', 'TypeScript', 'HTTP/2']
  }
];
---

<section id="systems" class="py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-16">
  <!-- Anchor alias for legacy links -->
  <span id="cases" class="sr-only" aria-hidden="true"></span>

  <div class="space-y-2 mb-10 max-w-2xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      Sistemler & Çalışmalar
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Üretim ortamlarında tasarlanan ve çalıştırılan veritabanı altyapıları ve mimari çalışmalar.
    </p>
  </div>

  <div class="border-t border-[var(--border)] divide-y divide-[var(--border)]">
    {systems.map((item) => (
      <article class="py-6 sm:py-8 group transition-colors hover:bg-[var(--bg-subtle)]/40 px-2 -mx-2 rounded-[2px]">
        <div class="flex flex-col lg:flex-row lg:items-baseline justify-between gap-4">
          <div class="flex-1 space-y-2.5">
            <div class="flex items-center gap-2 font-mono text-xs text-[var(--text-dim)]">
              <span class="text-[var(--text-accent)] font-semibold">{item.id}</span>
              <span>·</span>
              <span>Vaka Dosyası</span>
            </div>

            <h3 class="font-serif text-xl sm:text-2xl text-[var(--text)] group-hover:text-[var(--text-accent)] transition-colors leading-snug">
              <a href={`/cases/${item.slug}`} class="focus:outline-none hover:underline underline-offset-4 decoration-[var(--accent)]">
                {item.title}
              </a>
            </h3>

            <p class="text-sm text-[var(--text-muted)] font-sans leading-relaxed max-w-[75ch]">
              {item.description}
            </p>

            <div class="flex flex-wrap items-center gap-2 pt-1">
              {item.stack.map((tech) => (
                <span class="font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="font-mono text-xs text-[var(--text-accent)] shrink-0 self-start lg:self-center pt-2 lg:pt-0">
            <a href={`/cases/${item.slug}`} class="inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform" aria-label={`${item.title}`}>
              <span>İncele</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
