---
import { getCollection } from 'astro:content';
import { getPostSlug } from '../data/slugUtils';

const allPosts = await getCollection('posts');

const cornerstoneSlugs = [
  { slug: 'postgresql-mimarisi-ve-calisma-prensipleri', tag: 'MİMARİ' },
  { slug: 'postgresql-mvcc-transaction-ve-vacuum', tag: 'MVCC & VACUUM' },
  { slug: 'postgresql-kilit-mekanizmalari-ve-eszamanlilik', tag: 'KİLİTLER' },
  { slug: 'postgresql-wal-ve-checkpoint-mimarisi', tag: 'WAL & RECOVERY' },
  { slug: 'patroni-ile-postgresql-yuksek-erisebilirlik-ve-otomatik-failover', tag: 'PATRONİ HA' }
];

const featuredPosts = cornerstoneSlugs
  .map((item) => {
    const post = allPosts.find((p) => getPostSlug(p) === item.slug);
    return post ? { post, tag: item.tag } : null;
  })
  .filter((item): item is { post: NonNullable<typeof allPosts[number]>; tag: string } => item !== null);
---

<section id="showcase" class="py-8 sm:py-10 border-b border-[var(--border)] scroll-mt-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
    <!-- Sol Kutu: ÖNE ÇIKAN REHBERLER -->
    <div class="border border-[var(--border)] bg-[var(--bg-card)] rounded-[2px] p-5 sm:p-6 flex flex-col justify-between shadow-2xs">
      <div>
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-3 mb-3.5">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <h2 class="font-mono text-xs uppercase tracking-wider font-semibold text-[var(--text)]">
              Öne Çıkan Rehberler
            </h2>
          </div>
          <span class="font-mono text-[11px] text-[var(--text-dim)]">05 Çekirdek Seri</span>
        </div>

        <div class="space-y-2">
          {featuredPosts.map(({ post, tag }, idx) => {
            const slug = getPostSlug(post);
            return (
              <a
                href={`/posts/${slug}`}
                class="group block p-2 -mx-2 rounded-[2px] hover:bg-[var(--bg-subtle)] transition-colors border border-transparent hover:border-[var(--border)]"
              >
                <div class="flex items-start gap-2.5">
                  <span class="font-mono text-xs text-[var(--accent)] font-semibold shrink-0 mt-0.5">
                    0{idx + 1}.
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-2">
                      <h3 class="font-serif text-sm sm:text-[15px] font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors leading-snug line-clamp-1">
                        {post.data.title}
                      </h3>
                      <span class="font-mono text-[10px] text-[var(--text-dim)] shrink-0 hidden sm:inline">
                        #{tag}
                      </span>
                    </div>
                    <p class="text-xs text-[var(--text-muted)] font-sans line-clamp-1 mt-0.5 leading-relaxed">
                      {post.data.summary}
                    </p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <div class="pt-3.5 mt-3 border-t border-[var(--border)]/70 flex items-center justify-between text-xs font-mono">
        <span class="text-[var(--text-dim)]">Çekirdek PostgreSQL mimarisi</span>
        <a href="/ogrenme-rotasi" class="text-[var(--accent)] hover:underline inline-flex items-center gap-1 font-medium">
          <span>Öğrenme Rotası</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Sağ Kutu: MİMARİ ODAK & PRENSİPLER -->
    <div class="border border-[var(--border)] bg-[var(--bg-card)] rounded-[2px] p-5 sm:p-6 flex flex-col justify-between shadow-2xs">
      <div>
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-3 mb-3.5">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <h2 class="font-mono text-xs uppercase tracking-wider font-semibold text-[var(--text)]">
              Mimari Odak & Prensipler
            </h2>
          </div>
          <span class="font-mono text-[11px] text-[var(--text-dim)]">Üretim Kriterleri</span>
        </div>

        <div class="space-y-3.5 text-xs font-sans">
          <div class="space-y-0.5">
            <div class="flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--text)]">
              <span class="text-[var(--accent)]">▸</span>
              <span>Zero-Impact Katalog Çıkarımı</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed pl-3.5">
              Canlı üretim veritabanlarında tablo kilitlerini ve I/O yükünü engellemek için <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">pg_class.reltuples</code> ve sistem katalog istatistikleri üzerinden meta veri analizi.
            </p>
          </div>

          <div class="space-y-0.5">
            <div class="flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--text)]">
              <span class="text-[var(--accent)]">▸</span>
              <span>MVCC, HOT & Bloat Kontrolü</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed pl-3.5">
              <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">fillfactor</code>, Heap-Only Tuple zincirleri ve agresif autovacuum maliyet ayarlarıyla XID wraparound ve disk şişmesinin önlenmesi.
            </p>
          </div>

          <div class="space-y-0.5">
            <div class="flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--text)]">
              <span class="text-[var(--accent)]">▸</span>
              <span>Zero-Downtime DDL & Lock Güvenliği</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed pl-3.5">
              <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">CONCURRENTLY</code> indeksleme, <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">NOT VALID</code> kısıtlar ve kısa <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">lock_timeout</code> retry döngüleriyle Lock Queue Starvation önlemi.
            </p>
          </div>

          <div class="space-y-0.5">
            <div class="flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--text)]">
              <span class="text-[var(--accent)]">▸</span>
              <span>Konsensüs Tabanlı Yüksek Erişebilirlik (HA)</span>
            </div>
            <p class="text-[var(--text-muted)] leading-relaxed pl-3.5">
              Patroni ve etcd dağıtık konsensüs ile split-brain savunması, lider kiralama ve <code class="font-mono text-[11px] bg-[var(--bg-subtle)] px-1 py-0.5 rounded">pg_rewind</code> ile sıfır veri kaybı garantili otomatik failover.
            </p>
          </div>
        </div>
      </div>

      <div class="pt-3.5 mt-3 border-t border-[var(--border)]/70 flex items-center justify-between text-xs font-mono">
        <span class="text-[var(--text-dim)]">Odak Teknolojiler</span>
        <span class="text-[var(--text-dim)] font-mono text-[11px]">PostgreSQL · TimescaleDB · Patroni</span>
      </div>
    </div>
  </div>
</section>
