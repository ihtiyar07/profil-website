---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostSlug } from '../../data/slugUtils';
import { SITE_META } from '../../data/siteMeta';
import { getAdjacentNavItems, type FlatNavItem } from '../../data/navigation';
import {
  calculateReadingTime,
  getParentSlugSet,
  resolvePostBadge
} from '../../utils/postHelpers';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => {
    const slug = getPostSlug(entry);
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allPosts = await getCollection('posts');

const currentSlug = getPostSlug(entry);
const currentPath = `/posts/${currentSlug}`;

// Prev and Next documents resolved from the single-source-of-truth sidebar order:
const adjacent = getAdjacentNavItems(currentPath);

function resolveAdjacentDoc(item: FlatNavItem | null) {
  if (!item) return null;
  const post = allPosts.find((p) => `/posts/${getPostSlug(p)}` === item.href);
  return {
    href: item.href,
    title: post?.data.title || item.title,
    sectionTitle: item.sectionTitle,
    parentTitle: item.parentTitle
  };
}

const prevDoc = resolveAdjacentDoc(adjacent.prev);
const nextDoc = resolveAdjacentDoc(adjacent.next);

const parentSlugs = getParentSlugSet(allPosts);
const readingTime = calculateReadingTime(entry.body, entry.data.readingTime);
const badge = resolvePostBadge(entry, parentSlugs);

// Parent relationship logic for subtle breadcrumb / back-link:
const parentSlug = entry.data.parent;
const parentPost = parentSlug ? allPosts.find((p) => getPostSlug(p) === parentSlug) : null;

const tocHeadings = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3),
  { depth: 2, slug: 'kaynaklar', text: 'Kaynaklar & İleri Okuma' }
];
---

<BaseLayout 
  title={`${entry.data.title} — Ahmet İhtiyar`} 
  description={entry.data.summary}
  lang={entry.data.lang}
  translationKey={entry.data.translationKey}
  articleMeta={{ publishDate: entry.data.date, tags: entry.data.tags }}
  fullWidth={true}
>
  <div class="flex-1 w-full flex flex-col xl:flex-row items-stretch relative min-h-screen">
    <!-- Main Article Column (Centered with comfortable reading measure) -->
    <div id="article-main-col" class="flex-1 min-w-0 px-5 sm:px-8 lg:px-12 py-6 sm:py-10 transition-all duration-300 flex justify-center">
      <article class="w-full max-w-[860px] space-y-8">
        <!-- Header -->
        <div class="space-y-4 pb-6 border-b border-[var(--border)]">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5 font-mono text-xs text-[var(--text-dim)]">
              <a
                href="/#articles"
                class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1 transition-colors tactile-btn group"
                aria-label="Yazılar ve notlar listesine dön"
              >
                <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
                <span>Yazılar</span>
              </a>
              {parentPost && (
                <>
                  <span class="text-[var(--border-strong)]">/</span>
                  <a
                    href={`/posts/${getPostSlug(parentPost)}`}
                    class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors truncate max-w-[180px] sm:max-w-[280px]"
                    title={`Üst Döküman: ${parentPost.data.title}`}
                  >
                    {parentPost.data.title}
                  </a>
                </>
              )}
            </div>

            <div class="flex items-center gap-2 font-mono text-xs text-[var(--text-dim)] shrink-0">
              {badge && (
                <span class:list={[
                  'px-2 py-0.5 text-[10px] rounded-[2px] font-medium border',
                  badge === 'Ana Rehber'
                    ? 'bg-[var(--accent-subtle)] text-[var(--accent)] border-[var(--accent-border)]'
                    : 'bg-[var(--bg-subtle)] text-[var(--text-muted)] border-[var(--border-strong)]'
                ]}>
                  {badge}
                </span>
              )}
              <span>{readingTime}</span>
              <span aria-hidden="true">·</span>
              <time datetime={entry.data.date} style={`view-transition-name: post-date-${currentSlug};`}>
                {entry.data.date}
              </time>
            </div>
          </div>

        <h1 class="text-3xl sm:text-4xl lg:text-[2.5rem] font-serif text-[var(--text)] tracking-tight leading-[1.2]" style={`view-transition-name: post-title-${currentSlug};`}>
          {entry.data.title}
        </h1>

        <p class="text-base sm:text-lg text-[var(--text-muted)] font-sans leading-relaxed">
          {entry.data.summary}
        </p>

        <div class="flex flex-wrap items-center gap-1.5 pt-1">
          {entry.data.tags.map((tag) => (
            <a
              href={`/?tag=${encodeURIComponent(tag)}#articles`}
              class="font-mono text-[11px] px-2 py-0.5 rounded-[2px] bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--text-dim)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors cursor-pointer"
              title={`#${tag} etiketine ait yazıları filtrele`}
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile/Tablet Inline TOC (visible when xl sidebar is hidden) -->
      {tocHeadings.length > 0 && (
        <div class="xl:hidden p-4 bg-[var(--bg-subtle)]/60 border border-[var(--border)] rounded-[2px] space-y-2">
          <div class="text-xs font-mono text-[var(--text-dim)] uppercase tracking-wider font-semibold">
            İçindekiler
          </div>
          <nav class="space-y-1 text-xs">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block py-0.5 text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors',
                  h.depth === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}

      <!-- Article Content with Optimal Reading Typography -->
      <div class="prose max-w-none text-[var(--text)] space-y-6 [&>h2]:text-2xl [&>h2]:font-serif [&>h2]:pt-8 [&>h2]:pb-2 [&>h2]:border-t [&>h2]:border-[var(--border)] [&>h2]:text-[var(--text)] [&>h3]:text-xl [&>h3]:font-serif [&>h3]:pt-4 [&>h3]:pb-1 [&>h3]:text-[var(--text)] [&>p]:text-[15.5px] sm:[&>p]:text-[16px] [&>p]:leading-[1.75] [&>p]:text-[var(--text)] [&_strong]:font-semibold [&_strong]:text-[var(--text)] [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ul>li]:my-1.5 [&>ol>li]:my-1.5 [&>ul>li]:leading-relaxed [&>ol>li]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-[var(--accent)] [&>blockquote]:pl-4 [&>blockquote]:py-1 [&>blockquote]:italic [&>blockquote]:text-[var(--text-muted)] [&>code]:font-mono [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[13px] [&_:not(pre)>code]:bg-[var(--bg-subtle)] [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-[2px] [&_:not(pre)>code]:border [&_:not(pre)>code]:border-[var(--border)] [&>hr]:border-[var(--border)] [&>hr]:my-8 [&>hr:has(+h2)]:hidden [&>hr:has(+section#kaynaklar)]:hidden">
        <Content />
      </div>

      <!-- Article Bottom Navigation & Feedback -->
      <div class="pt-8 border-t border-[var(--border)] space-y-4">
        <!-- Top bar: Back link + Subtle feedback link -->
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2.5 font-mono text-xs text-[var(--text-dim)]">
          <a
            href="/#articles"
            class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] inline-flex items-center gap-1.5 transition-colors tactile-btn group"
            aria-label="Tüm yazılara dön"
          >
            <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">←</span>
            <span>Tüm Yazılar ve Notlar</span>
          </a>

          <a
            href={`mailto:${SITE_META.email}?subject=${encodeURIComponent(`Geri Bildirim: ${entry.data.title}`)}`}
            class="hover:text-[var(--text)] hover:underline inline-flex items-center gap-1 transition-colors text-[11px]"
          >
            <span>Yazı hakkında geri bildirim veya katkı ilet</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <!-- Next / Prev Article Navigation Cards -->
        <nav aria-label="Döküman gezintisi" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          {prevDoc ? (
            <a
              href={prevDoc.href}
              class="group px-3.5 py-2.5 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/30 hover:bg-[var(--bg-subtle)]/80 hover:border-[var(--accent-border)] transition-all flex flex-col justify-between gap-1"
            >
              <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors min-w-0">
                <span aria-hidden="true">←</span>
                <span>Önceki</span>
                <span class="text-[var(--border-strong)]">·</span>
                <span class="truncate">{prevDoc.sectionTitle}</span>
              </div>
              <span class="font-sans text-[12.5px] sm:text-[13px] font-medium text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 sm:line-clamp-2 leading-snug transition-colors">
                {prevDoc.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextDoc && (
            <a
              href={nextDoc.href}
              class="group px-3.5 py-2.5 rounded-[2px] border border-[var(--border)] bg-[var(--bg-subtle)]/30 hover:bg-[var(--bg-subtle)]/80 hover:border-[var(--accent-border)] transition-all flex flex-col justify-between gap-1 text-right sm:col-start-2"
            >
              <div class="flex items-center justify-end gap-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--text-dim)] group-hover:text-[var(--accent)] transition-colors min-w-0">
                <span class="truncate">{nextDoc.sectionTitle}</span>
                <span class="text-[var(--border-strong)]">·</span>
                <span>Sonraki</span>
                <span aria-hidden="true">→</span>
              </div>
              <span class="font-sans text-[12.5px] sm:text-[13px] font-medium text-[var(--text)] group-hover:text-[var(--accent)] line-clamp-1 sm:line-clamp-2 leading-snug transition-colors">
                {nextDoc.title}
              </span>
            </a>
          )}
        </nav>
      </div>
    </article>
    </div>

    <!-- Sticky Right Rail: Clean, borderless "On This Page" TOC -->
    <aside 
      id="article-right-panel"
      class="hidden xl:block w-56 2xl:w-64 shrink-0 pr-6 pl-2 py-10 space-y-5 self-start sticky top-0 max-h-screen overflow-y-auto select-none"
    >
      {tocHeadings.length > 0 && (
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-[10.5px] font-mono text-[var(--text-dim)] uppercase tracking-[0.08em] font-semibold">
            <svg class="w-3.5 h-3.5 text-[var(--text-dim)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h14" />
            </svg>
            <span>İçindekiler</span>
          </div>

          <nav aria-label="İçindekiler" class="border-l border-[var(--border)] space-y-0.5 text-[12px] font-sans max-h-[calc(100vh-10rem)] overflow-y-auto pr-2">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-heading-slug={h.slug}
                class:list={[
                  'toc-anchor-link block -ml-px border-l border-transparent py-1 transition-colors leading-snug',
                  h.depth === 3
                    ? 'pl-5 text-[11.5px] text-[var(--text-dim)] hover:text-[var(--text)]'
                    : 'pl-3 text-[var(--text-muted)] hover:text-[var(--text)] font-medium'
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}

      {parentPost && (
        <div class="pt-3 border-t border-[var(--border)]/60">
          <a
            href={`/posts/${getPostSlug(parentPost)}`}
            class="group flex items-start gap-1.5 text-[11.5px] text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors leading-snug"
            title={`Üst Rehber: ${parentPost.data.title}`}
          >
            <span class="font-mono text-[var(--text-dim)] group-hover:text-[var(--accent)] group-hover:-translate-x-0.5 transition-all shrink-0" aria-hidden="true">←</span>
            <span class="line-clamp-2">{parentPost.data.title}</span>
          </a>
        </div>
      )}

      <!-- Jump to Top Link -->
      <div class="pt-2 border-t border-[var(--border)]/60">
        <a
          href="#main-content"
          class="font-mono text-[11px] text-[var(--text-dim)] hover:text-[var(--text)] inline-flex items-center gap-1.5 transition-colors"
        >
          <span aria-hidden="true">↑</span>
          <span>Başa Dön</span>
        </a>
      </div>
    </aside>
  </div>

  <!-- Table of Contents Scrollspy Script -->
  <script is:inline>
    (function() {
    function initArticlePage() {
      // Scrollspy for Table of Contents
      const tocLinks = document.querySelectorAll('.toc-anchor-link');
      if (!tocLinks.length) return;

      const headings = Array.from(document.querySelectorAll('h2[id], h3[id]'));
      if (!headings.length) return;

      function onScroll() {
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        const windowHeight = window.innerHeight;
        const docHeight = document.documentElement.scrollHeight;
        const isNearBottom = (windowHeight + scrollY) >= (docHeight - 120);

        let currentActive = null;

        if (isNearBottom) {
          // When scrolled near or to the bottom of the page, choose the last visible heading
          for (let i = headings.length - 1; i >= 0; i--) {
            const rect = headings[i].getBoundingClientRect();
            if (rect.top < windowHeight - 40) {
              currentActive = headings[i].id;
              break;
            }
          }
          if (!currentActive && headings.length > 0) {
            currentActive = headings[headings.length - 1].id;
          }
        } else {
          // Normal reading line: heading passing 140px threshold
          const threshold = 140;
          for (let i = 0; i < headings.length; i++) {
            const rect = headings[i].getBoundingClientRect();
            if (rect.top <= threshold) {
              currentActive = headings[i].id;
            } else {
              break;
            }
          }
          if (!currentActive && headings.length > 0) {
            currentActive = headings[0].id;
          }
        }

        let activeLink = null;
        tocLinks.forEach(link => {
          const slug = link.getAttribute('data-heading-slug');
          if (slug === currentActive) {
            link.classList.remove('border-transparent');
            link.classList.add('text-[var(--accent)]', 'font-medium', 'border-[var(--accent)]');
            activeLink = link;
          } else {
            link.classList.remove('text-[var(--accent)]', 'font-medium', 'border-[var(--accent)]');
            link.classList.add('border-transparent');
          }
        });

        // Auto-scroll active item into view inside the TOC container if needed
        if (activeLink) {
          activeLink.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      }

      // Add instant click sync to all TOC links
      tocLinks.forEach(link => {
        link.addEventListener('click', () => {
          setTimeout(onScroll, 80);
        });
      });

      window.removeEventListener('scroll', window.__articleScrollHandler);
      window.__articleScrollHandler = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initArticlePage);
    } else {
      initArticlePage();
    }
    document.addEventListener('astro:page-load', initArticlePage);
  })();
  </script>
</BaseLayout>
