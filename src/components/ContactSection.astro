---
import { SITE_META } from '../data/siteMeta';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="contact" class="py-12 sm:py-16 border-b border-[var(--border)]">
  <!-- Section Title -->
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <span class="font-mono text-xs text-[#E8590C] uppercase tracking-wider font-semibold">
        07 — {isTr ? 'İletişim & Kanallar' : 'Contact Channels'}
      </span>
      <span class="h-px w-8 bg-[var(--border)]"></span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-2">
      <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
        {isTr ? 'İletişime Geçin' : 'Get in Touch'}
      </h2>
      <p class="font-mono text-xs text-[var(--text-dim)]">
        {isTr ? 'Form yok · Doğrudan doğrudan temas' : 'No web forms · Direct contact channels'}
      </p>
    </div>
  </div>

  <!-- Contact Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
    <!-- Email -->
    <a
      href={`mailto:${SITE_META.email}`}
      class="p-4 bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C] rounded-[2px] transition-colors group block space-y-1"
    >
      <div class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider">
        {isTr ? 'E-posta' : 'Email'}
      </div>
      <div class="font-serif text-base text-[var(--text)] group-hover:text-[#E8590C] transition-colors truncate">
        {SITE_META.email}
      </div>
      <div class="font-mono text-[10px] text-[#E8590C] pt-1">
        {isTr ? 'Mesaj Gönder ↗' : 'Send Direct Mail ↗'}
      </div>
    </a>

    <!-- GitHub -->
    <a
      href={SITE_META.github}
      target="_blank"
      rel="noopener noreferrer"
      class="p-4 bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C] rounded-[2px] transition-colors group block space-y-1"
    >
      <div class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider">
        GitHub
      </div>
      <div class="font-serif text-base text-[var(--text)] group-hover:text-[#E8590C] transition-colors">
        github.com/ihtiyar07
      </div>
      <div class="font-mono text-[10px] text-[#E8590C] pt-1">
        {isTr ? 'Depoları İncele ↗' : 'Inspect Repositories ↗'}
      </div>
    </a>

    <!-- LinkedIn -->
    <a
      href={SITE_META.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="p-4 bg-[var(--bg)] border border-[var(--border)] hover:border-[#E8590C] rounded-[2px] transition-colors group block space-y-1"
    >
      <div class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider">
        LinkedIn
      </div>
      <div class="font-serif text-base text-[var(--text)] group-hover:text-[#E8590C] transition-colors">
        in/ahmet-ihtiyar
      </div>
      <div class="font-mono text-[10px] text-[#E8590C] pt-1">
        {isTr ? 'Ağa Bağlan ↗' : 'Connect on LinkedIn ↗'}
      </div>
    </a>

    <!-- Resume / CV PDF -->
    <a
      href={SITE_META.cvPath}
      target="_blank"
      rel="noopener noreferrer"
      class="p-4 bg-[var(--bg-subtle)] border border-[var(--border-strong)] hover:border-[#E8590C] rounded-[2px] transition-colors group block space-y-1"
    >
      <div class="font-mono text-[11px] text-[#E8590C] uppercase tracking-wider font-semibold">
        {isTr ? 'Özgeçmiş' : 'Curriculum Vitae'}
      </div>
      <div class="font-serif text-base text-[var(--text)] group-hover:text-[#E8590C] transition-colors">
        {isTr ? 'CV (PDF İndir)' : 'Download PDF CV'}
      </div>
      <div class="font-mono text-[10px] text-[var(--text-dim)] pt-1">
        {isTr ? 'Güncel Sürüm ↓' : 'Latest Release ↓'}
      </div>
    </a>
  </div>
</section>
