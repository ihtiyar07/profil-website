---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DataPipeline from '../../components/DataPipeline.astro';
import CaseFiles from '../../components/CaseFiles.astro';
import SecondaryProjects from '../../components/SecondaryProjects.astro';
import Invariants from '../../components/Invariants.astro';
import ContactSection from '../../components/ContactSection.astro';
---

<BaseLayout lang="en">
  <!-- 00. Hero: Headline, Now line, 2 Actions, Portrait Photo -->
  <Hero lang="en" />

  <!-- 01. Backbone: "The Path of Data" Interactive Pipeline & Infrastructure Ground -->
