---
export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

const navItems = isTr ? [
  { href: '#pipeline', label: 'Verinin Yolu' },
  { href: '#cases', label: 'Vakalar' },
  { href: '#secondary-projects', label: 'Sistemler' },
  { href: '#invariants', label: 'İlkeler' },
  { href: '#contact', label: 'İletişim' }
] : [
  { href: '/en#pipeline', label: 'Path of Data' },
  { href: '/en#cases', label: 'Cases' },
  { href: '/en#secondary-projects', label: 'Systems' },
  { href: '/en#invariants', label: 'Invariants' },
  { href: '/en#contact', label: 'Contact' }
];

const homeUrl = isTr ? '/' : '/en';
const targetLangUrl = isTr ? '/en' : '/';
---

<header class="w-full border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 h-14 flex items-center justify-between">
    <!-- Brand / Identity -->
    <a href={homeUrl} class="flex items-center gap-2.5 group focus:outline-none" aria-label="Ahmet İhtiyar">
      <span class="w-2 h-2 rounded-full bg-[var(--status-green)] inline-block transition-transform group-hover:scale-125"></span>
      <span class="font-sans text-sm font-semibold tracking-tight text-[var(--text)]">
        Ahmet İhtiyar
      </span>
      <span class="hidden sm:inline font-mono text-[11px] text-[var(--text-dim)] border-l border-[var(--border)] pl-2.5">
        {isTr ? 'Sistem & Telemetri' : 'Systems & Telemetry'}
      </span>
    </a>

    <!-- Nav & Actions -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="hidden md:flex items-center gap-5 text-[13px] font-sans" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors py-1 hover:underline underline-offset-4 decoration-[var(--accent)]"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 pl-3 border-l border-[var(--border)]">
        <!-- Language Switcher -->
        <a
          href={targetLangUrl}
          class="font-mono text-xs px-2 py-1 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] border border-[var(--border)] transition-colors tactile-btn"
          title={isTr ? "Switch to English" : "Türkçe'ye Geç"}
          aria-label={isTr ? "Switch to English" : "Türkçe'ye Geç"}
        >
          {isTr ? 'EN' : 'TR'}
        </a>

        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="font-mono text-xs p-1.5 rounded-[2px] text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] border border-[var(--border)] transition-colors cursor-pointer tactile-btn flex items-center justify-center w-8 h-8"
          aria-label={isTr ? "Temayı Değiştir" : "Toggle theme"}
          title={isTr ? "Temayı Değiştir" : "Toggle Theme"}
        >
          <!-- Sun Icon (in dark mode) -->
          <svg id="theme-icon-sun" class="w-3.5 h-3.5 hidden text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon Icon (in light mode) -->
          <svg id="theme-icon-moon" class="w-3.5 h-3.5 hidden text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Quick Scroller -->
  <div class="md:hidden border-t border-[var(--border)] bg-[var(--bg)]/95 px-4 py-2 overflow-x-auto no-scrollbar flex items-center gap-4 text-xs font-sans whitespace-nowrap">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors py-0.5"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        moonIcon?.classList.remove('hidden');
        sunIcon?.classList.add('hidden');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    btn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (_) {}
      updateThemeUI(next);
    });
  })();
</script>
