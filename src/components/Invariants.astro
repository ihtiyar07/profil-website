---
import { INVARIANTS } from '../data/invariants';
---

<section id="invariants" class="py-14 sm:py-20 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-2 mb-10 max-w-2xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      Mimari İlkeler
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Veritabanı ve depolama sistemleri tasarlarken benimsediğim temel kurallar.
    </p>
  </div>

  <!-- Invariants List -->
  <div class="border-t border-[var(--border)] divide-y divide-[var(--border)]">
    {INVARIANTS.map((item) => (
      <article class="py-6 sm:py-8 space-y-2.5">
        <div class="flex items-center gap-2 font-mono text-xs text-[var(--text-dim)]">
          <span class="text-[var(--text-accent)] font-semibold">{item.badge}</span>
          <span>·</span>
          <span class="text-[var(--text-muted)] font-medium">{item.title}</span>
        </div>

        <h3 class="font-serif text-lg sm:text-xl text-[var(--text)] font-medium leading-snug">
          {item.rule}
        </h3>

        {item.failureMode && (
          <div class="text-xs font-mono text-[var(--text-dim)] bg-[var(--bg-subtle)] px-3 py-2 rounded-[2px] border border-[var(--border)] max-w-[75ch]">
            <span class="text-[var(--accent)] font-semibold">Kritik Risk:</span> {item.failureMode}
          </div>
        )}

        <p class="text-sm text-[var(--text-muted)] font-sans leading-relaxed max-w-[75ch]">
          {item.solution}
        </p>

        <div class="text-[11px] font-mono text-[var(--text-dim)] pt-1">
          <span>Doğrulama: </span>
          <span class="text-[var(--text-muted)]">{item.verification}</span>
        </div>
      </article>
    ))}
  </div>
</section>
