        dcs: `// etcd failover kaydı ve yeni lider:
/service/postgres-ha/failover:
{"leader": "pg-node-2", "candidate": "pg-node-2", "scheduled_at": "2026-11-10T14:45:10Z"}

/service/postgres-ha/leader:
{"version": "3.3.0", "role": "primary", "state": "running", "leader": "pg-node-2"}`,
        haproxy: `# HAProxy sağlık kontrolü pg-node-1'i havuzdan anında düşürür:
$ curl -s -i --connect-timeout 1 http://192.168.10.11:8008/primary
