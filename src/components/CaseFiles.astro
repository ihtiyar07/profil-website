---
const systems = [
  {
    href: '/posts/timescaledb-mimarisi-ve-kullanim-rehberi',
    id: '01',
    title: 'TimescaleDB: Zaman Serisi Depolama ve Hypertables',
    description: 'Docker ile hızlı kurulum, 10M satırlık telemetri benchmark’ı, RAM odaklı chunk partitioning, continuous aggregates ve time_bucket_gapfill analitiği.',
    stack: ['PostgreSQL', 'TimescaleDB', 'Docker', 'Zstd Sıkıştırma']
  },
  {
    href: '/cases/apache-arrow',
    id: '02',
    title: 'Apache Arrow: Zero-Copy Veri Akışı',
    description: 'Büyük analitik sorgu sonuçlarının JSON serileştirme darboğazına girmeden doğrudan Arrow RecordBatch IPC akışıyla client belleğine eşlenmesi.',
    stack: ['Apache Arrow', '.NET 10', 'TypeScript', 'HTTP/2']
  }
];
---

<section id="systems" class="py-10 sm:py-14 border-b border-[var(--border)] scroll-mt-16">
  <!-- Anchor alias for legacy links -->
  <span id="cases" class="sr-only" aria-hidden="true"></span>

  <div class="space-y-1.5 mb-6 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
      Sistemler & Çalışmalar
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-muted)] font-sans leading-relaxed">
      Üretim ortamlarında tasarlanan ve çalıştırılan veritabanı altyapıları ve mimari çalışmalar.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    {systems.map((item) => (
      <article class="group border border-[var(--border)] bg-[var(--bg-subtle)]/40 hover:bg-[var(--bg-subtle)] hover:border-[var(--border-strong)] transition-all p-5 sm:p-6 rounded-[2px] flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)]">
            <span class="text-[var(--text-accent)] font-semibold">{item.id} · Vaka Dosyası</span>
            <span class="text-[10px] text-[var(--text-dim)]">Mimari</span>
          </div>

          <h3 class="font-serif text-lg sm:text-xl text-[var(--text)] group-hover:text-[var(--text-accent)] transition-colors leading-snug">
            <a href={item.href} class="focus:outline-none hover:underline underline-offset-4 decoration-[var(--accent)]">
              {item.title}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-[var(--text-muted)] font-sans leading-relaxed">
            {item.description}
          </p>
        </div>

        <div class="pt-4 mt-4 border-t border-[var(--border)]/70 space-y-3">
          <div class="flex flex-wrap items-center gap-1.5">
            {item.stack.map((tech) => (
              <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-[2px] bg-[var(--bg)] border border-[var(--border)] text-[var(--text-dim)]">
                {tech}
              </span>
            ))}
          </div>

          <div class="pt-1 flex justify-end">
            <a href={item.href} class="font-mono text-xs text-[var(--text-accent)] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform" aria-label={`${item.title}`}>
              <span>İncele</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
