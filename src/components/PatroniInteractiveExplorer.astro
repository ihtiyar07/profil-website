    function updateScenario(key) {
      activeScenarioKey = key;
      const data = patroniScenarios[key];
      if (!data) return;

      scenarioBtns.forEach(btn => {
        if (btn.getAttribute('data-scenario') === key) {
          btn.classList.remove('bg-[var(--bg)]', 'text-[var(--text-muted)]');
          btn.classList.add('bg-[var(--text)]', 'text-[var(--bg)]', 'font-medium');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.remove('bg-[var(--text)]', 'text-[var(--bg)]', 'font-medium');
          btn.classList.add('bg-[var(--bg)]', 'text-[var(--text-muted)]');
          btn.setAttribute('aria-selected', 'false');
        }
      });

      if (descEl) descEl.textContent = data.desc;
      if (step1El) step1El.textContent = data.step1;
      if (step2El) step2El.textContent = data.step2;
      if (step3El) step3El.textContent = data.step3;
      if (step4El) step4El.textContent = data.step4;
      if (noteEl) noteEl.textContent = data.note;

      // Update Topo Node 1
      if (roleNode1) {
        roleNode1.textContent = data.node1.role;
        roleNode1.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium border ' + data.node1.roleClass;
      }
      if (tlNode1) tlNode1.textContent = data.node1.tl;
      if (stateNode1) {
        stateNode1.textContent = data.node1.state;
        stateNode1.className = data.node1.stateClass;
      }

      // Update Topo Node 2
      if (roleNode2) {
        roleNode2.textContent = data.node2.role;
        roleNode2.className = 'px-1.5 py-0.5 text-[10px] rounded-[2px] font-medium border ' + data.node2.roleClass;
      }
      if (tlNode2) tlNode2.textContent = data.node2.tl;
      if (stateNode2) {
