---
import { PIPELINE_STOPS, INFRASTRUCTURE_STRIP } from '../data/pipelineStops';

export interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';
---

<section id="pipeline" class="py-16 sm:py-24 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="space-y-4 mb-10 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-[var(--text)] tracking-tight">
      {isTr ? 'Verinin Yolu' : 'The Path of Data'}
    </h2>
    <p class="text-base text-[var(--text-muted)] font-sans leading-relaxed">
      {isTr 
        ? "Fiziksel sensörden resmi e-imzalı rapora kadar uzanan 6 istasyonlu telemetri omurgası. Saha kısıtlarına, hücresel kesintilere ve yüksek veri hacmine karşı bizzat geliştirdiğim savunma ve aktarım katmanları." 
        : "A 6-station telemetry and data processing backbone from physical sensor to signed audit report. Hardened against industrial field dropouts, network partitions, and massive data volume."}
    </p>
  </div>

  <!-- Interactive Telemetry Pipeline Rail -->
  <div class="space-y-8">
    <!-- Station Selector Rail (Desktop & Mobile) -->
    <div class="border-y border-[var(--border)] overflow-x-auto no-scrollbar py-1">
      <div 
        class="grid grid-cols-6 min-w-[720px] divide-x divide-[var(--border)]" 
        role="tablist" 
        aria-label={isTr ? "Veri Hattı Durakları" : "Data Pipeline Stations"}
      >
        {PIPELINE_STOPS.map((stop, idx) => (
          <button
            type="button"
            role="tab"
            class={`pipeline-tab-btn text-left p-3.5 sm:p-4 transition-all cursor-pointer tactile-btn group ${idx === 0 ? 'bg-[var(--bg-subtle)] text-[var(--text)]' : 'bg-transparent text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]/50'}`}
            data-stop-id={stop.id}
            data-index={idx}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${stop.id}`}
            id={`tab-${stop.id}`}
            tabindex={idx === 0 ? "0" : "-1"}
          >
            <div class="flex items-center justify-between gap-1 mb-2">
              <span class="font-mono text-xs font-semibold text-[var(--text-accent)]">
                {stop.order}
              </span>
              <span class="font-mono text-[11px] text-[var(--text-dim)] uppercase tracking-wider hidden sm:inline">
                {stop.badge[lang]}
              </span>
            </div>
            <div class="font-sans font-medium text-xs sm:text-sm text-[var(--text)] group-hover:text-[var(--text-accent)] transition-colors line-clamp-1">
              {stop.name[lang]}
            </div>
            <div class="font-mono text-[11px] text-[var(--text-dim)] truncate mt-1">
              {stop.tech[0]}
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Station Detailed Inspector Sheet -->
    <div class="py-2">
      {PIPELINE_STOPS.map((stop, idx) => (
        <div
          id={`panel-${stop.id}`}
          class={`pipeline-station-panel ${idx === 0 ? 'block' : 'hidden'} space-y-8`}
          role="tabpanel"
          aria-labelledby={`tab-${stop.id}`}
        >
          <!-- Station Header -->
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 pb-6 border-b border-[var(--border)]">
            <div class="space-y-1">
              <div class="flex items-center gap-2 font-mono text-xs text-[var(--text-dim)]">
                <span class="text-[var(--text-accent)] font-semibold">{isTr ? 'İstasyon' : 'Station'} {stop.order}</span>
                <span>·</span>
                <span>{stop.badge[lang]}</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
                {stop.name[lang]}
              </h3>
            </div>

            <!-- Tech Stack Pills -->
            <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-[var(--text-muted)]">
              {stop.tech.map((t) => (
                <span class="px-2 py-0.5 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px] text-[var(--text-muted)] text-[11px]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <!-- 2-Column Deep Architecture Specification -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 text-sm font-sans">
            <!-- Left 6 Columns: Core Function & Architectural Rationale -->
            <div class="lg:col-span-6 space-y-6">
              <div class="space-y-2">
                <h4 class="font-mono text-xs font-semibold text-[var(--text-accent)] uppercase tracking-wider">
                  {isTr ? 'Çekirdek İşlev' : 'Core Function'}
                </h4>
                <p class="text-[var(--text)] leading-relaxed text-[14.5px]">
                  {stop.whatIDid[lang]}
                </p>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <h4 class="font-mono text-xs font-semibold text-[var(--text)] uppercase tracking-wider">
                  {isTr ? 'Mimari Karar Gerekçesi' : 'Architectural Rationale'}
                </h4>
                <p class="text-[var(--text-muted)] leading-relaxed text-[14px]">
                  {stop.whyDecision[lang]}
                </p>
              </div>

              <div class="space-y-2 pt-4 border-t border-[var(--border)]">
                <h4 class="font-mono text-xs font-semibold text-[var(--text-dim)] uppercase tracking-wider">
                  {isTr ? 'Elenen Alternatif Yöntem' : 'Eliminated Alternative'}
                </h4>
                <p class="text-[var(--text-muted)] leading-relaxed text-[13.5px]">
                  {stop.alternativeEliminated[lang]}
                </p>
              </div>
            </div>

            <!-- Right 6 Columns: Field Defense, Edge Cases & Case Link -->
            <div class="lg:col-span-6 space-y-6">
              <!-- Field Defense Specification (Clean, No Box-in-Box) -->
              <div class="space-y-3 pt-1">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[var(--text-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <h4 class="font-mono text-xs font-semibold text-[var(--text-accent)] uppercase tracking-wider">
                    {isTr ? 'Saha Riski ve Savunma Mekanizması' : 'Field Risk & Defense Strategy'}
                  </h4>
                </div>
                <p class="text-[var(--text)] leading-relaxed text-[14px] pl-6 border-l border-[var(--border-strong)]">
                  {stop.challenge[lang]}
                </p>
              </div>

              <!-- Case Link -->
              <div class="pt-6 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono">
                <span class="text-[var(--text-dim)]">
                  {isTr ? 'Doğrulandığı Dosya:' : 'Verified Dossier:'}
                </span>
                <a
                  href={stop.caseLink.href}
                  class="text-[var(--text-accent)] hover:text-[var(--accent-hover)] font-medium inline-flex items-center gap-1 hover:underline"
                >
                  <span>{stop.caseLink.text[lang]}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Infrastructure Ground Plane Strip -->
    <div class="pt-8 border-t border-[var(--border)]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono text-[var(--text-dim)]">
        <div class="flex items-center gap-2 text-[var(--text)] font-medium">
          <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
          <span>{isTr ? 'Altyapı Temeli' : 'Infrastructure Bedrock'}</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
          {INFRASTRUCTURE_STRIP.map((infra) => (
            <span class="hover:text-[var(--text)] transition-colors" title={infra.desc[lang]}>
              {infra.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Interactive Station Switcher Script -->
<script is:inline>
  (function() {
    function setupPipelineTabs() {
      const tabs = Array.from(document.querySelectorAll('.pipeline-tab-btn'));
      const panels = Array.from(document.querySelectorAll('.pipeline-station-panel'));

      function activateStation(index) {
        tabs.forEach((tab, i) => {
          const isSelected = i === index;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.tabIndex = isSelected ? 0 : -1;
          if (isSelected) {
            tab.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text)]');
            tab.classList.remove('bg-transparent', 'text-[var(--text-muted)]');
          } else {
            tab.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text)]');
            tab.classList.add('bg-transparent', 'text-[var(--text-muted)]');
          }
        });

        panels.forEach((panel, i) => {
          if (i === index) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activateStation(idx));
        tab.addEventListener('keydown', (e) => {
          let nextIdx = null;
          if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') nextIdx = 0;
          else if (e.key === 'End') nextIdx = tabs.length - 1;

          if (nextIdx !== null) {
            e.preventDefault();
            activateStation(nextIdx);
            tabs[nextIdx].focus();
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPipelineTabs);
    } else {
      setupPipelineTabs();
    }
  })();
</script>
