  function findExplanation(nodeId: string, nodeText: string) {
    const cleanId = nodeId.toLowerCase();
    const cleanText = nodeText.toLowerCase();

    for (const [key, value] of Object.entries(EXPLANATIONS)) {
      if (cleanId.includes(key) || cleanText.includes(key)) {
        return value;
      }
    }
    return null;
  }

  function setupInteractiveDetails(figure: HTMLElement) {
    const panel = figure.querySelector('.mermaid-details-panel') as HTMLElement | null;
    if (!panel) return;

    const defaultView = panel.querySelector('.details-default-view') as HTMLElement;
    const activeView = panel.querySelector('.details-active-view') as HTMLElement;
    const roleEl = panel.querySelector('.details-role') as HTMLElement;
    const titleEl = panel.querySelector('.details-title') as HTMLElement;
    const descEl = panel.querySelector('.details-desc') as HTMLElement;
    const extraEl = panel.querySelector('.details-extra') as HTMLElement;
    const resetBtn = panel.querySelector('.details-reset-btn') as HTMLElement;

    let selectedNode: Element | null = null;

    function clearSelection() {
      if (selectedNode) {
        selectedNode.classList.remove('selected-node');
        selectedNode.removeAttribute('aria-current');
        selectedNode = null;
      }
      activeView.classList.add('hidden');
      defaultView.classList.remove('hidden');
    }

    function selectNode(node: Element, exp: { title: string; role: string; desc: string; detail?: string }) {
      if (selectedNode) {
        selectedNode.classList.remove('selected-node');
        selectedNode.removeAttribute('aria-current');
      }
      selectedNode = node;
      node.classList.add('selected-node');
      node.setAttribute('aria-current', 'true');

      roleEl.textContent = exp.role || 'BİLEŞEN';
      titleEl.textContent = exp.title;
      descEl.textContent = exp.desc;
      if (exp.detail) {
        extraEl.textContent = exp.detail;
        extraEl.classList.remove('hidden');
      } else {
        extraEl.classList.add('hidden');
      }
      defaultView.classList.add('hidden');
      activeView.classList.remove('hidden');
    }

    resetBtn?.addEventListener('click', clearSelection);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && selectedNode) {
        clearSelection();
      }
    });

    const nodes = figure.querySelectorAll('.mermaid-diagram svg .node');
    nodes.forEach((node) => {
      const text = node.textContent || '';
      const exp = findExplanation(node.id, text);
      if (!exp) return;

      node.setAttribute('tabindex', '0');
      node.setAttribute('role', 'button');
      node.setAttribute('aria-label', `${exp.title} detaylarını göster`);
      node.classList.add('cursor-pointer');

      node.addEventListener('click', (e) => {
        e.stopPropagation();
        if (selectedNode === node) {
          clearSelection();
        } else {
          selectNode(node, exp);
        }
      });

      node.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          ke.stopPropagation();
          if (selectedNode === node) {
            clearSelection();
          } else {
            selectNode(node, exp);
          }
        }
      });
    });
  }

  function setupTabs(figure: HTMLElement) {
    const tabList = figure.querySelector('.mermaid-tablist') as HTMLElement | null;
    if (!tabList) return;

    const tabs = Array.from(figure.querySelectorAll('.mermaid-tab-btn')) as HTMLButtonElement[];
    const panes = Array.from(figure.querySelectorAll('.mermaid-tabpane')) as HTMLElement[];
    const summaries = Array.from(figure.querySelectorAll('.mermaid-text-summary')) as HTMLElement[];

    function switchTab(newTab: HTMLButtonElement, shouldFocus = true) {
      const tabId = newTab.getAttribute('data-tab-id');
      if (!tabId) return;

      tabs.forEach((tab) => {
        const isSelected = tab === newTab;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.tabIndex = isSelected ? 0 : -1;
        if (isSelected) {
          tab.className = 'mermaid-tab-btn px-3 py-1.5 rounded-[2px] transition-all cursor-pointer border whitespace-nowrap text-xs bg-[var(--bg-card)] text-[var(--accent)] font-semibold border-[var(--border)] shadow-xs';
        } else {
          tab.className = 'mermaid-tab-btn px-3 py-1.5 rounded-[2px] transition-all cursor-pointer border whitespace-nowrap text-xs text-[var(--text-dim)] hover:text-[var(--text)] border-transparent hover:bg-[var(--bg-subtle)]';
        }
      });

      panes.forEach((pane) => {
        const match = pane.id.endsWith(`-pane-${tabId}`);
        if (match) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.add('hidden');
          pane.classList.remove('block');
        }
      });

      summaries.forEach((sum) => {
        const match = sum.getAttribute('data-summary-for') === tabId;
        if (match) {
          sum.classList.remove('hidden');
          sum.classList.add('block');
        } else {
          sum.classList.add('hidden');
          sum.classList.remove('block');
        }
      });

      // Clear details panel selection on tab switch
      const panel = figure.querySelector('.mermaid-details-panel') as HTMLElement | null;
      if (panel) {
        const defaultView = panel.querySelector('.details-default-view') as HTMLElement;
        const activeView = panel.querySelector('.details-active-view') as HTMLElement;
        defaultView?.classList.remove('hidden');
        activeView?.classList.add('hidden');
        figure.querySelectorAll('.selected-node').forEach(el => el.classList.remove('selected-node'));
      }

      if (shouldFocus) {
        newTab.focus();
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => switchTab(tab, false));

      tab.addEventListener('keydown', (e) => {
        let targetIndex = index;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          targetIndex = (index + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          targetIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          targetIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          targetIndex = tabs.length - 1;
        }
        if (targetIndex !== index) {
          switchTab(tabs[targetIndex], true);
        }
      });
    });
  }

  function setupFullscreenModal(figure: HTMLElement) {
    const btn = figure.querySelector('.mermaid-fullscreen-btn') as HTMLButtonElement | null;
    const modal = figure.querySelector('.mermaid-modal') as HTMLElement | null;
    if (!btn || !modal) return;

    const closeBtn = modal.querySelector('.modal-close-btn') as HTMLButtonElement | null;
    const modalContent = modal.querySelector('.modal-content') as HTMLElement | null;
    const modalTitle = modal.querySelector('.modal-title') as HTMLElement | null;

    function openModal() {
      const activePane = figure.querySelector('.mermaid-tabpane:not(.hidden)') || figure.querySelector('.mermaid-diagrams-wrap');
      const svg = activePane?.querySelector('svg');
      if (!svg || !modalContent) return;

      modalContent.innerHTML = '';
      const clonedSvg = svg.cloneNode(true) as SVGElement;
      clonedSvg.style.maxWidth = '100%';
      clonedSvg.style.maxHeight = '82vh';
      clonedSvg.style.width = 'auto';
      clonedSvg.style.height = 'auto';
      clonedSvg.style.margin = 'auto';
      modalContent.appendChild(clonedSvg);

      const activeTab = figure.querySelector('.mermaid-tab-btn[aria-selected="true"]');
      if (activeTab && modalTitle) {
        modalTitle.textContent = `${activeTab.textContent?.trim()} (Tam Ekran Görünüm)`;
      }

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (modalContent) modalContent.innerHTML = '';
      btn.focus();
    }

    btn.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as HTMLElement).classList.contains('modal-content')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  function renderAllMermaid() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
      (!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      fontFamily: "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif",
      securityLevel: 'loose',
      themeVariables: isDark ? {
        darkMode: true,
        background: '#11141B',
        primaryColor: '#1E293B',
        primaryTextColor: '#F8FAFC',
        primaryBorderColor: '#60A5FA',
        lineColor: '#94A3B8',
        secondaryColor: '#134E4A',
        tertiaryColor: '#292524',
        mainBkg: '#161B24',
        nodeBorder: '#475569',
        clusterBkg: '#0D1017',
        clusterBorder: '#334155',
        edgeLabelBackground: '#161B24',
        fontSize: '14px'
      } : {
        darkMode: false,
        background: '#FFFFFF',
        primaryColor: '#EFF6FF',
        primaryTextColor: '#0F172A',
        primaryBorderColor: '#2563EB',
        lineColor: '#475569',
        secondaryColor: '#F0FDFA',
        tertiaryColor: '#F5F5F4',
        mainBkg: '#FFFFFF',
        nodeBorder: '#CBD5E1',
        clusterBkg: '#F8FAFC',
        clusterBorder: '#CBD5E1',
        edgeLabelBackground: '#FFFFFF',
        fontSize: '14px'
      }
    });

    const diagrams = document.querySelectorAll('.mermaid-diagram:not([data-processed="true"])');
    diagrams.forEach(async (el) => {
      const code = el.getAttribute('data-code');
      if (!code) return;
      el.setAttribute('data-processed', 'true');
      try {
        const id = 'svg-' + el.id + '-' + Math.random().toString(36).substring(2, 6);
        const { svg } = await mermaid.render(id, code.trim());
        el.innerHTML = svg;

        const figure = el.closest('.mermaid-container') as HTMLElement;
        if (figure) {
          setupInteractiveDetails(figure);
          setupTabs(figure);
          setupFullscreenModal(figure);
        }
      } catch (err) {
        console.error('Mermaid render error:', err);
        el.innerHTML = `
          <div class="p-4 text-xs font-mono text-[var(--text-dim)] border border-[var(--border)] bg-[var(--bg-card)] rounded-[2px] text-center space-y-2">
            <p>Diyagram yüklenirken bir sorun oluştu.</p>
            <pre class="text-[11px] text-[var(--text-muted)] p-2 bg-[var(--bg-code)] overflow-x-auto text-left">${code.trim()}</pre>
          </div>
        `;
      }
    });
  }

  // Run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderAllMermaid);
  } else {
    renderAllMermaid();
  }
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.mermaid-diagram').forEach(el => el.removeAttribute('data-processed'));
    renderAllMermaid();
  });

  // Re-render when theme changes
  const themeObserver = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.attributeName === 'data-theme') {
        document.querySelectorAll('.mermaid-diagram').forEach(el => el.removeAttribute('data-processed'));
        renderAllMermaid();
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Also listen for system dark mode changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!document.documentElement.getAttribute('data-theme')) {
      document.querySelectorAll('.mermaid-diagram').forEach(el => el.removeAttribute('data-processed'));
      renderAllMermaid();
    }
  });
</script>
