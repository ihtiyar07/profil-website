---
import { getCollection } from 'astro:content';
import { getPostSlug } from '../data/slugUtils';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Collect all tags and counts
const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Primary topic tags for focused filtering:
const coreTopicTags = [
  { name: 'PostgreSQL', label: 'PostgreSQL' },
  { name: 'TimescaleDB', label: 'TimescaleDB' },
  { name: 'Apache Arrow', label: 'Apache Arrow' },
  { name: 'ZFS', label: 'ZFS & Depolama' }
];

const filterTags = coreTopicTags.map(topic => ({
  name: topic.name,
  label: topic.label,
  count: tagCounts.get(topic.name) || 0
}));

function calculateReadingTime(content: string): number {
  if (!content) return 5;
  const cleanText = content.replace(/<[^>]*>/g, '').replace(/[#*`_~[\]()]/g, '');
  const words = cleanText.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}
---

<section id="articles" class="py-10 sm:py-14 border-b border-[var(--border)] scroll-mt-16">
  <!-- Section Title & Narrative -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div class="space-y-1.5 max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-serif text-[var(--text)] tracking-tight">
        Yazılar & Notlar
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-muted)] font-sans leading-relaxed">
        Öğrendiklerimi, sahadaki deneyimlerimi ve veritabanı altyapıları üzerine hazırladığım adım adım teknik rehberleri burada paylaşıyorum.
      </p>
    </div>

    <!-- Post Count Indicator -->
    <div class="shrink-0 flex items-center">
      <span id="filter-count-indicator" class="font-mono text-xs text-[var(--text-dim)] px-2.5 py-1 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-[2px]">
        {posts.length} yazı
      </span>
    </div>
  </div>

  <!-- Interactive Tag Filtering Bar (Horizontal scroll on mobile without wrapping) -->
  <div class="mb-6 flex items-center gap-2 overflow-x-auto flex-nowrap whitespace-nowrap pb-2 scrollbar-none select-none" role="toolbar" aria-label="Yazı etiket filtreleri">
    <span class="text-[11px] font-mono text-[var(--text-dim)] uppercase tracking-wider mr-1 shrink-0">
      Filtre:
    </span>

    <!-- "Tümü" Button -->
    <button
      type="button"
      data-tag-filter="all"
      class="article-filter-btn px-3 py-1.5 text-xs font-mono rounded-[2px] transition-all cursor-pointer bg-[var(--accent)] text-white font-medium border border-[var(--accent)] shadow-2xs is-active shrink-0 focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
      aria-pressed="true"
    >
      Tümü ({posts.length})
    </button>

    <!-- Tag Buttons -->
    {filterTags.map((tag) => (
      <button
        type="button"
        data-tag-filter={tag.name}
        class="article-filter-btn px-3 py-1.5 text-xs font-mono rounded-[2px] transition-all cursor-pointer bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-[var(--text)] border border-[var(--border)] hover:border-[var(--text-dim)] shrink-0 focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
        aria-pressed="false"
      >
        #{tag.label} <span class="text-[10px] opacity-75">({tag.count})</span>
      </button>
    ))}
  </div>

  <!-- Empty State when 0 posts match filter -->
  <div id="articles-empty-state" class="hidden py-12 text-center space-y-3 border-t border-[var(--border)]">
    <p class="text-sm font-sans text-[var(--text-muted)]">
      "<span id="articles-empty-tag" class="font-mono text-[var(--text)] font-semibold"></span>" etiketine sahip yazı bulunamadı.
    </p>
    <button
      type="button"
      id="reset-filter-btn"
      class="px-3 py-1.5 text-xs font-mono bg-[var(--accent)] text-white font-medium rounded-[2px] transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
    >
      <span>Tüm Yazıları Göster</span>
      <span aria-hidden="true">↺</span>
    </button>
  </div>

  <!-- Editorial Articles Directory (Equal Height Cards with Sticky Footer) -->
  <div id="articles-list" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    {posts.map((post) => {
      const slug = getPostSlug(post);
      const postUrl = `/posts/${slug}`;
      const postTagsAttr = post.data.tags.join(',');
      const readingMinutes = calculateReadingTime(post.body || '');
      return (
        <article
          class="article-item group relative border border-[var(--border)] bg-[var(--bg-card)] hover:border-[var(--accent)] transition-all duration-150 p-5 sm:p-6 rounded-[2px] flex flex-col justify-between h-full hover:-translate-y-0.5 shadow-2xs focus-within:ring-2 focus-within:ring-[var(--accent)] focus-within:border-transparent"
          data-tags={postTagsAttr}
        >
          <div class="flex-1 space-y-3 mb-4">
            <!-- Date & Reading Time -->
            <div class="font-mono text-xs text-[var(--text-dim)] flex items-center gap-2">
              <time datetime={post.data.date} style={`view-transition-name: post-date-${slug};`}>{post.data.date}</time>
              <span class="text-[var(--border-strong)]" aria-hidden="true">·</span>
              <span>{readingMinutes} dk okuma</span>
            </div>

            <!-- Title with full-card clickable ::after link and shared-element view-transition-name -->
            <h3 class="font-serif text-lg sm:text-xl text-[var(--text)] group-hover:text-[var(--accent)] transition-colors leading-snug" style={`view-transition-name: post-title-${slug};`}>
              <a href={postUrl} class="focus:outline-none after:absolute after:inset-0 after:z-0">
                {post.data.title}
              </a>
            </h3>

            <!-- Summary -->
            <p class="text-xs sm:text-sm text-[var(--text-muted)] font-sans leading-relaxed line-clamp-3">
              {post.data.summary}
            </p>
          </div>

          <!-- Bottom Footer Row: Tags + Read Link (mt-auto) -->
          <div class="flex items-center justify-between gap-3 pt-4 mt-auto border-t border-[var(--border)]/70">
            <!-- Tags (Primary category prominent, others calm) -->
            <div class="flex flex-wrap items-center gap-1.5 relative z-10">
              {post.data.tags.slice(0, 3).map((tag, idx) => (
                <button
                  type="button"
                  data-tag-click={tag}
                  class:list={[
                    "article-tag-badge font-mono text-[10px] px-2 py-0.5 rounded-[2px] transition-colors cursor-pointer",
                    idx === 0
                      ? "bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-medium hover:bg-[var(--accent)] hover:text-white"
                      : "bg-[var(--bg-subtle)] text-[var(--text-dim)] border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
                  ]}
                  title={`#${tag} etiketine göre filtrele`}
                >
                  #{tag}
                </button>
              ))}
            </div>

            <!-- Read Link Indicator -->
            <div class="font-mono text-xs text-[var(--accent)] inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform shrink-0 font-medium select-none" aria-hidden="true">
              <span>Yazıyı Oku</span>
              <span>→</span>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<!-- Client-side Interactive Tag Filter Script -->
<script is:inline>
  (function() {
    function initArticleFiltering() {
      const filterButtons = document.querySelectorAll('.article-filter-btn');
      const articleItems = document.querySelectorAll('.article-item');
      const articlesList = document.getElementById('articles-list');
      const emptyState = document.getElementById('articles-empty-state');
      const emptyTagSpan = document.getElementById('articles-empty-tag');
      const resetBtn = document.getElementById('reset-filter-btn');
      const countIndicator = document.getElementById('filter-count-indicator');
      const tagBadges = document.querySelectorAll('.article-tag-badge');

      if (!filterButtons.length || !articleItems.length) return;

      function normalizeTag(str) {
        if (!str) return '';
        return str
          .trim()
          .toLocaleLowerCase('tr-TR')
          .replace(/ğ/g, 'g')
          .replace(/ü/g, 'u')
          .replace(/ş/g, 's')
          .replace(/ı/g, 'i')
          .replace(/ö/g, 'o')
          .replace(/ç/g, 'c')
          .replace(/[^a-z0-9]/g, '');
      }

      function matchTag(articleTagNorm, targetNorm) {
        if (!articleTagNorm || !targetNorm) return false;
        if (articleTagNorm === targetNorm) return true;
        // Allow prefix matching for shorthands like postgres -> postgresql, timescale -> timescaledb
        if (targetNorm.length >= 3 && articleTagNorm.startsWith(targetNorm)) return true;
        return false;
      }

      function filterArticles(targetTag, updateUrl = true) {
        const isAll = !targetTag || targetTag === 'all' || targetTag === 'tumu' || targetTag === 'Tümü';
        const cleanTarget = normalizeTag(targetTag);

        let visibleCount = 0;

        // 1. Update filter toolbar button active states
        filterButtons.forEach(btn => {
          const btnTag = btn.getAttribute('data-tag-filter');
          const isBtnActive = (isAll && btnTag === 'all') || (!isAll && matchTag(normalizeTag(btnTag), cleanTarget));

          if (isBtnActive) {
            btn.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text-muted)]', 'border-[var(--border)]');
            btn.classList.add('bg-[var(--accent)]', 'text-white', 'font-medium', 'border-[var(--accent)]', 'shadow-2xs', 'is-active');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('bg-[var(--accent)]', 'text-white', 'font-medium', 'border-[var(--accent)]', 'shadow-2xs', 'is-active');
            btn.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text-muted)]', 'border-[var(--border)]');
            btn.setAttribute('aria-pressed', 'false');
          }
        });

        // 2. Sync sidebar topic tags active indicator
        const sidebarTopicTags = document.querySelectorAll('.sidebar-topic-tag');
        sidebarTopicTags.forEach(stTag => {
          const rawTag = stTag.getAttribute('data-tag');
          const isMatch = !isAll && matchTag(normalizeTag(rawTag), cleanTarget);
          if (isMatch) {
            stTag.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text-dim)]', 'border-[var(--border)]');
            stTag.classList.add('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]', 'font-medium');
          } else {
            stTag.classList.remove('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]', 'font-medium');
            stTag.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text-dim)]', 'border-[var(--border)]');
          }
        });

        // 3. Filter article cards with smooth reveal
        articleItems.forEach(item => {
          const rawTags = item.getAttribute('data-tags') || '';
          const tagsArray = rawTags.split(',').map(normalizeTag);
          const matches = isAll || tagsArray.some(t => matchTag(t, cleanTarget));

          if (matches) {
            const wasHidden = item.classList.contains('hidden');
            if (wasHidden) {
              item.classList.remove('hidden');
              item.style.opacity = '0';
              item.style.transform = 'translateY(6px)';
              window.requestAnimationFrame(() => {
                item.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              });
            }
            visibleCount++;
          } else {
            item.classList.add('hidden');
            item.style.transition = '';
            item.style.opacity = '';
            item.style.transform = '';
          }
        });

        // 4. Update count indicator
        if (countIndicator) {
          countIndicator.textContent = `${visibleCount} yazı`;
        }

        // 5. Empty state and list visibility
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
            if (emptyTagSpan) emptyTagSpan.textContent = targetTag;
            if (articlesList) articlesList.classList.add('hidden');
          } else {
            emptyState.classList.add('hidden');
            if (articlesList) articlesList.classList.remove('hidden');
          }
        }

        // 6. Update URL (using pushState for browser history back/forward navigation)
        if (updateUrl && window.history && window.history.pushState) {
          try {
            const url = new URL(window.location.href);
            if (isAll) {
              url.searchParams.delete('tag');
            } else {
              url.searchParams.set('tag', targetTag);
            }
            const hash = url.hash ? url.hash : '';
            const newUrl = url.pathname + (url.search ? url.search : '') + hash;
            const currentUrl = window.location.pathname + window.location.search + window.location.hash;
            if (newUrl !== currentUrl) {
              window.history.pushState({ tag: isAll ? null : targetTag }, '', newUrl);
            }
          } catch (_) {}
        }
      }

      // Expose globally for Sidebar and other components
      window.filterArticlesByTag = filterArticles;

      // Filter button click events
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag-filter') || 'all';
          filterArticles(tag, true);
        });
      });

      // Tag badge clicks inside article cards
      tagBadges.forEach(badge => {
        badge.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const tag = badge.getAttribute('data-tag-click');
          if (tag) {
            filterArticles(tag, true);
            const section = document.getElementById('articles');
            if (section) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Reset button click
      if (resetBtn) {
        resetBtn.addEventListener('click', () => filterArticles('all', true));
      }

      // History navigation (Back / Forward button popstate)
      window.addEventListener('popstate', (e) => {
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const urlTag = urlParams.get('tag') || (e.state && e.state.tag) || 'all';
          filterArticles(urlTag, false);
        } catch (_) {
          filterArticles('all', false);
        }
      });

      // Read initial tag from URL (supports both standard ?tag= and fallback #articles?tag=)
      try {
        const urlParams = new URLSearchParams(window.location.search);
        let initialTag = urlParams.get('tag');
        if (!initialTag && window.location.hash.includes('tag=')) {
          const match = window.location.hash.match(/[?&]tag=([^&#]+)/);
          if (match) {
            initialTag = decodeURIComponent(match[1]);
          }
        }
        if (initialTag) {
          filterArticles(initialTag, false);
          // If loaded with a specific tag filter, scroll to articles section
          window.requestAnimationFrame(() => {
            const section = document.getElementById('articles');
            if (section && window.scrollY < 100) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        }
      } catch (_) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initArticleFiltering);
    } else {
      initArticleFiltering();
    }
    document.addEventListener('astro:page-load', initArticleFiltering);
  })();
</script>
